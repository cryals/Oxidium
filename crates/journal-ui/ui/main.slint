    callback kanban_save_task_detail(string, string, string, string, string, int);
    callback kanban_move_task_to_column(string, string);
    callback kanban_move_task_step(string, int);
    callback kanban_toggle_task_complete(string);
    callback kanban_duplicate_task(string);
    callback kanban_delete_task(string);
    callback kanban_add_checklist(string, string);
    callback kanban_toggle_checklist(string, bool);
    callback kanban_delete_checklist(string);
    callback kanban_add_tag(string, string);
    callback kanban_filter_changed(string, int);
    callback kanban_clear_subject_filter();

    callback profile_switch(string);
