    callback period_create(string, int, string, string);
    callback search_query_changed(string);
    callback search_hit_selected(string, string);
    callback notif_mark_all_read();
    callback notif_dismiss(string);

    callback save_appearance(int, int, string, bool, bool, int);
    callback save_journal_prefs(int, int, int, bool, bool);
    callback save_kanban_prefs(bool, bool);
    callback save_mcp_prefs(string, bool, int, bool);
    callback mcp_start_http();
    callback mcp_stop_http();
    callback mcp_restart_http();
    callback mcp_rotate_token();
    callback mcp_undo_activity(string);
    callback trigger_backup();
    callback trigger_restore();
    callback export_data(string);
    callback import_data(string);

    forward_focus: key_handler;

    key_handler := FocusScope {
        width: 100%;
        height: 100%;

        key_pressed(ev) => {
            if (ev.text == Key.Escape && root.any_modal_open) {
                if (root.onboarding_open) { root.onboarding_dismissed(); }
                root.quick_profile_open = false;
                root.onboarding_open = false;
                root.profiles_modal_open = false;
                root.subjects_modal_open = false;
                root.periods_modal_open = false;
                root.search_modal_open = false;
                root.notifications_modal_open = false;
                root.settings_modal_open = false;
                root.shortcuts_modal_open = false;
                if (!root.update_downloading) { root.update_modal_open = false; }
                journal_view.quick_picker_open = false;
                journal_view.cell_detail_open = false;
                kanban_view.new_task_open = false;
                kanban_view.new_column_open = false;
                kanban_view.new_board_open = false;
                kanban_view.detail_open = false;
                return accept;
            }
            // Do not hijack keys while user is editing inside any modal/dialog input
            if (root.any_modal_open) {
                return reject;
            }
            if (ev.modifiers.control) {
                if (ev.text == "1") { root.active_section = 0; root.section_changed(0); return accept; }
                if (ev.text == "2") { root.active_section = 1; root.section_changed(1); return accept; }
                if (ev.text == "3") { root.active_section = 2; root.section_changed(2); return accept; }
                if (ev.text == "f" || ev.text == "F" || ev.text == "а" || ev.text == "А") {
                    root.search_modal_open = true;
                    return accept;
                }
                if (ev.text == ",") {
                    root.settings_active_tab = 0;
                    root.settings_modal_open = true;
                    return accept;
                }
                if (ev.text == "n" || ev.text == "N" || ev.text == "т" || ev.text == "Т") {
                    if (root.active_section == 2) { kanban_view.new_task_open = true; }
                    else { root.subjects_modal_open = true; }
                    return accept;
                }
                if ((ev.text == "z" || ev.text == "Z" || ev.text == "я" || ev.text == "Я") && ev.modifiers.shift) {
                    root.redo_clicked();
                    return accept;
                }
                if (ev.text == "z" || ev.text == "Z" || ev.text == "я" || ev.text == "Я") {
                    root.undo_clicked();
                    return accept;
                }
            }
            // Journal cell keyboard navigation & quick digits 1-5
            if (root.active_section == 0 && root.journal_rows.length > 0 && root.journal_days.length > 0) {
                if (ev.text == Key.RightArrow) {
                    if (journal_view.active_row < 0) { journal_view.active_row = 0; }
                    journal_view.active_col = min(root.journal_days.length - 1, journal_view.active_col + 1);
                    return accept;
                }
                if (ev.text == Key.LeftArrow) {
                    if (journal_view.active_row < 0) { journal_view.active_row = 0; }
                    journal_view.active_col = max(0, journal_view.active_col - 1);
                    return accept;
                }
                if (ev.text == Key.DownArrow) {
                    if (journal_view.active_col < 0) { journal_view.active_col = 0; }
                    journal_view.active_row = min(root.journal_rows.length - 1, journal_view.active_row + 1);
                    return accept;
                }
                if (ev.text == Key.UpArrow) {
                    if (journal_view.active_col < 0) { journal_view.active_col = 0; }
                    journal_view.active_row = max(0, journal_view.active_row - 1);
                    return accept;
                }
                if (journal_view.active_row >= 0 && journal_view.active_col >= 0) {
                    if (ev.text == Key.Return) { root.journal_open_cell_at(journal_view.active_row, journal_view.active_col); return accept; }
                    if (ev.text == Key.Delete) { root.journal_delete_active_cell(journal_view.active_row, journal_view.active_col); return accept; }
                    if (ev.text == "1") { root.journal_quick_digit_grade(journal_view.active_row, journal_view.active_col, 1); return accept; }
                    if (ev.text == "2") { root.journal_quick_digit_grade(journal_view.active_row, journal_view.active_col, 2); return accept; }
                    if (ev.text == "3") { root.journal_quick_digit_grade(journal_view.active_row, journal_view.active_col, 3); return accept; }
                    if (ev.text == "4") { root.journal_quick_digit_grade(journal_view.active_row, journal_view.active_col, 4); return accept; }
                    if (ev.text == "5") { root.journal_quick_digit_grade(journal_view.active_row, journal_view.active_col, 5); return accept; }
                }
            }
            reject
        }

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            spacing: 0px;

            // ===== EXPANDABLE M3 EXPRESSIVE WIDE NAVIGATION RAIL (Stitch A01/C01/D01) =====
            Rectangle {
                width: root.rail_expanded ? 212px : (root.width < 940px ? 72px : 92px);
                background: MaterialPalette.surface_container;
                clip: true;
                animate width { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                animate background { duration: OxidiumTheme.dur_effects_slow; easing: OxidiumMotion.expressive_slow_effects; }

                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding_top: 14px;
                    padding_bottom: 14px;
                    padding_left: 8px;
                    padding_right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    // Top Menu Toggle + Brand + Exact 3 Primary Navigation Sections
                    VerticalLayout {
                        spacing: 12px;

                        // Hamburger Expand Toggle & Oxidium Brand
                        HorizontalLayout {
                            alignment: root.rail_expanded ? start : center;
                            spacing: 10px;
                            padding_left: root.rail_expanded ? 8px : 0px;

                            OxidiumIconButton {
                                icon: OxidiumIcons.menu;
                                tooltip: root.rail_expanded ? "Свернуть панель" : "Развернуть панель";
                                clicked => { root.rail_expanded = !root.rail_expanded; }
                            }
                            if root.rail_expanded : Text {
                                text: "Oxidium";
                                font_family: OxidiumTheme.font_display;
                                font_size: 16px;
                                font_weight: 700;
                                color: MaterialPalette.on_surface;
                                vertical_alignment: center;
                            }
                        }

                        // Oxidium Brand Logo Badge
                        HorizontalLayout {
                            alignment: root.rail_expanded ? start : center;
                            padding_left: root.rail_expanded ? 12px : 0px;
                            spacing: 10px;
                            Rectangle {
                                width: 40px; height: 40px; border_radius: 12px;
                                background: MaterialPalette.primary_container;
                                Image {
                                    source: OxidiumIcons.app_logo;
                                    width: 26px; height: 26px;
                                    x: 7px; y: 7px;
                                    image_fit: contain;
                                }
                            }
                            if root.rail_expanded : VerticalLayout {
                                alignment: center;
                                Text { text: "Журнал ученика"; font_size: 12px; font_weight: 500; color: MaterialPalette.on_surface_variant; }
                            }
                        }

                        // Exact 3 Main Sections: Journal, Statistics, Kanban
                        for nav[idx] in [
                            { label: root.tr.nav_journal, icon: OxidiumIcons.journal },
                            { label: root.tr.nav_statistics, icon: OxidiumIcons.analytics },
                            { label: root.tr.nav_kanban, icon: OxidiumIcons.kanban },
                        ] : Rectangle {
                            height: root.rail_expanded ? 44px : 56px;
                            border_radius: nav_ta.pressed ? 14px : 22px;
                            background: root.rail_expanded && root.active_section == idx
                                ? MaterialPalette.secondary_container
                                : root.rail_expanded && nav_ta.has_hover ? MaterialPalette.surface_container_high : transparent;
                            animate border_radius, height { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                            animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }

                            if !root.rail_expanded : VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: root.active_section == idx ? 56px : 44px; height: 32px;
                                        border_radius: nav_ta.pressed ? 10px : 16px;
                                        background: root.active_section == idx
                                            ? MaterialPalette.secondary_container
                                            : nav_ta.has_hover ? MaterialPalette.surface_container_high : transparent;
                                        animate width, border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                        Icon {
                                            source: nav.icon;
                                            width: 22px; height: 22px;
                                            colorize: root.active_section == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                        }
                                    }
                                }
                                if root.width >= 940px : Text {
                                    text: nav.label;
                                    font_family: OxidiumTheme.font_display;
                                    font_size: 11px;
                                    font_weight: root.active_section == idx ? 700 : 500;
                                    color: root.active_section == idx ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
                                    horizontal_alignment: center;
                                }
                            }

                            if root.rail_expanded : HorizontalLayout {
                                padding_left: 16px;
                                padding_right: 12px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: nav.icon;
                                        width: 22px; height: 22px;
                                        colorize: root.active_section == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                    }
                                }
                                Text {
                                    text: nav.label;
                                    font_family: OxidiumTheme.font_display;
                                    font_size: 14px;
                                    font_weight: root.active_section == idx ? 600 : 500;
                                    color: root.active_section == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                    vertical_alignment: center;
                                }
                            }

                            nav_ta := TouchArea {
                                mouse_cursor: pointer;
                                clicked => {
                                    OxidiumTooltipState.shown = false;
                                    root.active_section = idx;
                                    root.section_changed(idx);
                                }
                            }
                        }
                    }

                    // Bottom Rail Utilities: MCP Status, 1-Click Theme Toggle, Settings, Profile Initials Avatar
                    VerticalLayout {
                        spacing: 8px;

                        // MCP Status Indicator Pill
                        HorizontalLayout {
                            alignment: root.rail_expanded ? start : center;
                            padding_left: root.rail_expanded ? 8px : 0px;
                            Rectangle {
                                height: 30px;
                                min_width: root.rail_expanded ? 176px : 56px;
                                border_radius: mcp_pill_ta.pressed ? 9px : 15px;
                                background: root.mcp_http_running
                                    ? OxidiumTheme.grade_5_bg
                                    : MaterialPalette.surface_container_high;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                HorizontalLayout {
                                    padding_left: 10px; padding_right: 10px;
                                    alignment: center; spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 7px; height: 7px; border_radius: 4px;
                                            background: root.mcp_http_running ? OxidiumTheme.grade_5 : MaterialPalette.outline;
                                        }
                                    }
                                    Text {
                                        text: root.rail_expanded ? (root.mcp_http_running ? "MCP: Активен" : "MCP: Остановлен") : "MCP";
                                        font_family: OxidiumTheme.font_mono;
                                        font_size: 11px; font_weight: 700;
                                        color: root.mcp_http_running ? OxidiumTheme.grade_5_fg : MaterialPalette.on_surface_variant;
                                        vertical_alignment: center;
                                    }
                                }
                                mcp_pill_ta := TouchArea {
                                    mouse_cursor: pointer;
                                    clicked => {
                                        OxidiumTooltipState.shown = false;
                                        root.settings_active_tab = 3;
                                        root.settings_modal_open = true;
                                    }
                                }
                            }
                        }

                        // 1-Click Theme Toggle (Stitch A01/C01/D01)
                        HorizontalLayout {
                            alignment: root.rail_expanded ? start : center;
                            padding_left: root.rail_expanded ? 8px : 0px;
                            spacing: 8px;
                            OxidiumIconButton {
                                icon: OxidiumTheme.dark_mode ? OxidiumIcons.light_mode : OxidiumIcons.dark_mode;
                                tooltip: OxidiumTheme.dark_mode ? "Светлая тема" : "Тёмная тема";
                                clicked => { root.theme_quick_toggle(); }
                            }
                            if root.rail_expanded : Text {
                                text: OxidiumTheme.dark_mode ? "Светлая тема" : "Тёмная тема";
                                font_size: 13px;
                                color: MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                        }

                        // Settings Trigger
                        HorizontalLayout {
                            alignment: root.rail_expanded ? start : center;
                            padding_left: root.rail_expanded ? 8px : 0px;
                            spacing: 8px;
                            OxidiumIconButton {
                                icon: OxidiumIcons.settings;
                                tooltip: root.tr.nav_settings + " (Ctrl+,)";
                                clicked => {
                                    root.settings_active_tab = 0;
                                    root.settings_modal_open = true;
                                }
                            }
                            if root.rail_expanded : Text {
                                text: root.tr.nav_settings;
                                font_size: 13px;
                                color: MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                        }

                        // Profile Initials Avatar Pill -> QuickProfilePopover
                        HorizontalLayout {
                            alignment: root.rail_expanded ? start : center;
                            padding_left: root.rail_expanded ? 8px : 0px;
                            spacing: 10px;
                            Rectangle {
                                width: 40px; height: 40px;
                                border_radius: (av_ta.pressed || root.quick_profile_open) ? 12px : 20px;
                                background: MaterialPalette.primary_container;
                                border_width: root.quick_profile_open ? 2px : (av_ta.has_hover ? 1px : 0px);
                                border_color: MaterialPalette.primary;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate border_width { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                                Text {
                                    text: root.active_profile_initials;
                                    font_family: OxidiumTheme.font_display;
                                    font_size: 13px; font_weight: 700;
                                    color: MaterialPalette.on_primary_container;
                                    horizontal_alignment: center; vertical_alignment: center;
                                }
                                av_ta := TouchArea {
                                    mouse_cursor: pointer;
                                    clicked => {
                                        OxidiumTooltipState.shown = false;
                                        root.quick_profile_open = !root.quick_profile_open;
                                    }
                                }
                            }
                            if root.rail_expanded : VerticalLayout {
                                alignment: center;
                                Text { text: root.active_profile_name; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface; overflow: elide; }
                                if root.active_profile_sub != "" : Text { text: root.active_profile_sub; font_size: 10px; color: MaterialPalette.on_surface_variant; overflow: elide; }
                            }
                        }
                    }
                }

                Rectangle {
                    x: parent.width - 1px; width: 1px; height: 100%;
                    background: OxidiumTheme.cell_border;
                }
            }

            // ===== MAIN CONTENT COLUMN =====
            Rectangle {
                horizontal_stretch: 1;
                min_width: 0px;
                clip: true;

                VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;

                // Unified Contextual Top Header (Active Section Title + Profile Chip + Search + Quick Utilities)
                Rectangle {
                    height: 54px;
                    background: MaterialPalette.surface;
                    animate background { duration: OxidiumTheme.dur_effects_slow; easing: OxidiumMotion.expressive_slow_effects; }

                    HorizontalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        padding_left: 20px;
                        padding_right: 16px;
                        spacing: 10px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: root.active_section == 0 ? root.tr.nav_journal
                                    : root.active_section == 1 ? root.tr.nav_statistics
                                    : root.tr.nav_kanban;
                                font_family: OxidiumTheme.font_display;
                                font_size: root.width < 900px ? 19px : 22px; font_weight: 600;
                                color: MaterialPalette.on_surface;
                                vertical_alignment: center;
                            }
                            Rectangle {
                                height: 30px;
                                max_width: root.width < 940px ? 168px : 280px;
                                y: (parent.height - self.height) / 2;
                                border_radius: prof_chip_ta.pressed ? 9px : 15px;
                                background: prof_chip_ta.has_hover ? MaterialPalette.surface_container_highest : MaterialPalette.surface_container_high;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                                HorizontalLayout {
                                    padding_left: 11px; padding_right: 12px; spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon { source: OxidiumIcons.school; width: 15px; height: 15px; colorize: MaterialPalette.primary; }
                                    }
                                    Text {
                                        text: root.active_profile_name + (root.active_profile_sub != "" ? " · " + root.active_profile_sub : "");
                                        font_size: 12px; font_weight: 600;
                                        color: MaterialPalette.on_surface;
                                        vertical_alignment: center;
                                        overflow: elide;
                                    }
                                }
                                prof_chip_ta := TouchArea { mouse_cursor: pointer; clicked => { root.quick_profile_open = !root.quick_profile_open; } }
                            }
                        }

                        // Global Search Bar Trigger
                        Rectangle {
                            width: min(360px, max(126px, root.width * 0.24));
                            height: 36px;
                            y: (parent.height - self.height) / 2;
                            border_radius: 18px;
                            background: srch_top_ta.has_hover ? MaterialPalette.surface_container : MaterialPalette.surface_container_low;
                            border_width: 1px;
                            border_color: OxidiumTheme.cell_border;
                            animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                            HorizontalLayout {
                                padding_left: 12px; padding_right: 12px; spacing: 8px;
                                VerticalLayout { alignment: center; Icon { source: OxidiumIcons.search; width: 16px; height: 16px; colorize: MaterialPalette.on_surface_variant; } }
                                Text {
                                    text: root.tr.search_placeholder;
                                    font_size: 12px; color: MaterialPalette.on_surface_variant;
                                    vertical_alignment: center;
                                    overflow: elide;
                                }
                            }
                            srch_top_ta := TouchArea { mouse_cursor: pointer; clicked => { root.search_modal_open = true; } }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            if root.update_available : Rectangle {
                                height: 32px;
                                y: (parent.height - self.height) / 2;
                                border_radius: upd_ta.pressed ? 10px : 16px;
                                background: upd_ta.has_hover ? MaterialPalette.primary : MaterialPalette.primary_container;
                                border_width: 1px;
                                border_color: MaterialPalette.primary;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                                HorizontalLayout {
                                    padding_left: 11px; padding_right: 12px; spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            source: OxidiumIcons.download;
                                            width: 15px; height: 15px;
                                            colorize: upd_ta.has_hover ? MaterialPalette.on_primary : MaterialPalette.on_primary_container;
                                        }
                                    }
                                    Text {
                                        text: "Обновить " + root.update_latest_version;
                                        font_family: OxidiumTheme.font_display;
                                        font_size: 12px; font_weight: 600;
                                        color: upd_ta.has_hover ? MaterialPalette.on_primary : MaterialPalette.on_primary_container;
                                        vertical_alignment: center;
                                    }
                                }
                                upd_ta := TouchArea {
                                    mouse_cursor: pointer;
                                    clicked => { root.update_modal_open = true; }
                                }
                            }
                            OxidiumIconButton {
                                icon: OxidiumIcons.undo;
                                enabled: root.can_undo;
                                tooltip: "Отменить (Ctrl+Z)";
                                clicked => { root.undo_clicked(); }
                            }
                            OxidiumIconButton {
                                icon: OxidiumIcons.redo;
                                enabled: root.can_redo;
                                tooltip: "Повторить (Ctrl+Shift+Z)";
                                clicked => { root.redo_clicked(); }
                            }
                            Rectangle {
                                width: 40px; height: 40px;
                                OxidiumIconButton {
                                    icon: OxidiumIcons.notifications;
                                    tooltip: "Уведомления";
                                    clicked => { root.notifications_modal_open = !root.notifications_modal_open; }
                                }
                                if root.unread_notifications > 0 : Rectangle {
                                    x: 22px; y: 4px; width: 16px; height: 16px; border_radius: 8px;
                                    background: MaterialPalette.error;
                                    Text {
                                        text: root.unread_notifications;
                                        font_family: OxidiumTheme.font_mono;
                                        font_size: 9px; font_weight: 700;
                                        color: MaterialPalette.on_error;
                                        horizontal_alignment: center; vertical_alignment: center;
                                    }
                                }
                            }
                            OxidiumIconButton {
                                icon: OxidiumIcons.keyboard;
                                tooltip: "Горячие клавиши";
                                clicked => { root.shortcuts_modal_open = true; }
                            }
                        }
                    }

                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: OxidiumTheme.cell_border; }
                }

                // Active Main View Stack with M3 Expressive Section Transitions
                Rectangle {
                    vertical_stretch: 1;
                    background: MaterialPalette.background;
                    clip: true;
                    animate background { duration: OxidiumTheme.dur_effects_slow; easing: OxidiumMotion.expressive_slow_effects; }

                    journal_view := JournalView {
                        x: 0px;
                        y: root.active_section == 0 ? 0px : 14px;
                        width: 100%; height: 100%;
                        opacity: root.active_section == 0 ? 1.0 : 0.0;
                        visible: self.opacity > 0.01;
                        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                        animate opacity { duration: OxidiumTheme.dur_effects_slow; easing: OxidiumMotion.expressive_slow_effects; }
                        tr: root.tr;
                        month_title: root.journal_month_title;
                        view_mode <=> root.journal_view_mode;
                        overall_avg_text: root.journal_overall_avg;
                        average_mode_label: root.journal_avg_mode_label;
                        days: root.journal_days;
                        rows: root.journal_rows;
                        periods: root.academic_periods;
                        active_period_label: root.active_period_label;
                        quick_marks: root.quick_marks;
                        cell_entries: root.cell_detail_entries;

                        prev_period => { root.journal_prev_period(); }
                        next_period => { root.journal_next_period(); }
                        go_today => { root.journal_go_today(); }
                        change_view_mode(m) => { root.journal_change_view_mode(m); }
                        select_period(p) => { root.journal_select_period(p); }
                        open_subjects_manager => { root.subjects_modal_open = true; }
                        open_periods_manager => { root.periods_modal_open = true; }
                        open_onboarding => { root.onboarding_step = 1; root.onboarding_open = true; }
                        subject_filter_changed(q) => { root.journal_subject_filter_changed(q); }
                        cell_clicked(sid, d, r, c, has) => { root.journal_cell_clicked(sid, d, r, c, has); }
                        quick_mark_selected(sid, d, code) => { root.journal_quick_mark(sid, d, code); }
                        clear_cell_entries(sid, d) => { root.journal_clear_cell(sid, d); }
                        open_cell_detail(sid, d) => { root.journal_open_cell_detail(sid, d); }
                        add_detailed_entry(sid, d, mk, w, wt, top, com) => { root.journal_add_detailed_entry(sid, d, mk, w, wt, top, com); }
                        delete_cell_entry(id, is_att) => { root.journal_delete_entry(id, is_att); }
                        copy_cell_entry(id, dt) => { root.journal_copy_entry(id, dt); }
                        move_cell_entry(id, dt) => { root.journal_move_entry(id, dt); }
                        subject_open_tasks(sid) => { root.journal_subject_open_tasks(sid); }
                    }

                    stats_view := StatisticsView {
                        x: 0px;
                        y: root.active_section == 1 ? 0px : 14px;
                        width: 100%; height: 100%;
                        opacity: root.active_section == 1 ? 1.0 : 0.0;
                        visible: self.opacity > 0.01;
                        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                        animate opacity { duration: OxidiumTheme.dur_effects_slow; easing: OxidiumMotion.expressive_slow_effects; }
                        tr: root.tr;
                        period_preset <=> root.stats_period_preset;
                        overall_avg: root.stats_overall_avg;
                        total_grades_text: root.stats_total_grades;
                        grade_counts_breakdown: root.stats_grade_counts;
                        absences_text: root.stats_absences;
                        excused_text: root.stats_excused;
                        passes_text: root.stats_passes;
                        attendance_note: root.stats_attendance_note;
                        best_subject_text: root.stats_best_subject;
                        lowest_subject_text: root.stats_lowest_subject;
                        completed_tasks_text: root.stats_completed_tasks;
                        overdue_tasks_text: root.stats_overdue_tasks;
                        active_tasks_text: root.stats_active_tasks;
                        comparison_summary: root.stats_comparison_summary;
                        compare_enabled <=> root.stats_compare_enabled;
                        chart_y_top: root.stats_chart_y_top;
                        chart_y_mid: root.stats_chart_y_mid;
                        chart_y_bot: root.stats_chart_y_bot;
                        chart_x_start: root.stats_chart_x_start;
                        chart_x_mid: root.stats_chart_x_mid;
                        chart_x_end: root.stats_chart_x_end;
                        chart_target_label: root.stats_chart_target_label;
                        chart_trend_delta: root.stats_chart_trend_delta;
                        chart_trend_positive: root.stats_chart_trend_positive;
                        line_chart_image: root.stats_line_chart;
                        donut_chart_image: root.stats_donut_chart;
                        trend_points: root.stats_trend_points;
                        grade_dist_bars: root.stats_grade_dist;
                        donut_legend: root.stats_donut_legend;
                        subject_avg_bars: root.stats_subject_avgs;
                        attendance_bars: root.stats_attendance_bars;
                        heatmap_weeks: root.stats_heatmap_weeks;
                        heatmap_weekdays: root.stats_heatmap_weekdays;
                        subjects: root.active_subjects_list;
                        forecast_result_text: root.forecast_result_text;
                        forecast_target_result_text: root.forecast_target_result_text;

                        select_period_preset(p) => { root.stats_select_preset(p); }
                        toggle_compare => { root.stats_toggle_compare(); }
                        export_report => { root.stats_export_report(); }
                        run_forecast(si, g, w, t, m) => { root.stats_run_forecast(si, g, w, t, m); }
                    }

                    kanban_view := KanbanView {
                        x: 0px;
                        y: root.active_section == 2 ? 0px : 14px;
                        width: 100%; height: 100%;
                        opacity: root.active_section == 2 ? 1.0 : 0.0;
                        visible: self.opacity > 0.01;
                        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                        animate opacity { duration: OxidiumTheme.dur_effects_slow; easing: OxidiumMotion.expressive_slow_effects; }
                        tr: root.tr;
                        boards: root.kanban_boards;
                        active_board_id: root.kanban_active_board_id;
                        columns: root.kanban_columns;
                        subjects: root.active_subjects_list;
                        subject_filter_label: root.kanban_subject_filter_label;
                        detail_checklist: root.kanban_detail_checklist;

                        select_board(id) => { root.kanban_select_board(id); }
                        create_board(name) => { root.kanban_create_board(name); }
                        create_column(name, wip, done) => { root.kanban_create_column(name, wip, done); }
                        move_column_delta(id, d) => { root.kanban_move_column_delta(id, d); }
                        create_task(cid, t, d, dl, p, si, tags) => { root.kanban_create_task(cid, t, d, dl, p, si, tags); }
                        open_task_detail(id) => { root.kanban_open_task_detail(id); }
                        save_task_detail(id, t, d, n, dl, p) => { root.kanban_save_task_detail(id, t, d, n, dl, p); }
                        move_task_to_column(tid, cid) => { root.kanban_move_task_to_column(tid, cid); }
                        move_task_step(tid, d) => { root.kanban_move_task_step(tid, d); }
                        toggle_task_complete(id) => { root.kanban_toggle_task_complete(id); }
                        duplicate_task(id) => { root.kanban_duplicate_task(id); }
                        delete_task(id) => { root.kanban_delete_task(id); }
                        add_checklist_item(tid, title) => { root.kanban_add_checklist(tid, title); }
                        toggle_checklist_item(cid, done) => { root.kanban_toggle_checklist(cid, done); }
                        delete_checklist_item(cid) => { root.kanban_delete_checklist(cid); }
                        add_tag_to_task(tid, tg) => { root.kanban_add_tag(tid, tg); }
                        filter_changed(q, m) => { root.kanban_filter_changed(q, m); }
                        clear_subject_filter => { root.kanban_clear_subject_filter(); }
                    }
                }
                }
            }
        }
    }

    // ===== AUXILIARY MODALS & DRAWERS (unconditionally mounted for Expressive open/close motion) =====
    ProfilesModal {
        open: root.profiles_modal_open;
        profiles: root.profiles_list;
        delete_warning_text: root.profile_delete_warning;
        pending_delete_id <=> root.profile_pending_delete_id;
        close => { root.profiles_modal_open = false; }
        switch_profile(id) => { root.profile_switch(id); }
        create_profile(n, i, g, y, c) => { root.profile_create(n, i, g, y, c); }
        duplicate_profile(id) => { root.profile_duplicate(id); }
        archive_profile(id, a) => { root.profile_archive(id, a); }
        request_delete_profile(id) => { root.profile_request_delete(id); }
        confirm_delete_profile(id) => { root.profile_confirm_delete(id); }
    }

    SubjectsModal {
        open: root.subjects_modal_open;
        subjects: root.subjects_list;
        delete_warning_text: root.subject_delete_warning;
        pending_delete_id <=> root.subject_pending_delete_id;
        close => { root.subjects_modal_open = false; }
        create_subject(n, s, t, tg, c) => { root.subject_create(n, s, t, tg, c); }
        move_subject(id, d) => { root.subject_move(id, d); }
        archive_subject(id, a) => { root.subject_archive(id, a); }
        request_delete_subject(id) => { root.subject_request_delete(id); }
        confirm_delete_subject(id) => { root.subject_confirm_delete(id); }
    }

    PeriodsModal {
        open: root.periods_modal_open;
        periods: root.academic_periods;
        close => { root.periods_modal_open = false; }
        create_period(n, t, s, e) => { root.period_create(n, t, s, e); }
        select_period(id) => { root.journal_select_period(id); }
    }

    GlobalSearchModal {
        open: root.search_modal_open;
        hits: root.search_hits;
        close => { root.search_modal_open = false; }
        search_edited(q) => { root.search_query_changed(q); }
        hit_selected(t, id) => { root.search_hit_selected(t, id); }
    }

    NotificationsModal {
        open: root.notifications_modal_open;
        items: root.notifications_list;
        background_notice: root.tr.reminders_notice;
        close => { root.notifications_modal_open = false; }
        mark_all_read => { root.notif_mark_all_read(); }
        dismiss_item(id) => { root.notif_dismiss(id); }
    }

    SettingsModal {
        open: root.settings_modal_open;
        active_tab <=> root.settings_active_tab;
        tr: root.tr;
        theme_mode_idx <=> root.setting_theme_idx;
        lang_idx <=> root.setting_lang_idx;
        accent_hex <=> root.setting_accent_hex;
        compact_mode <=> root.setting_compact;
        reduced_motion <=> root.setting_reduced_motion;
        scale_percent <=> root.setting_scale_percent;
        avg_mode_idx <=> root.setting_avg_mode_idx;
        avg_precision_idx <=> root.setting_avg_precision_idx;
        week_start_idx <=> root.setting_week_start_idx;
        highlight_weekends <=> root.setting_highlight_weekends;
        highlight_holidays <=> root.setting_highlight_holidays;
        reminders_enabled <=> root.setting_reminders_enabled;
        os_notifications_enabled <=> root.setting_os_notifications;
        mcp_status_text: root.mcp_status_text;
        mcp_http_running: root.mcp_http_running;
        mcp_endpoint: root.mcp_endpoint;
        mcp_port_text <=> root.mcp_port_text;
        mcp_autostart <=> root.mcp_autostart;
        mcp_permission_idx <=> root.mcp_permission_idx;
        mcp_allow_destructive <=> root.mcp_allow_destructive;
        mcp_requests_text: root.mcp_requests_text;
        mcp_errors_text: root.mcp_errors_text;
        mcp_last_request_text: root.mcp_last_request_text;
        mcp_token_preview: root.mcp_token_preview;
        mcp_stdio_config_preview: root.mcp_stdio_config_preview;
        activity_log: root.activity_log_list;
        db_path_text: root.db_path_text;
        backup_status_text: root.backup_status_text;
        about_versions_text: root.about_versions_text;
        auto_check_updates <=> root.setting_auto_check_updates;
        update_available: root.update_available;
        update_checking: root.update_checking;
        update_latest_version: root.update_latest_version;
        update_status_text: root.update_status_text;

        close => { root.settings_modal_open = false; }
        save_appearance(t, l, a, c, r, s) => { root.save_appearance(t, l, a, c, r, s); }
        save_journal_prefs(m, p, w, wk, h) => { root.save_journal_prefs(m, p, w, wk, h); }
        save_kanban_prefs(r, o) => { root.save_kanban_prefs(r, o); }
        save_mcp_prefs(p, a, pm, d) => { root.save_mcp_prefs(p, a, pm, d); }
        mcp_start_http => { root.mcp_start_http(); }
        mcp_stop_http => { root.mcp_stop_http(); }
        mcp_restart_http => { root.mcp_restart_http(); }
        mcp_rotate_token => { root.mcp_rotate_token(); }
        mcp_undo_activity(id) => { root.mcp_undo_activity(id); }
        trigger_backup => { root.trigger_backup(); }
        trigger_restore => { root.trigger_restore(); }
        export_data(fmt) => { root.export_data(fmt); }
        import_data(fmt) => { root.import_data(fmt); }
        open_onboarding => { root.onboarding_step = 1; root.onboarding_open = true; }
        toggle_auto_updates(en) => { root.toggle_auto_updates(en); }
        check_updates => { root.check_updates_clicked(); }
        open_update_modal => { root.update_modal_open = true; }
        open_releases_page => { root.open_releases_page(); }
    }

    QuickProfilePopover {
        open: root.quick_profile_open;
        profiles: root.profiles_list;
        rail_width: root.rail_expanded ? 212px : (root.width < 940px ? 72px : 92px);
        close => { root.quick_profile_open = false; }
        switch_profile(id) => { root.profile_switch(id); }
        open_full_manager => { root.profiles_modal_open = true; }
    }

    OnboardingModal {
        open: root.onboarding_open;
        step <=> root.onboarding_step;
        profile_name: root.active_profile_name;
        close => {
            root.onboarding_open = false;
            root.onboarding_dismissed();
        }
        toggle_theme => { root.theme_quick_toggle(); }
        add_subject_chip(csv, tpl) => { return root.add_onboarding_subject(csv, tpl); }
        complete(pn, inst, grp, scsv, en_mcp, auto_mcp, acc) => {
            root.onboarding_open = false;
            root.onboarding_complete(pn, inst, grp, scsv, en_mcp, auto_mcp, acc);
        }
    }

    UpdateModal {
        open: root.update_modal_open;
        current_version: root.update_current_version;
        latest_version: root.update_latest_version;
        release_name: root.update_release_name;
        published_at: root.update_published_at;
        release_notes: root.update_release_notes;
        asset_label: root.update_asset_label;
        sha256_label: root.update_sha256_label;
        status_text: root.update_status_text;
        downloading: root.update_downloading;
        has_asset: root.update_has_asset;

        close => { root.update_modal_open = false; }
        download_and_install => { root.download_and_install_update(); }
        open_releases_page => { root.open_releases_page(); }
    }

    ShortcutsModal {
        open: root.shortcuts_modal_open;
        close => { root.shortcuts_modal_open = false; }
    }

    // Auto-dismiss timer for floating Snackbar feedback (~4s window reset per toast)
    Timer {
        interval: 500ms;
        running: root.snackbar_visible && root.snackbar_message != "";
        triggered => {
            if (root.snackbar_ticks <= 1) {
                root.snackbar_visible = false;
                root.snackbar_ticks = 0;
            } else {
                root.snackbar_ticks -= 1;
            }
        }
    }

    // Floating Snackbar feedback with M3 Expressive slide + fade animation
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.snackbar_visible && root.snackbar_message != "" ? (parent.height - self.height - 20px) : (parent.height + 16px);
        min_width: 280px;
        max_width: min(560px, parent.width - 32px);
        height: 44px;
        border_radius: 14px;
        background: MaterialPalette.inverse_surface;
        opacity: root.snackbar_visible && root.snackbar_message != "" ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        drop_shadow_blur: 16px;
        drop_shadow_color: #00000045;
        animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }

        HorizontalLayout {
            padding_left: 16px; padding_right: 8px; spacing: 10px; alignment: space-between;
            Text {
                text: root.snackbar_message;
                font_size: 13px; color: MaterialPalette.inverse_on_surface;
                vertical_alignment: center;
                overflow: elide;
            }
            OxidiumIconButton {
                icon: OxidiumIcons.close;
                inverse: true;
                button_size: 32px; icon_size: 18px;
                tooltip: "Закрыть";
                clicked => { root.snackbar_visible = false; }
            }
        }
    }

    // Top-Level Unclipped M3 Expressive Floating Tooltip Overlay (above rail, headers, ScrollViews, modals)
    Rectangle {
        property <bool> flip_above: OxidiumTooltipState.anchor_y + OxidiumTooltipState.anchor_h + 44px > root.height;
        property <length> pop_offset: OxidiumTooltipState.shown ? 0px : 6px;
        animate pop_offset { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }

        x: clamp(
            OxidiumTooltipState.anchor_x + (OxidiumTooltipState.anchor_w - self.width) / 2,
            10px,
            max(10px, parent.width - self.width - 10px)
        );
        y: flip_above
            ? (OxidiumTooltipState.anchor_y - self.height - 6px - self.pop_offset)
            : (OxidiumTooltipState.anchor_y + OxidiumTooltipState.anchor_h + 6px + self.pop_offset);
        width: min(260px, tip_row.preferred_width);
        height: tip_row.preferred_height;
        border_radius: 8px;
        background: MaterialPalette.inverse_surface;
        drop_shadow_blur: 10px;
        drop_shadow_color: #00000045;
        opacity: OxidiumTooltipState.shown && OxidiumTooltipState.text != "" ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }

        tip_row := HorizontalLayout {
            padding_left: 10px;
            padding_right: 10px;
            padding_top: 5px;
            padding_bottom: 5px;
            Text {
                max_width: 240px;
                text: OxidiumTooltipState.text;
                font_size: 11px;
                font_weight: 500;
                color: MaterialPalette.inverse_on_surface;
                wrap: word_wrap;
                vertical_alignment: center;
            }
        }
    }
}
