export component MainWindow inherits MaterialWindow {
    title: "Oxidium — Электронный журнал ученика";
    icon: OxidiumIcons.app_logo;
    default_font_family: OxidiumTheme.font_sans;
    preferred_width: 1380px;
    preferred_height: 860px;
    min_width: 800px;
    min_height: 560px;

    // Theme bridging helper
    in_out property <int> color_scheme_mode: 2; // 0=Light, 1=Dark, 2=System
    public function apply_color_scheme(mode: int) {
        root.color_scheme_mode = mode;
        if (mode == 0) {
            Palette.color-scheme = ColorScheme.light;
            OxidiumTheme.dark_mode = false;
        } else if (mode == 1) {
            Palette.color-scheme = ColorScheme.dark;
            OxidiumTheme.dark_mode = true;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
            OxidiumTheme.dark_mode = (Palette.color-scheme == ColorScheme.dark);
        }
    }

    public function qa_scroll_stats_activity(offset: length, hov_key: string, hov_title: string, hov_sum: string, hov_det: string) {
        stats_view.scroll_to_activity_qa(offset);
        stats_view.hovered_day_key = hov_key;
        stats_view.hovered_day_title = hov_title;
        stats_view.hovered_day_summary = hov_sum;
        stats_view.hovered_day_details = hov_det;
    }

    public function reset_stats_view_state() {
        OxidiumTooltipState.shown = false;
        stats_view.reset_transient_state();
    }

    public function reset_kanban_hover_state() {
        OxidiumTooltipState.shown = false;
        kanban_view.hover_hint = "";
    }
    changed color_scheme_mode => {
        if (root.color_scheme_mode == 0) {
            Palette.color-scheme = ColorScheme.light;
            OxidiumTheme.dark_mode = false;
        } else if (root.color_scheme_mode == 1) {
            Palette.color-scheme = ColorScheme.dark;
            OxidiumTheme.dark_mode = true;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
            OxidiumTheme.dark_mode = (Palette.color-scheme == ColorScheme.dark);
        }
    }

    // Navigation: EXACT 3 main sections (0=Journal, 1=Statistics, 2=Kanban)
    in_out property <int> active_section: 0;
    in property <UiStrings> tr: {
        nav_journal: "Журнал",
        nav_statistics: "Статистика",
        nav_kanban: "Канбан",
        nav_profiles: "Профили",
        nav_settings: "Настройки",
        nav_mcp: "MCP",
        journal_subject: "Предмет",
        journal_average: "Средний",
        journal_today: "Сегодня",
        journal_week: "Неделя",
        journal_month: "Месяц",
        journal_semester: "Семестр",
        journal_year: "Год",
        journal_add_subject: "Предметы",
        journal_empty: "Нет предметов. Добавьте первый предмет, чтобы начать вести журнал.",
        search_placeholder: "Поиск (Ctrl+F)...",
