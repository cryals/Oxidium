import { MaterialPalette, MaterialTypography, MaterialStyleMetrics, FilledButton, TonalButton, OutlineButton, Icon, ScrollView } from "@material";
import { OxidiumTheme, OxidiumMotion, OxidiumIcons } from "../theme.slint";
import { OxidiumIconButton } from "../components.slint";
import { DayHeaderItem, JournalRowItem, JournalCellItem, CellDetailEntry, MarkTypeItem, PeriodItem, UiStrings } from "../types.slint";

export component JournalView inherits Rectangle {
    in property <UiStrings> tr;
    in property <string> month_title: "Ноябрь 2026";
    in property <int> view_mode: 1; // 0=Week, 1=Month, 2=Semester, 3=Year, 4=Custom
    in property <string> overall_avg_text: "—";
    in property <string> average_mode_label: "Обычное";
    in property <[DayHeaderItem]> days;
    in property <[JournalRowItem]> rows;
    in property <[PeriodItem]> periods;
    in property <string> active_period_label: "Все даты";
    in property <[MarkTypeItem]> quick_marks;

    in_out property <int> active_row: -1;
    in_out property <int> active_col: -1;
    in_out property <bool> hand_mode: false;
    in_out property <string> subject_filter: "";
    property <bool> narrow_toolbar: root.width < 1140px;
    property <length> eff_subject_col_w: min(OxidiumTheme.subject_col_width, max(148px, root.width * 0.24));
    property <length> eff_avg_col_w: root.width < 880px ? min(OxidiumTheme.avg_col_width, 74px) : OxidiumTheme.avg_col_width;
    property <length> pan_start_x: 0px;
    property <length> pan_start_y: 0px;
    property <length> pan_start_vx: 0px;
    property <length> pan_start_vy: 0px;
    property <bool> is_panning: false;
    in_out property <bool> quick_picker_open: false;
    in_out property <string> picker_subject_id;
    in_out property <string> picker_subject_name;
    in_out property <string> picker_date_iso;

    // Cell detail modal state
    in_out property <bool> cell_detail_open: false;
    in property <[CellDetailEntry]> cell_entries;
    in_out property <string> detail_new_mark: "5";
    in_out property <string> detail_new_weight: "1";
    in_out property <int> detail_work_type_idx: 0;
    in_out property <string> detail_topic;
    in_out property <string> detail_comment;
    in_out property <string> detail_move_date;

    callback prev_period();
    callback next_period();
    callback go_today();
    callback change_view_mode(int);
    callback select_period(string);
    callback open_subjects_manager();
    callback open_periods_manager();
    callback open_onboarding();
    callback subject_filter_changed(string);
    callback cell_clicked(string, string, int, int, bool); // subject_id, date_iso, row, col, has_entries
    callback quick_mark_selected(string, string, string); // subject_id, date_iso, mark_code
    callback clear_cell_entries(string, string); // subject_id, date_iso
    callback open_cell_detail(string, string);
    callback add_detailed_entry(string, string, string, string, int, string, string);
    callback delete_cell_entry(string, bool); // entry_id, is_attendance
    callback copy_cell_entry(string, string); // entry_id, target_date
    callback move_cell_entry(string, string); // entry_id, target_date
    callback subject_create_task(string); // subject_id
    callback subject_open_tasks(string); // subject_id

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        padding: 16px;

        // Adaptive Calendar Navigation & Action Bar (1-row wide, 2-row narrow)
        Rectangle {
            vertical_stretch: 0;
            height: root.narrow_toolbar ? 98px : 58px;
            background: MaterialPalette.surface_container_low;
            border_radius: 16px;
            border_width: 1px;
            border_color: OxidiumTheme.cell_border;

            if !root.narrow_toolbar : HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    OxidiumIconButton {
                        icon: OxidiumIcons.chevron_left;
                        tooltip: "Предыдущий период";
                        clicked => { root.prev_period(); }
                    }

                    Rectangle {
                        min_width: 136px;
                        height: 36px;
                        border_radius: 18px;
                        background: MaterialPalette.primary_container;
                        HorizontalLayout {
                            padding_left: 12px;
                            padding_right: 12px;
                            alignment: center;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: OxidiumIcons.calendar;
                                    width: 15px;
                                    height: 15px;
                                    colorize: MaterialPalette.on_primary_container;
                                }
                            }
                            Text {
                                text: root.month_title;
                                font_family: OxidiumTheme.font_sans;
                                font_size: 13px;
                                font_weight: 600;
                                color: MaterialPalette.on_primary_container;
                                vertical_alignment: center;
                            }
                        }
                    }

                    OxidiumIconButton {
                        icon: OxidiumIcons.chevron_right;
                        tooltip: "Следующий период";
                        clicked => { root.next_period(); }
                    }

                    TonalButton {
                        text: root.tr.journal_today;
                        height: 36px;
                        clicked => { root.go_today(); }
                    }
                }

                // View Mode Segmented Switcher
                Rectangle {
                    height: 36px;
                    border_radius: 18px;
                    border_width: 1px;
                    border_color: MaterialPalette.outline_variant;
                    background: MaterialPalette.surface;
                    clip: true;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        for mode_item[idx] in [
                            root.tr.journal_week,
                            root.tr.journal_month,
                            root.tr.journal_semester,
                            root.tr.journal_year
                        ] : Rectangle {
                            border_radius: root.view_mode == idx ? 10px : 16px;
                            background: root.view_mode == idx ? MaterialPalette.secondary_container : transparent;
                            animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                            animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                            TouchArea {
                                mouse_cursor: pointer;
                                clicked => { root.change_view_mode(idx); }
                            }
                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                Text {
                                    text: mode_item;
                                    font_family: OxidiumTheme.font_sans;
                                    font_size: 12px;
                                    font_weight: root.view_mode == idx ? 600 : 400;
                                    color: root.view_mode == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                    horizontal_alignment: center;
                                    vertical_alignment: center;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    // Cursor / Hand (Pan) Mode Toggle (Stitch A01)
                    Rectangle {
                        height: 36px;
                        border_radius: 18px;
                        background: MaterialPalette.surface_container;
                        HorizontalLayout {
                            padding: 3px;
                            spacing: 2px;
                            Rectangle {
                                width: 30px; height: 30px;
                                border_radius: !root.hand_mode ? 10px : 15px;
                                background: !root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                Icon {
                                    source: OxidiumIcons.cursor;
                                    width: 16px; height: 16px;
                                    colorize: !root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                }
                                TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = false; } }
                            }
                            Rectangle {
                                width: 30px; height: 30px;
                                border_radius: root.hand_mode ? 10px : 15px;
                                background: root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                Icon {
                                    source: OxidiumIcons.hand;
                                    width: 16px; height: 16px;
                                    colorize: root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                }
                                TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = true; root.quick_picker_open = false; } }
                            }
                        }
                    }

                    // Inline Live Subject Filter (Stitch A01)
                    Rectangle {
                        width: 136px;
                        height: 36px;
                        border_radius: 18px;
                        background: MaterialPalette.surface_container_high;
                        HorizontalLayout {
                            padding_left: 10px; padding_right: 10px; spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon { source: OxidiumIcons.search; width: 15px; height: 15px; colorize: MaterialPalette.on_surface_variant; }
                            }
                            TextInput {
                                horizontal_stretch: 1;
                                vertical_alignment: center;
                                text <=> root.subject_filter;
                                font_size: 12px;
                                color: MaterialPalette.on_surface;
                                edited => { root.subject_filter_changed(root.subject_filter); }
                            }
                        }
                        if root.subject_filter == "" : Text {
                            x: 31px;
                            y: 0px;
                            height: 100%;
                            text: "Предмет...";
                            font_size: 12px;
                            color: MaterialPalette.on_surface_variant;
                            vertical_alignment: center;
                        }
                    }

                    // Overall Period Average Pill
                    Rectangle {
                        height: 36px;
                        border_radius: 18px;
                        background: MaterialPalette.surface_container_high;
                        HorizontalLayout {
                            padding_left: 10px;
                            padding_right: 10px;
                            spacing: 5px;
                            Text {
                                text: "Ср.:";
                                font_size: 12px;
                                color: MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                            Text {
                                text: root.overall_avg_text;
                                font_family: OxidiumTheme.font_mono;
                                font_size: 14px;
                                font_weight: 700;
                                color: MaterialPalette.primary;
                                vertical_alignment: center;
                            }
                        }
                    }

                    OutlineButton {
                        text: root.active_period_label;
                        height: 36px;
                        clicked => { root.open_periods_manager(); }
                    }

                    FilledButton {
                        text: root.tr.journal_add_subject;
                        height: 36px;
                        icon: OxidiumIcons.add;
                        clicked => { root.open_subjects_manager(); }
                    }
                }
            }

            if root.narrow_toolbar : VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 4px;
                        OxidiumIconButton {
                            icon: OxidiumIcons.chevron_left;
                            button_size: 34px; icon_size: 18px;
                            tooltip: "Предыдущий период";
                            clicked => { root.prev_period(); }
                        }
                        Rectangle {
                            min_width: 120px; height: 34px; border_radius: 17px; background: MaterialPalette.primary_container;
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 10px; alignment: center; spacing: 5px;
                                VerticalLayout { alignment: center; Icon { source: OxidiumIcons.calendar; width: 14px; height: 14px; colorize: MaterialPalette.on_primary_container; } }
                                Text { text: root.month_title; font_family: OxidiumTheme.font_sans; font_size: 12px; font_weight: 600; color: MaterialPalette.on_primary_container; vertical_alignment: center; }
                            }
                        }
                        OxidiumIconButton {
                            icon: OxidiumIcons.chevron_right;
                            button_size: 34px; icon_size: 18px;
                            tooltip: "Следующий период";
                            clicked => { root.next_period(); }
                        }
                        TonalButton { text: root.tr.journal_today; height: 34px; clicked => { root.go_today(); } }
                    }

                    Rectangle {
                        height: 34px; border_radius: 17px; border_width: 1px; border_color: MaterialPalette.outline_variant; background: MaterialPalette.surface; clip: true;
                        HorizontalLayout {
                            padding: 2px; spacing: 2px;
                            for mode_item[idx] in [
                                root.tr.journal_week,
                                root.tr.journal_month,
                                root.tr.journal_semester,
                                root.tr.journal_year
                            ] : Rectangle {
                                border_radius: root.view_mode == idx ? 9px : 15px;
                                background: root.view_mode == idx ? MaterialPalette.secondary_container : transparent;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                TouchArea { mouse_cursor: pointer; clicked => { root.change_view_mode(idx); } }
                                HorizontalLayout {
                                    padding_left: 9px; padding_right: 9px;
                                    Text {
                                        text: mode_item; font_family: OxidiumTheme.font_sans; font_size: 11px;
                                        font_weight: root.view_mode == idx ? 600 : 400;
                                        color: root.view_mode == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                        horizontal_alignment: center; vertical_alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 34px; border_radius: 17px; background: MaterialPalette.surface_container;
                            HorizontalLayout {
                                padding: 3px; spacing: 2px;
                                Rectangle {
                                    width: 28px; height: 28px; border_radius: !root.hand_mode ? 9px : 14px;
                                    background: !root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                    animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                    animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                    Icon { source: OxidiumIcons.cursor; width: 15px; height: 15px; colorize: !root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant; }
                                    TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = false; } }
                                }
                                Rectangle {
                                    width: 28px; height: 28px; border_radius: root.hand_mode ? 9px : 14px;
                                    background: root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                    animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                    animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                    Icon { source: OxidiumIcons.hand; width: 15px; height: 15px; colorize: root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant; }
                                    TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = true; root.quick_picker_open = false; } }
                                }
                            }
                        }
                        Rectangle {
                            width: 130px; height: 34px; border_radius: 17px; background: MaterialPalette.surface_container_high;
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 10px; spacing: 6px;
                                VerticalLayout { alignment: center; Icon { source: OxidiumIcons.search; width: 14px; height: 14px; colorize: MaterialPalette.on_surface_variant; } }
                                TextInput { horizontal_stretch: 1; vertical_alignment: center; text <=> root.subject_filter; font_size: 12px; color: MaterialPalette.on_surface; edited => { root.subject_filter_changed(root.subject_filter); } }
                            }
                            if root.subject_filter == "" : Text { x: 30px; y: 0px; height: 100%; text: "Предмет..."; font_size: 12px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                        }
                        Rectangle {
                            height: 34px; border_radius: 17px; background: MaterialPalette.surface_container_high;
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 10px; spacing: 4px;
                                Text { text: "Ср.:"; font_size: 11px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                                Text { text: root.overall_avg_text; font_family: OxidiumTheme.font_mono; font_size: 13px; font_weight: 700; color: MaterialPalette.primary; vertical_alignment: center; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        OutlineButton { text: root.active_period_label; height: 34px; clicked => { root.open_periods_manager(); } }
                        FilledButton { text: root.tr.journal_add_subject; height: 34px; icon: OxidiumIcons.add; clicked => { root.open_subjects_manager(); } }
                    }
                }
            }
        }

        // Empty State or Synchronized Pinned Journal Matrix
        if root.rows.length == 0 : Rectangle {
            vertical_stretch: 1;
            background: MaterialPalette.surface_container_low;
            border_radius: 20px;
            border_width: 1px;
            border_color: OxidiumTheme.cell_border;

            VerticalLayout {
                alignment: center;
                spacing: 16px;
                padding: 32px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border_radius: 20px;
                        background: MaterialPalette.primary_container;
                        Icon {
                            source: OxidiumIcons.journal;
                            width: 32px;
                            height: 32px;
                            colorize: MaterialPalette.on_primary_container;
                        }
                    }
                }

                Text {
                    text: root.tr.journal_empty;
                    font_size: 16px;
                    color: MaterialPalette.on_surface_variant;
                    horizontal_alignment: center;
                    wrap: word_wrap;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    FilledButton {
                        text: "Быстрая настройка (30 сек)";
                        icon: OxidiumIcons.arrow_forward;
                        clicked => { root.open_onboarding(); }
                    }
                    TonalButton {
                        text: root.tr.journal_add_subject;
                        icon: OxidiumIcons.add;
                        clicked => { root.open_subjects_manager(); }
                    }
                }
            }
        }

        if root.rows.length > 0 : Rectangle {
            vertical_stretch: 1;
            background: MaterialPalette.surface_container_lowest;
            border_radius: 18px;
            border_width: 1px;
            border_color: OxidiumTheme.cell_border;
            clip: true;

            VerticalLayout {
                spacing: 0px;

                // ===== PINNED TOP HEADER ROW =====
                Rectangle {
                    height: 54px;
                    background: MaterialPalette.surface_container;

                    HorizontalLayout {
                        spacing: 0px;

                        // Pinned Left Corner ("Предмет")
                        Rectangle {
                            width: root.eff_subject_col_w;
                            background: MaterialPalette.surface_container_high;
                            HorizontalLayout {
                                padding_left: 16px;
                                padding_right: 12px;
                                alignment: space-between;
                                Text {
                                    text: root.tr.journal_subject;
                                    font_family: OxidiumTheme.font_sans;
                                    font_size: 13px;
                                    font_weight: 600;
                                    color: MaterialPalette.on_surface;
                                    vertical_alignment: center;
                                }
                                Text {
                                    text: root.rows.length;
                                    font_family: OxidiumTheme.font_mono;
                                    font_size: 11px;
                                    color: MaterialPalette.on_surface_variant;
                                    vertical_alignment: center;
                                }
                            }
                            Rectangle {
                                x: parent.width - 1px;
                                width: 1px;
                                height: 100%;
                                background: OxidiumTheme.cell_border;
                            }
                        }

                        // Horizontally Synchronized Dates Header (bound to grid_scroll.viewport_x!)
                        Rectangle {
                            horizontal_stretch: 1;
                            clip: true;

                            Rectangle {
                                x: grid_scroll.viewport_x;
                                y: 0px;
                                width: root.days.length * OxidiumTheme.cell_width;
                                height: parent.height;

                                for day[d_idx] in root.days : Rectangle {
                                    x: d_idx * OxidiumTheme.cell_width;
                                    y: 0px;
                                    width: OxidiumTheme.cell_width;
                                    height: parent.height;
                                    background: day.is_today ? OxidiumTheme.today_tint
                                        : day.is_holiday ? OxidiumTheme.holiday_tint
                                        : day.is_weekend ? OxidiumTheme.weekend_tint
                                        : transparent;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 26px;
                                                height: 22px;
                                                border_radius: 11px;
                                                background: day.is_today ? MaterialPalette.primary : transparent;
                                                Text {
                                                    text: day.day_num;
                                                    font_family: OxidiumTheme.font_mono;
                                                    font_size: 12px;
                                                    font_weight: 700;
                                                    color: day.is_today ? MaterialPalette.on_primary : MaterialPalette.on_surface;
                                                    horizontal_alignment: center;
                                                    vertical_alignment: center;
                                                }
                                            }
                                        }
                                        Text {
                                            text: day.weekday_short;
                                            font_family: OxidiumTheme.font_sans;
                                            font_size: 10px;
                                            font_weight: day.is_today ? 700 : 500;
                                            color: day.is_today ? MaterialPalette.primary
                                                : day.is_holiday ? OxidiumTheme.warning_color
                                                : day.is_weekend ? MaterialPalette.error
                                                : MaterialPalette.on_surface_variant;
                                            horizontal_alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        x: parent.width - 1px;
                                        width: 1px;
                                        height: 100%;
                                        background: OxidiumTheme.cell_border;
                                    }
                                }
                            }
                        }

                        // Pinned Right Corner ("Средний")
                        Rectangle {
                            width: root.eff_avg_col_w;
                            background: MaterialPalette.surface_container_high;
                            Rectangle {
                                x: 0px;
                                width: 1px;
                                height: 100%;
                                background: OxidiumTheme.cell_border;
                            }
                            Text {
                                text: root.tr.journal_average;
                                font_family: OxidiumTheme.font_sans;
                                font_size: 13px;
                                font_weight: 600;
                                color: MaterialPalette.on_surface;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: 100%;
                        background: OxidiumTheme.cell_border;
                    }
                }

                // ===== SYNCHRONIZED BODY AREA =====
                HorizontalLayout {
                    vertical_stretch: 1;
                    spacing: 0px;

                    // Pinned Left Subject Column (bound directly to grid_scroll.viewport_y!)
                    Rectangle {
                        width: root.eff_subject_col_w;
                        background: MaterialPalette.surface_container_low;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: grid_scroll.viewport_y;
                            width: parent.width;
                            height: root.rows.length * OxidiumTheme.row_height;

                            for row in root.rows : Rectangle {
                                x: 0px;
                                y: row.row_index * OxidiumTheme.row_height;
                                width: parent.width;
                                height: OxidiumTheme.row_height;
                                background: root.active_row == row.row_index ? MaterialPalette.primary_container.with_alpha(25%) : transparent;

                                HorizontalLayout {
                                    padding_left: 12px;
                                    padding_right: 8px;
                                    spacing: 8px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        horizontal_stretch: 1;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 4px;
                                                height: 24px;
                                                border_radius: 2px;
                                                background: row.color;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            horizontal_stretch: 1;
                                            Text {
                                                text: row.subject_name;
                                                font_family: OxidiumTheme.font_sans;
                                                font_size: 13px;
                                                font_weight: 500;
                                                color: MaterialPalette.on_surface;
                                                overflow: elide;
                                            }
                                            if row.teacher != "" && !OxidiumTheme.compact_mode : Text {
                                                text: row.teacher;
                                                font_size: 11px;
                                                color: MaterialPalette.on_surface_variant;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Quick open tasks for subject
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        y: (parent.height - self.height) / 2;
                                        border_radius: subj_ta.pressed ? 7px : 12px;
                                        background: subj_ta.has_hover ? MaterialPalette.surface_container_highest : transparent;
                                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                                        Icon {
                                            source: OxidiumIcons.kanban;
                                            width: 14px;
                                            height: 14px;
                                            colorize: MaterialPalette.on_surface_variant;
                                        }
                                        subj_ta := TouchArea {
                                            mouse_cursor: pointer;
                                            clicked => { root.subject_open_tasks(row.subject_id); }
                                        }
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    width: 100%;
                                    background: OxidiumTheme.cell_border;
                                }
                            }
                        }

                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            height: 100%;
                            background: OxidiumTheme.cell_border;
                        }
                    }

                    // Center Scrollable Cells Grid (with optional Hand-Pan overlay)
                    Rectangle {
                        horizontal_stretch: 1;
                        vertical_stretch: 1;

                        grid_scroll := ScrollView {
                            width: 100%;
                            height: 100%;
                            viewport_width: max(root.days.length * OxidiumTheme.cell_width, self.visible_width);
                            viewport_height: max(root.rows.length * OxidiumTheme.row_height, self.visible_height);

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: root.days.length * OxidiumTheme.cell_width;
                                height: root.rows.length * OxidiumTheme.row_height;

                                for row in root.rows : Rectangle {
                                    x: 0px;
                                    y: row.row_index * OxidiumTheme.row_height;
                                    width: parent.width;
                                    height: OxidiumTheme.row_height;

                                    for cell in row.cells : Rectangle {
                                        x: cell.day_index * OxidiumTheme.cell_width;
                                        y: 0px;
                                        width: OxidiumTheme.cell_width;
                                        height: parent.height;
                                        background: cell_ta.has_hover && !root.hand_mode ? MaterialPalette.primary_container.with_alpha(45%)
                                            : cell.is_today ? OxidiumTheme.today_tint
                                            : cell.is_holiday ? OxidiumTheme.holiday_tint
                                            : cell.is_weekend ? OxidiumTheme.weekend_tint
                                            : transparent;
                                        border_width: (root.active_row == row.row_index && root.active_col == cell.day_index) ? 2px : 0px;
                                        border_color: MaterialPalette.primary;
                                        animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }

                                        if cell.has_entries : HorizontalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            padding: 2px;

                                            Rectangle {
                                                height: cell.secondary_label == "" ? 28px : 22px;
                                                min_width: cell.secondary_label == "" ? 28px : 17px;
                                                y: (parent.height - self.height) / 2;
                                                border_radius: cell.secondary_label == "" ? 8px : 6px;
                                                background: cell.primary_bg;

                                                HorizontalLayout {
                                                    padding_left: cell.secondary_label == "" ? 5px : 4px;
                                                    padding_right: cell.secondary_label == "" ? 5px : 4px;
                                                    Text {
                                                        text: cell.primary_label;
                                                        font_family: OxidiumTheme.font_mono;
                                                        font_size: cell.secondary_label == "" ? 12px : 10px;
                                                        font_weight: 700;
                                                        color: cell.primary_fg;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }
                                            }

                                            if cell.secondary_label != "" : Rectangle {
                                                height: 22px;
                                                min_width: 16px;
                                                y: (parent.height - self.height) / 2;
                                                border_radius: 6px;
                                                background: cell.secondary_bg;
                                                HorizontalLayout {
                                                    padding_left: 3px;
                                                    padding_right: 3px;
                                                    Text {
                                                        text: cell.secondary_label;
                                                        font_family: OxidiumTheme.font_mono;
                                                        font_size: 9px;
                                                        font_weight: 700;
                                                        color: cell.secondary_fg;
                                                        horizontal_alignment: center;
                                                        vertical_alignment: center;
                                                    }
                                                }
                                            }

                                            if cell.extra_count > 0 : Text {
                                                text: "+" + cell.extra_count;
                                                font_family: OxidiumTheme.font_mono;
                                                font_size: 9px;
                                                color: MaterialPalette.on_surface_variant;
                                                vertical_alignment: center;
                                            }
                                        }

                                        // Subtle MCP AI source micro-indicator
                                        if cell.has_mcp : Rectangle {
                                            x: parent.width - 8px;
                                            y: 2px;
                                            width: 6px;
                                            height: 6px;
                                            border_radius: 3px;
                                            background: MaterialPalette.primary;
                                        }

                                        Rectangle {
                                            x: parent.width - 1px;
                                            width: 1px;
                                            height: 100%;
                                            background: OxidiumTheme.cell_border;
                                        }
                                        Rectangle {
                                            y: parent.height - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: OxidiumTheme.cell_border;
                                        }

                                        cell_ta := TouchArea {
                                            mouse_cursor: root.hand_mode ? grab : pointer;
                                            clicked => {
                                                if (!root.hand_mode) {
                                                    root.active_row = row.row_index;
                                                    root.active_col = cell.day_index;
                                                    root.picker_subject_id = row.subject_id;
                                                    root.picker_subject_name = row.subject_name;
                                                    root.picker_date_iso = cell.date_iso;
                                                    root.cell_clicked(row.subject_id, cell.date_iso, row.row_index, cell.day_index, cell.has_entries);
                                                }
                                            }
                                            pointer-event(ev) => {
                                                if (!root.hand_mode && ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                                    root.active_row = row.row_index;
                                                    root.active_col = cell.day_index;
                                                    root.picker_subject_id = row.subject_id;
                                                    root.picker_subject_name = row.subject_name;
                                                    root.picker_date_iso = cell.date_iso;
                                                    root.open_cell_detail(row.subject_id, cell.date_iso);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Hand-Pan Gesture Overlay when hand_mode is active
                        if root.hand_mode : TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse_cursor: root.is_panning ? grabbing : grab;
                            pointer-event(ev) => {
                                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                                    root.is_panning = true;
                                    root.pan_start_x = self.mouse_x;
                                    root.pan_start_y = self.mouse_y;
                                    root.pan_start_vx = grid_scroll.viewport_x;
                                    root.pan_start_vy = grid_scroll.viewport_y;
                                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                    root.is_panning = false;
                                }
                            }
                            moved => {
                                if (root.is_panning) {
                                    grid_scroll.viewport_x = clamp(
                                        root.pan_start_vx + (self.mouse_x - root.pan_start_x),
                                        min(0px, grid_scroll.visible_width - grid_scroll.viewport_width),
                                        0px
                                    );
                                    grid_scroll.viewport_y = clamp(
                                        root.pan_start_vy + (self.mouse_y - root.pan_start_y),
                                        min(0px, grid_scroll.visible_height - grid_scroll.viewport_height),
                                        0px
                                    );
                                }
                            }
                        }
                    }

                    // Pinned Right Average Column (bound directly to grid_scroll.viewport_y!)
                    Rectangle {
                        width: root.eff_avg_col_w;
                        background: MaterialPalette.surface_container_low;
                        clip: true;

                        Rectangle {
                            x: 0px;
                            y: grid_scroll.viewport_y;
                            width: parent.width;
                            height: root.rows.length * OxidiumTheme.row_height;

                            for row in root.rows : Rectangle {
                                x: 0px;
                                y: row.row_index * OxidiumTheme.row_height;
                                width: parent.width;
                                height: OxidiumTheme.row_height;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: row.average_text;
                                        font_family: OxidiumTheme.font_mono;
                                        font_size: 14px;
                                        font_weight: 700;
                                        color: row.average_text == "—" ? MaterialPalette.on_surface_variant
                                            : row.below_target ? OxidiumTheme.warning_color
                                            : MaterialPalette.primary;
                                        horizontal_alignment: center;
                                    }
                                    if row.target_text != "" && !OxidiumTheme.compact_mode : Text {
                                        text: "цель " + row.target_text;
                                        font_family: OxidiumTheme.font_mono;
                                        font_size: 9px;
                                        color: row.below_target ? OxidiumTheme.warning_color : OxidiumTheme.success_color;
                                        horizontal_alignment: center;
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    width: 100%;
                                    background: OxidiumTheme.cell_border;
                                }
                            }
                        }

                        Rectangle {
                            x: 0px;
                            width: 1px;
                            height: 100%;
                            background: OxidiumTheme.cell_border;
                        }
                    }
                }

                // ===== COMPACT LEGEND FOOTER (Stitch A01) =====
                Rectangle {
                    height: 34px;
                    background: MaterialPalette.surface_container;

                    Rectangle {
                        y: 0px;
                        height: 1px;
                        width: 100%;
                        background: OxidiumTheme.cell_border;
                    }

                    HorizontalLayout {
                        padding_left: 16px;
                        padding_right: 16px;
                        spacing: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: root.width < 900px ? 7px : 12px;
                            if root.width >= 820px : Text { text: "Обозначения:"; font_size: 11px; font_weight: 600; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }

                            for leg in [
                                { label: "5 Отлично", bg: OxidiumTheme.grade_5_bg, bd: OxidiumTheme.grade_5 },
                                { label: "4 Хорошо", bg: OxidiumTheme.grade_4_bg, bd: OxidiumTheme.grade_4 },
                                { label: "3 Удовл.", bg: OxidiumTheme.grade_3_bg, bd: OxidiumTheme.grade_3 },
                                { label: "Н/Б Пропуск", bg: OxidiumTheme.grade_1_bg, bd: OxidiumTheme.grade_1 },
                                { label: "Уваж.", bg: OxidiumTheme.info_bg, bd: OxidiumTheme.mark_excused },
                            ] : HorizontalLayout {
                                spacing: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle { width: 11px; height: 11px; border_radius: 3px; background: leg.bg; border_width: 1px; border_color: leg.bd; }
                                }
                                Text { text: leg.label; font_size: 11px; color: MaterialPalette.on_surface; vertical_alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle { width: 8px; height: 8px; border_radius: 4px; background: MaterialPalette.primary; }
                                }
                                Text {
                                    text: root.width < 880px ? "MCP" : "Добавлено через MCP";
                                    font_size: 11px; font_weight: 600; color: MaterialPalette.primary; vertical_alignment: center;
                                }
                            }
                        }

                        if root.width >= 1040px : Text {
                            text: root.hand_mode ? "Ладошка: перетаскивайте таблицу мышью" : "Клик — ввод · ПКМ — детали · 1–5 — оценка";
                            font_family: OxidiumTheme.font_mono;
                            font_size: 11px;
                            color: MaterialPalette.on_surface_variant;
                            vertical_alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ===== COMPACT QUICK GRADE PICKER OVERLAY =====
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000040;
        opacity: root.quick_picker_open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }

        TouchArea {
            enabled: root.quick_picker_open;
            clicked => { root.quick_picker_open = false; }
        }

        Rectangle {
            width: min(380px, parent.width - 28px);
            height: min(parent.height - 28px, quick_layout.preferred_height + 28px);
            x: (parent.width - self.width) / 2;
            y: root.quick_picker_open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 24px);
            animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
            border_radius: 24px;
            background: MaterialPalette.surface_container_high;
            border_width: 1px;
            border_color: MaterialPalette.outline_variant;
            drop_shadow_blur: 24px;
            drop_shadow_color: #00000045;

            TouchArea {}

            quick_layout := VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        Text {
                            text: root.picker_subject_name;
                            font_size: 16px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        Text {
                            text: root.picker_date_iso;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 12px;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }
                    OxidiumIconButton {
                        icon: OxidiumIcons.close;
                        tooltip: "Закрыть";
                        clicked => { root.quick_picker_open = false; }
                    }
                }

                // Connected Expressive Numeric Grades 5..1 (Stitch A05 accessible containers)
                HorizontalLayout {
                    spacing: 4px;
                    for g[g_idx] in [
                        { code: "grade_5", label: "5", bg: OxidiumTheme.grade_5_bg, fg: OxidiumTheme.grade_5_fg },
                        { code: "grade_4", label: "4", bg: OxidiumTheme.grade_4_bg, fg: OxidiumTheme.grade_4_fg },
                        { code: "grade_3", label: "3", bg: OxidiumTheme.grade_3_bg, fg: OxidiumTheme.grade_3_fg },
                        { code: "grade_2", label: "2", bg: OxidiumTheme.grade_2_bg, fg: OxidiumTheme.grade_2_fg },
                        { code: "grade_1", label: "1", bg: OxidiumTheme.grade_1_bg, fg: OxidiumTheme.grade_1_fg },
                    ] : Rectangle {
                        horizontal_stretch: 1;
                        height: 44px;
                        border_radius: 10px;
                        border_top_left_radius: g_ta.pressed ? 8px : (g_idx == 0 ? 22px : 8px);
                        border_bottom_left_radius: g_ta.pressed ? 8px : (g_idx == 0 ? 22px : 8px);
                        border_top_right_radius: g_ta.pressed ? 8px : (g_idx == 4 ? 22px : 8px);
                        border_bottom_right_radius: g_ta.pressed ? 8px : (g_idx == 4 ? 22px : 8px);
                        background: g.bg;
                        border_width: g_ta.has_hover ? 2px : 0px;
                        border_color: g.fg;
                        animate border_top_left_radius, border_bottom_left_radius, border_top_right_radius, border_bottom_right_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                        animate border_width { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                        Text {
                            text: g.label;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 17px;
                            font_weight: 700;
                            color: g.fg;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                        g_ta := TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.quick_picker_open = false;
                                root.quick_mark_selected(root.picker_subject_id, root.picker_date_iso, g.code);
                            }
                        }
                    }
                }

                // Attendance & Pass/Fail marks
                HorizontalLayout {
                    spacing: 6px;
                    for m in [
                        { code: "absent", label: "Н/Б", bg: OxidiumTheme.grade_1_bg, fg: OxidiumTheme.grade_1_fg },
                        { code: "excused", label: "Уваж.", bg: OxidiumTheme.info_bg, fg: OxidiumTheme.info_fg },
                        { code: "pass", label: "Зач.", bg: OxidiumTheme.grade_5_bg, fg: OxidiumTheme.grade_5_fg },
                        { code: "fail", label: "Н/З", bg: OxidiumTheme.grade_1_bg, fg: OxidiumTheme.grade_1_fg },
                    ] : Rectangle {
                        horizontal_stretch: 1;
                        height: 36px;
                        border_radius: 10px;
                        background: m.bg;
                        border_width: m_ta.has_hover ? 1px : 0px;
                        border_color: m.fg;
                        Text {
                            text: m.label;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 12px;
                            font_weight: 700;
                            color: m.fg;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                        m_ta := TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.quick_picker_open = false;
                                root.quick_mark_selected(root.picker_subject_id, root.picker_date_iso, m.code);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    OutlineButton {
                        text: "Очистить";
                        height: 38px;
                        clicked => {
                            root.quick_picker_open = false;
                            root.clear_cell_entries(root.picker_subject_id, root.picker_date_iso);
                        }
                    }
                    TonalButton {
                        text: "Подробнее →";
                        height: 38px;
                        clicked => {
                            root.quick_picker_open = false;
                            root.open_cell_detail(root.picker_subject_id, root.picker_date_iso);
                        }
                    }
                }
            }
        }
    }

    // ===== CELL DETAIL & MULTI-ENTRY EDITOR MODAL =====
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000050;
        opacity: root.cell_detail_open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }

        TouchArea {
            enabled: root.cell_detail_open;
            clicked => { root.cell_detail_open = false; }
        }

        Rectangle {
            width: min(560px, parent.width - 28px);
            height: min(590px, parent.height - 28px);
            x: (parent.width - self.width) / 2;
            y: root.cell_detail_open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 24px);
            animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
            border_radius: 24px;
            background: MaterialPalette.surface_container_high;
            border_width: 1px;
            border_color: MaterialPalette.outline_variant;
            drop_shadow_blur: 28px;
            drop_shadow_color: #00000055;

            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        Text {
                            text: root.picker_subject_name;
                            font_size: 18px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        Text {
                            text: "Дата: " + root.picker_date_iso + " • Записей: " + root.cell_entries.length;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 12px;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }
                    OxidiumIconButton {
                        icon: OxidiumIcons.close;
                        tooltip: "Закрыть";
                        clicked => { root.cell_detail_open = false; }
                    }
                }

                // Existing entries list
                ScrollView {
                    height: 176px;
                    viewport_width: self.visible_width;
                    viewport_height: max(self.visible_height, cell_entries_col.preferred_height);
                    cell_entries_col := VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.visible_width;
                        spacing: 8px;
                        alignment: start;
                        if root.cell_entries.length == 0 : Text {
                            text: "Записей за этот день пока нет.";
                            font_size: 13px;
                            color: MaterialPalette.on_surface_variant;
                        }
                        for entry in root.cell_entries : Rectangle {
                            border_radius: 12px;
                            background: MaterialPalette.surface_container;
                            border_width: 1px;
                            border_color: OxidiumTheme.cell_border;

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 10px;
                                    horizontal_stretch: 1;
                                    Rectangle {
                                        width: 48px;
                                        height: 36px;
                                        border_radius: 10px;
                                        background: entry.color.with_alpha(24%);
                                        Text {
                                            text: entry.label;
                                            font_family: OxidiumTheme.font_mono;
                                            font_size: 13px;
                                            font_weight: 700;
                                            color: entry.color;
                                            horizontal_alignment: center;
                                            vertical_alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: entry.work_type_label + (entry.weight_text != "" ? " • вес " + entry.weight_text : "") + " [" + entry.source_label + "]";
                                            font_size: 12px;
                                            font_weight: 600;
                                            color: MaterialPalette.on_surface;
                                        }
                                        if entry.topic != "" : Text {
                                            text: "Тема: " + entry.topic;
                                            font_size: 11px;
                                            color: MaterialPalette.on_surface_variant;
                                        }
                                        if entry.comment != "" : Text {
                                            text: entry.comment;
                                            font_size: 11px;
                                            color: MaterialPalette.on_surface_variant;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 2px;
                                    if !entry.is_attendance : OxidiumIconButton {
                                        icon: OxidiumIcons.copy;
                                        button_size: 34px; icon_size: 17px;
                                        tooltip: "Копировать на дату (ISO)";
                                        clicked => { root.copy_cell_entry(entry.id, root.detail_move_date); }
                                    }
                                    if !entry.is_attendance : OxidiumIconButton {
                                        icon: OxidiumIcons.arrow_forward;
                                        button_size: 34px; icon_size: 17px;
                                        tooltip: "Перенести на дату (ISO)";
                                        clicked => { root.move_cell_entry(entry.id, root.detail_move_date); }
                                    }
                                    OxidiumIconButton {
                                        icon: OxidiumIcons.delete;
                                        button_size: 34px; icon_size: 17px;
                                        tooltip: "Удалить запись";
                                        clicked => { root.delete_cell_entry(entry.id, entry.is_attendance); }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: OxidiumTheme.cell_border; }

                // Add detailed grade/attendance form
                Text {
                    text: "Добавить запись за " + root.picker_date_iso;
                    font_size: 14px;
                    font_weight: 600;
                    color: MaterialPalette.on_surface;
                }

                HorizontalLayout {
                    spacing: 6px;
                    for m in ["5", "4", "3", "2", "1", "Н/Б", "Уваж.", "Зач.", "Н/З"] : Rectangle {
                        horizontal_stretch: 1;
                        height: 32px;
                        border_radius: 8px;
                        background: root.detail_new_mark == m ? MaterialPalette.primary : MaterialPalette.surface_container;
                        Text {
                            text: m;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 11px;
                            font_weight: 700;
                            color: root.detail_new_mark == m ? MaterialPalette.on_primary : MaterialPalette.on_surface;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                        TouchArea {
                            mouse_cursor: pointer;
                            clicked => { root.detail_new_mark = m; }
                        }
                    }
                }

                // Work type selector matching WorkType::all() indices
                HorizontalLayout {
                    spacing: 5px;
                    for wt in [
                        { idx: 0, l: "Ответ" },
                        { idx: 1, l: "Д/З" },
                        { idx: 2, l: "Контр." },
                        { idx: 4, l: "Лаб." },
                        { idx: 6, l: "Тест" },
                        { idx: 8, l: "Экзамен" },
                        { idx: 10, l: "Другое" },
                    ] : Rectangle {
                        horizontal_stretch: 1;
                        height: 28px;
                        border_radius: 8px;
                        background: root.detail_work_type_idx == wt.idx ? MaterialPalette.secondary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: root.detail_work_type_idx == wt.idx ? MaterialPalette.primary : OxidiumTheme.cell_border;
                        Text {
                            text: wt.l;
                            font_size: 10px;
                            font_weight: root.detail_work_type_idx == wt.idx ? 600 : 500;
                            color: root.detail_work_type_idx == wt.idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                        TouchArea {
                            mouse_cursor: pointer;
                            clicked => { root.detail_work_type_idx = wt.idx; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        width: 90px;
                        spacing: 4px;
                        Text { text: "Вес"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 36px;
                            border_radius: 8px;
                            background: MaterialPalette.surface;
                            border_width: 1px;
                            border_color: MaterialPalette.outline_variant;
                            TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                vertical_alignment: center;
                                text <=> root.detail_new_weight;
                                font_family: OxidiumTheme.font_mono;
                                color: MaterialPalette.on_surface;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal_stretch: 1;
                        spacing: 4px;
                        Text { text: "Тема занятия"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 36px;
                            border_radius: 8px;
                            background: MaterialPalette.surface;
                            border_width: 1px;
                            border_color: MaterialPalette.outline_variant;
                            TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                vertical_alignment: center;
                                text <=> root.detail_topic;
                                color: MaterialPalette.on_surface;
                            }
                            if root.detail_topic == "" : Text { x: 8px; height: 100%; text: "Например: Тема или причина"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal_stretch: 1;
                        spacing: 4px;
                        Text { text: "Комментарий / причина"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 36px;
                            border_radius: 8px;
                            background: MaterialPalette.surface;
                            border_width: 1px;
                            border_color: MaterialPalette.outline_variant;
                            TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                vertical_alignment: center;
                                text <=> root.detail_comment;
                                color: MaterialPalette.on_surface;
                            }
                            if root.detail_comment == "" : Text { x: 8px; height: 100%; text: "Необязательная заметка"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                        }
                    }
                    VerticalLayout {
                        width: 150px;
                        spacing: 4px;
                        Text { text: "Дата копии/переноса"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 36px;
                            border_radius: 8px;
                            background: MaterialPalette.surface;
                            border_width: 1px;
                            border_color: MaterialPalette.outline_variant;
                            TextInput {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                vertical_alignment: center;
                                text <=> root.detail_move_date;
                                font_family: OxidiumTheme.font_mono;
                                color: MaterialPalette.on_surface;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    OutlineButton {
                        text: "Закрыть";
                        height: 36px;
                        clicked => { root.cell_detail_open = false; }
                    }
                    FilledButton {
                        text: "Добавить запись";
                        height: 36px;
                        icon: OxidiumIcons.add;
                        clicked => {
                            root.add_detailed_entry(
                                root.picker_subject_id,
                                root.picker_date_iso,
                                root.detail_new_mark,
                                root.detail_new_weight,
                                root.detail_work_type_idx,
                                root.detail_topic,
                                root.detail_comment,
                            );
                            root.detail_topic = "";
                            root.detail_comment = "";
                        }
                    }
                }
            }
        }
    }
}
