import { MaterialPalette, FilledButton, TonalButton, OutlineButton, Icon, ScrollView } from "@material";
import { OxidiumTheme, OxidiumIcons } from "../theme.slint";
import { StatBarItem, HeatmapDayItem, SubjectItem, UiStrings } from "../types.slint";

component KpiCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> subtext;
    in property <color> accent: MaterialPalette.primary;

    min_height: 86px;
    border_radius: 16px;
    background: MaterialPalette.surface_container_low;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        alignment: center;

        Text {
            text: root.label;
            font_size: 12px;
            font_weight: 500;
            color: MaterialPalette.on_surface_variant;
        }
        Text {
            text: root.value;
            font_family: OxidiumTheme.font_mono;
            font_size: 26px;
            font_weight: 700;
            color: root.accent;
        }
        if root.subtext != "" : Text {
            text: root.subtext;
            font_size: 11px;
            color: MaterialPalette.on_surface_variant;
            overflow: elide;
        }
    }
}

export component StatisticsView inherits Rectangle {
    in property <UiStrings> tr;
    in property <int> period_preset: 0; // 0=All, 1=CurrentMonth, 2=PrevMonth, 3=AcademicYear
    in property <string> overall_avg: "—";
    in property <string> total_grades_text: "0";
    in property <string> grade_counts_breakdown: "5: 0  •  4: 0  •  3: 0  •  2: 0  •  1: 0";
    in property <string> absences_text: "0";
    in property <string> excused_text: "0";
    in property <string> passes_text: "0";
    in property <string> attendance_note: "";
    in property <string> best_subject_text: "—";
    in property <string> lowest_subject_text: "—";
    in property <string> completed_tasks_text: "0";
    in property <string> overdue_tasks_text: "0";
    in property <string> active_tasks_text: "0";

    // Period comparison
    in property <string> comparison_summary: "";
    in property <bool> compare_enabled: false;

    // Real-data charts
    in property <image> line_chart_image;
    in property <image> donut_chart_image;
    in property <[StatBarItem]> grade_dist_bars;
    in property <[StatBarItem]> subject_avg_bars;
    in property <[StatBarItem]> attendance_bars;
    in property <[HeatmapDayItem]> heatmap_days;
    in property <[StatBarItem]> task_dynamics_bars;

    // Grade Forecast Calculator (never writes to journal)
    in property <[SubjectItem]> subjects;
    in_out property <int> forecast_subject_idx: 0;
    in_out property <string> forecast_add_grade: "5";
    in_out property <string> forecast_weight: "1";
    in_out property <string> forecast_target_avg: "4.5";
    in_out property <string> forecast_max_works: "5";
    in property <string> forecast_result_text: "Выберите параметры и нажмите «Рассчитать прогноз»";
    in property <string> forecast_target_result_text: "";

    callback select_period_preset(int);
    callback toggle_compare();
    callback run_forecast(int, string, string, string, string);

    background: transparent;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 16px;
            spacing: 16px;

            // Filter Toolbar
            Rectangle {
                border_radius: 16px;
                background: MaterialPalette.surface_container_low;
                border_width: 1px;
                border_color: OxidiumTheme.cell_border;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        for preset[idx] in ["Всё время", "Этот месяц", "Прошлый месяц", "Учебный год"] : Rectangle {
                            height: 34px;
                            border_radius: 17px;
                            background: root.period_preset == idx ? MaterialPalette.primary_container : MaterialPalette.surface;
                            border_width: 1px;
                            border_color: root.period_preset == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                            HorizontalLayout {
                                padding_left: 14px;
                                padding_right: 14px;
                                Text {
                                    text: preset;
                                    font_size: 12px;
                                    font_weight: root.period_preset == idx ? 600 : 400;
                                    color: root.period_preset == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                    vertical_alignment: center;
                                }
                            }
                            TouchArea {
                                mouse_cursor: pointer;
                                clicked => { root.select_period_preset(idx); }
                            }
                        }
                    }

                    TonalButton {
                        text: root.compare_enabled ? "Сравнение периодов: ВКЛ" : "Сравнить с прошлым месяцем";
                        clicked => { root.toggle_compare(); }
                    }
                }
            }

            // Period Comparison Banner
            if root.compare_enabled && root.comparison_summary != "" : Rectangle {
                border_radius: 14px;
                background: MaterialPalette.secondary_container;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Icon {
                        source: OxidiumIcons.analytics;
                        width: 20px;
                        height: 20px;
                        colorize: MaterialPalette.on_secondary_container;
                    }
                    Text {
                        text: root.comparison_summary;
                        font_size: 13px;
                        font_weight: 500;
                        color: MaterialPalette.on_secondary_container;
                        vertical_alignment: center;
                        wrap: word_wrap;
                    }
                }
            }

            // Primary KPI Cards Row
            HorizontalLayout {
                spacing: 12px;
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_overall_avg;
                    value: root.overall_avg;
                    subtext: root.grade_counts_breakdown;
                    accent: MaterialPalette.primary;
                }
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_total_grades;
                    value: root.total_grades_text;
                    subtext: "Зачётов: " + root.passes_text + " • Лучший: " + root.best_subject_text;
                    accent: OxidiumTheme.grade_5;
                }
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_absences;
                    value: root.absences_text;
                    subtext: "Уважительных: " + root.excused_text;
                    accent: OxidiumTheme.mark_absent;
                }
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_completed_tasks;
                    value: root.completed_tasks_text;
                    subtext: "Активных: " + root.active_tasks_text + " • Просрочено: " + root.overdue_tasks_text;
                    accent: OxidiumTheme.mark_excused;
                }
            }

            if root.attendance_note != "" : Text {
                text: "ℹ " + root.attendance_note + "  •  Требуют внимания: " + root.lowest_subject_text;
                font_size: 12px;
                color: MaterialPalette.on_surface_variant;
            }

            // Row 1 of Charts: Cumulative Average Dynamics + Grade Structure Donut
            HorizontalLayout {
                spacing: 14px;

                Rectangle {
                    horizontal_stretch: 2;
                    height: 248px;
                    border_radius: 18px;
                    background: MaterialPalette.surface_container_low;
                    border_width: 1px;
                    border_color: OxidiumTheme.cell_border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Динамика накопительного среднего балла";
                            font_size: 14px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        Image {
                            vertical_stretch: 1;
                            source: root.line_chart_image;
                            image_fit: fill;
                        }
                    }
                }

                Rectangle {
                    horizontal_stretch: 1;
                    height: 248px;
                    border_radius: 18px;
                    background: MaterialPalette.surface_container_low;
                    border_width: 1px;
                    border_color: OxidiumTheme.cell_border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Структура оценок";
                            font_size: 14px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        Rectangle {
                            vertical_stretch: 1;
                            Image {
                                width: 168px;
                                height: 168px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.donut_chart_image;
                                image_fit: contain;
                            }
                            Text {
                                text: root.overall_avg;
                                font_family: OxidiumTheme.font_mono;
                                font_size: 20px;
                                font_weight: 700;
                                color: MaterialPalette.on_surface;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                        }
                    }
                }
            }

            // Row 2 of Charts: Grade Distribution 1-5 + Subject Averages Horizontal Bars
            HorizontalLayout {
                spacing: 14px;

                Rectangle {
                    horizontal_stretch: 1;
                    min_height: 220px;
                    border_radius: 18px;
                    background: MaterialPalette.surface_container_low;
                    border_width: 1px;
                    border_color: OxidiumTheme.cell_border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "Распределение оценок 1–5";
                            font_size: 14px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        HorizontalLayout {
                            vertical_stretch: 1;
                            spacing: 14px;
                            alignment: space-around;
                            for bar in root.grade_dist_bars : VerticalLayout {
                                alignment: end;
                                spacing: 4px;
                                Text {
                                    text: bar.value_text;
                                    font_family: OxidiumTheme.font_mono;
                                    font_size: 11px;
                                    font_weight: 700;
                                    color: MaterialPalette.on_surface;
                                    horizontal_alignment: center;
                                }
                                Rectangle {
                                    width: 34px;
                                    height: max(8px, 110px * bar.ratio);
                                    border_top_left_radius: 8px;
                                    border_top_right_radius: 8px;
                                    background: bar.color;
                                }
                                Text {
                                    text: bar.label;
                                    font_family: OxidiumTheme.font_mono;
                                    font_size: 12px;
                                    font_weight: 600;
                                    color: MaterialPalette.on_surface_variant;
                                    horizontal_alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal_stretch: 1;
                    min_height: 220px;
                    border_radius: 18px;
                    background: MaterialPalette.surface_container_low;
                    border_width: 1px;
                    border_color: OxidiumTheme.cell_border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Средние баллы по предметам";
                            font_size: 14px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        if root.subject_avg_bars.length == 0 : Text {
                            text: "Нет данных об оценках за выбранный период.";
                            font_size: 12px;
                            color: MaterialPalette.on_surface_variant;
                        }
                        for sb in root.subject_avg_bars : VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: sb.label;
                                    font_size: 12px;
                                    color: MaterialPalette.on_surface;
                                    overflow: elide;
                                }
                                Text {
                                    text: sb.value_text + (sb.extra_text != "" ? " (" + sb.extra_text + ")" : "");
                                    font_family: OxidiumTheme.font_mono;
                                    font_size: 12px;
                                    font_weight: 700;
                                    color: sb.below_target ? OxidiumTheme.warning_color : MaterialPalette.primary;
                                }
                            }
                            Rectangle {
                                height: 8px;
                                border_radius: 4px;
                                background: MaterialPalette.surface_container_highest;
                                Rectangle {
                                    x: 0px;
                                    width: parent.width * clamp(sb.ratio, 0.0, 1.0);
                                    height: 100%;
                                    border_radius: 4px;
                                    background: sb.color;
                                }
                            }
                        }
                    }
                }
            }

            // Row 3: Attendance + Activity Heatmap + Task Dynamics
            HorizontalLayout {
                spacing: 14px;

                Rectangle {
                    horizontal_stretch: 1;
                    min_height: 180px;
                    border_radius: 18px;
                    background: MaterialPalette.surface_container_low;
                    border_width: 1px;
                    border_color: OxidiumTheme.cell_border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Посещаемость (пропуски по предметам)";
                            font_size: 14px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        if root.attendance_bars.length == 0 : Text {
                            text: "Пропуски не зарегистрированы.";
                            font_size: 12px;
                            color: MaterialPalette.on_surface_variant;
                        }
                        for ab in root.attendance_bars : HorizontalLayout {
                            spacing: 8px;
                            Text {
                                width: 120px;
                                text: ab.label;
                                font_size: 12px;
                                color: MaterialPalette.on_surface;
                                overflow: elide;
                                vertical_alignment: center;
                            }
                            Rectangle {
                                horizontal_stretch: 1;
                                height: 10px;
                                y: (parent.height - self.height) / 2;
                                border_radius: 5px;
                                background: MaterialPalette.surface_container_highest;
                                Rectangle {
                                    x: 0px;
                                    width: parent.width * clamp(ab.ratio, 0.05, 1.0);
                                    height: 100%;
                                    border_radius: 5px;
                                    background: OxidiumTheme.mark_absent;
                                }
                            }
                            Text {
                                text: ab.value_text;
                                font_family: OxidiumTheme.font_mono;
                                font_size: 11px;
                                color: MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal_stretch: 1;
                    min_height: 180px;
                    border_radius: 18px;
                    background: MaterialPalette.surface_container_low;
                    border_width: 1px;
                    border_color: OxidiumTheme.cell_border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Учебная активность (последние 35 дней)";
                            font_size: 14px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            for h in root.heatmap_days : Rectangle {
                                width: 14px;
                                height: 22px;
                                border_radius: 4px;
                                background: h.level == 0 ? MaterialPalette.surface_container_highest
                                    : h.level == 1 ? MaterialPalette.primary.with_alpha(30%)
                                    : h.level == 2 ? MaterialPalette.primary.with_alpha(55%)
                                    : h.level == 3 ? MaterialPalette.primary.with_alpha(80%)
                                    : MaterialPalette.primary;
                            }
                        }
                        Text {
                            text: "Динамика выполнения задач по периодам";
                            font_size: 12px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface_variant;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for td in root.task_dynamics_bars : Rectangle {
                                height: 26px;
                                border_radius: 8px;
                                background: MaterialPalette.primary_container;
                                HorizontalLayout {
                                    padding_left: 8px;
                                    padding_right: 8px;
                                    Text {
                                        text: td.label + ": " + td.value_text;
                                        font_family: OxidiumTheme.font_mono;
                                        font_size: 11px;
                                        color: MaterialPalette.on_primary_container;
                                        vertical_alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ===== GRADE FORECAST CALCULATOR =====
            Rectangle {
                border_radius: 20px;
                background: MaterialPalette.surface_container_low;
                border_width: 1px;
                border_color: MaterialPalette.primary.with_alpha(45%);

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Калькулятор успеваемости и прогнозирования оценок";
                            font_size: 16px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        Rectangle {
                            height: 26px;
                            border_radius: 13px;
                            background: MaterialPalette.tertiary_container;
                            HorizontalLayout {
                                padding_left: 12px;
                                padding_right: 12px;
                                Text {
                                    text: root.tr.stats_forecast_badge;
                                    font_size: 11px;
                                    font_weight: 600;
                                    color: MaterialPalette.on_tertiary_container;
                                    vertical_alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            width: 110px;
                            spacing: 4px;
                            Text { text: "Оценка (1–5)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 36px;
                                border_radius: 8px;
                                background: MaterialPalette.surface;
                                border_width: 1px;
                                border_color: MaterialPalette.outline_variant;
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    vertical_alignment: center;
                                    text <=> root.forecast_add_grade;
                                    font_family: OxidiumTheme.font_mono;
                                    color: MaterialPalette.on_surface;
                                }
                            }
                        }
                        VerticalLayout {
                            width: 100px;
                            spacing: 4px;
                            Text { text: "Вес работы"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 36px;
                                border_radius: 8px;
                                background: MaterialPalette.surface;
                                border_width: 1px;
                                border_color: MaterialPalette.outline_variant;
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    vertical_alignment: center;
                                    text <=> root.forecast_weight;
                                    font_family: OxidiumTheme.font_mono;
                                    color: MaterialPalette.on_surface;
                                }
                            }
                        }
                        VerticalLayout {
                            width: 120px;
                            spacing: 4px;
                            Text { text: "Целевой балл"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 36px;
                                border_radius: 8px;
                                background: MaterialPalette.surface;
                                border_width: 1px;
                                border_color: MaterialPalette.outline_variant;
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    vertical_alignment: center;
                                    text <=> root.forecast_target_avg;
                                    font_family: OxidiumTheme.font_mono;
                                    color: MaterialPalette.on_surface;
                                }
                            }
                        }
                        VerticalLayout {
                            width: 120px;
                            spacing: 4px;
                            Text { text: "Макс. работ"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 36px;
                                border_radius: 8px;
                                background: MaterialPalette.surface;
                                border_width: 1px;
                                border_color: MaterialPalette.outline_variant;
                                TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    vertical_alignment: center;
                                    text <=> root.forecast_max_works;
                                    font_family: OxidiumTheme.font_mono;
                                    color: MaterialPalette.on_surface;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            FilledButton {
                                text: "Рассчитать прогноз";
                                clicked => {
                                    root.run_forecast(
                                        root.forecast_subject_idx,
                                        root.forecast_add_grade,
                                        root.forecast_weight,
                                        root.forecast_target_avg,
                                        root.forecast_max_works,
                                    );
                                }
                            }
                        }
                    }

                    // Subject selector chips for forecast
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 28px;
                            border_radius: 14px;
                            background: root.forecast_subject_idx == 0 ? MaterialPalette.primary_container : MaterialPalette.surface;
                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                Text {
                                    text: "Все предметы";
                                    font_size: 11px;
                                    color: root.forecast_subject_idx == 0 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                    vertical_alignment: center;
                                }
                            }
                            TouchArea {
                                mouse_cursor: pointer;
                                clicked => { root.forecast_subject_idx = 0; }
                            }
                        }
                        for subj[s_idx] in root.subjects : Rectangle {
                            height: 28px;
                            border_radius: 14px;
                            background: root.forecast_subject_idx == (s_idx + 1) ? MaterialPalette.primary_container : MaterialPalette.surface;
                            HorizontalLayout {
                                padding_left: 10px;
                                padding_right: 10px;
                                Text {
                                    text: subj.short_name != "" ? subj.short_name : subj.name;
                                    font_size: 11px;
                                    color: root.forecast_subject_idx == (s_idx + 1) ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                                    vertical_alignment: center;
                                }
                            }
                            TouchArea {
                                mouse_cursor: pointer;
                                clicked => { root.forecast_subject_idx = s_idx + 1; }
                            }
                        }
                    }

                    Rectangle {
                        border_radius: 12px;
                        background: MaterialPalette.surface_container;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text {
                                text: root.forecast_result_text;
                                font_family: OxidiumTheme.font_mono;
                                font_size: 13px;
                                font_weight: 600;
                                color: MaterialPalette.on_surface;
                                wrap: word_wrap;
                            }
                            if root.forecast_target_result_text != "" : Text {
                                text: root.forecast_target_result_text;
                                font_size: 12px;
                                color: MaterialPalette.primary;
                                wrap: word_wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
