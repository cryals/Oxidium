import { MaterialPalette, FilledButton, TonalButton, OutlineButton, Icon, ScrollView } from "@material";
import { OxidiumTheme, OxidiumMotion, OxidiumTooltipState, OxidiumIcons } from "../theme.slint";
import { StatBarItem, TrendPointItem, HeatmapWeekRow, SubjectItem, UiStrings } from "../types.slint";

component KpiCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> subtext;
    in property <image> icon;
    in property <color> icon_color: MaterialPalette.primary;
    in property <color> value_color: MaterialPalette.on_surface;

    preferred_width: 0px;
    min_height: 110px;
    border_radius: kpi_ta.has_hover ? 24px : 20px;
    background: kpi_ta.has_hover ? MaterialPalette.surface_container_high : MaterialPalette.surface_container;
    border_width: 1px;
    border_color: kpi_ta.has_hover ? MaterialPalette.primary.with_alpha(45%) : OxidiumTheme.cell_border;
    animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
    animate background, border_color { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }

    kpi_ta := TouchArea {}

    VerticalLayout {
        padding: 18px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.label;
                font_family: OxidiumTheme.font_display;
                font_size: 13px;
                font_weight: 600;
                color: MaterialPalette.on_surface_variant;
                vertical_alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: 30px; height: 30px;
                border_radius: kpi_ta.has_hover ? 10px : 15px;
                background: root.icon_color.with_alpha(kpi_ta.has_hover ? 18% : 10%);
                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.icon;
                    width: 18px;
                    height: 18px;
                    colorize: root.icon_color;
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.value;
                font_family: OxidiumTheme.font_mono;
                font_size: 30px;
                font_weight: 700;
                color: root.value_color;
            }
            if root.subtext != "" : Text {
                preferred_width: 0px;
                text: root.subtext;
                font_size: 12px;
                color: MaterialPalette.on_surface_variant;
                overflow: elide;
            }
        }
    }
}

component SplineChartCard inherits Rectangle {
    in property <string> chart_y_top;
    in property <string> chart_y_mid;
    in property <string> chart_y_bot;
    in property <string> chart_x_start;
    in property <string> chart_x_mid;
    in property <string> chart_x_end;
    in property <string> chart_target_label;
    in property <string> chart_trend_delta;
    in property <bool> chart_trend_positive;
    in property <image> line_chart_image;
    in property <[TrendPointItem]> trend_points;
    in_out property <int> hovered_trend_idx: -1;
    in_out property <string> hovered_trend_text: "";
    in_out property <float> hovered_trend_x: 0.0;

    preferred_width: 0px;
    height: 292px;
    border_radius: 22px;
    background: MaterialPalette.surface_container_low;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal_stretch: 1;
                min_width: 0px;
                preferred_width: 0px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Динамика среднего балла";
                        font_family: OxidiumTheme.font_display;
                        font_size: 16px;
                        font_weight: 600;
                        color: MaterialPalette.on_surface;
                        vertical_alignment: center;
                        overflow: elide;
                    }
                    if root.chart_trend_delta != "" : Rectangle {
                        height: 22px; border_radius: 11px;
                        background: root.chart_trend_positive ? OxidiumTheme.grade_5_bg : OxidiumTheme.grade_2_brown_bg;
                        HorizontalLayout {
                            padding_left: 8px; padding_right: 8px;
                            Text {
                                text: root.chart_trend_delta;
                                font_family: OxidiumTheme.font_mono;
                                font_size: 10px; font_weight: 700;
                                color: root.chart_trend_positive ? OxidiumTheme.grade_5_fg : OxidiumTheme.grade_2_brown;
                                vertical_alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.hovered_trend_idx >= 0 ? root.hovered_trend_text : "Накопительный итог по оценкам (наведите на график для деталей)";
                    font_size: 12px;
                    color: root.hovered_trend_idx >= 0 ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                    overflow: elide;
                    animate color { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                }
            }
            Rectangle {
                horizontal_stretch: 0;
                height: 26px;
                border_radius: 13px;
                background: OxidiumTheme.grade_4_bg;
                HorizontalLayout {
                    padding_left: 10px;
                    padding_right: 10px;
                    Text {
                        text: root.chart_target_label;
                        font_family: OxidiumTheme.font_mono;
                        font_size: 11px;
                        font_weight: 600;
                        color: OxidiumTheme.grade_4_fg;
                        vertical_alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            vertical_stretch: 1;
            spacing: 8px;

            VerticalLayout {
                width: 32px;
                padding_top: 8px;
                padding_bottom: 8px;
                alignment: space-between;
                Text { text: root.chart_y_top; font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant; horizontal_alignment: right; }
                Text { text: root.chart_y_mid; font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant; horizontal_alignment: right; }
                Text { text: root.chart_y_bot; font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant; horizontal_alignment: right; }
            }

            Rectangle {
                horizontal_stretch: 1;
                vertical_stretch: 1;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.line_chart_image;
                    image_fit: fill;
                }

                // Live crosshair guideline with smooth damped tracking (no overshoot wobble)
                Rectangle {
                    x: clamp(parent.width * root.hovered_trend_x - 1px, 0px, parent.width - 2px);
                    y: 8px;
                    width: 2px;
                    height: parent.height - 16px;
                    border_radius: 1px;
                    background: MaterialPalette.primary.with_alpha(60%);
                    opacity: root.hovered_trend_idx >= 0 ? 1.0 : 0.0;
                    animate x { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                    animate opacity { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    for pt[p_idx] in root.trend_points : Rectangle {
                        horizontal_stretch: 1;
                        background: transparent;
                        pt_ta := TouchArea {
                            mouse_cursor: pointer;
                            changed has_hover => {
                                if (self.has_hover) {
                                    root.hovered_trend_idx = p_idx;
                                    root.hovered_trend_x = pt.x_ratio;
                                    root.hovered_trend_text = pt.full_date + "  ·  Средний: " + pt.avg_text + "  (" + pt.grades_count + " оц.)";
                                } else if (root.hovered_trend_idx == p_idx) {
                                    root.hovered_trend_idx = -1;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding_left: 40px;
            padding_right: 8px;
            alignment: space-between;
            Text { text: root.chart_x_start; font_family: OxidiumTheme.font_mono; font_size: 10px; color: MaterialPalette.on_surface_variant; }
            Text { text: root.chart_x_mid; font_family: OxidiumTheme.font_mono; font_size: 10px; color: MaterialPalette.on_surface_variant; }
            Text { text: root.chart_x_end; font_family: OxidiumTheme.font_mono; font_size: 10px; color: MaterialPalette.on_surface_variant; }
        }
    }
}

component GradeDistCard inherits Rectangle {
    in property <string> total_grades_text;
    in property <string> overall_avg;
    in property <[StatBarItem]> grade_dist_bars;

    preferred_width: 0px;
    height: 292px;
    border_radius: 22px;
    background: MaterialPalette.surface_container_low;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: space-between;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Распределение оценок";
                font_family: OxidiumTheme.font_display;
                font_size: 16px;
                font_weight: 600;
                color: MaterialPalette.on_surface;
            }
            Text {
                text: "Всего " + root.total_grades_text + " · Средний " + root.overall_avg;
                font_size: 12px;
                color: MaterialPalette.on_surface_variant;
            }
        }

        VerticalLayout {
            spacing: 12px;
            for bar in root.grade_dist_bars : HorizontalLayout {
                height: 22px;
                spacing: 10px;
                Text {
                    width: 16px;
                    text: bar.label;
                    font_family: OxidiumTheme.font_mono;
                    font_size: 13px;
                    font_weight: 700;
                    color: bar.color;
                    vertical_alignment: center;
                }
                VerticalLayout {
                    horizontal_stretch: 1;
                    alignment: center;
                    Rectangle {
                        height: 14px;
                        border_radius: 7px;
                        background: MaterialPalette.surface_container_highest;
                        clip: true;
                        Rectangle {
                            x: 0px;
                            width: bar.ratio > 0.0 ? max(12px, parent.width * clamp(bar.ratio, 0.0, 1.0)) : 0px;
                            height: 100%;
                            border_radius: 7px;
                            background: bar.color;
                            animate width { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                        }
                    }
                }
                Text {
                    width: 68px;
                    text: bar.value_text + (bar.percent_text != "" ? " · " + bar.percent_text : "");
                    font_family: OxidiumTheme.font_mono;
                    font_size: 11px;
                    font_weight: 600;
                    color: bar.value_text == "0" ? MaterialPalette.on_surface_variant : MaterialPalette.on_surface;
                    horizontal_alignment: right;
                    vertical_alignment: center;
                }
            }
        }
    }
}

component SubjectAvgCard inherits Rectangle {
    in property <bool> compact: false;
    in property <[StatBarItem]> subject_avg_bars;

    preferred_width: 0px;
    min_height: 248px;
    border_radius: 22px;
    background: MaterialPalette.surface_container_low;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            alignment: space-between;
            spacing: 8px;
            Text {
                text: "Средний балл по предметам";
                font_family: OxidiumTheme.font_display;
                font_size: 16px;
                font_weight: 600;
                color: MaterialPalette.on_surface;
                overflow: elide;
            }
            Text {
                text: "Цвет отражает успеваемость · засечка = цель";
                font_size: 11px;
                color: MaterialPalette.on_surface_variant;
                vertical_alignment: center;
                overflow: elide;
            }
        }

        if root.subject_avg_bars.length == 0 : Text {
            text: "Нет данных об оценках за выбранный период.";
            font_size: 13px;
            color: MaterialPalette.on_surface_variant;
        }

        for sb in root.subject_avg_bars : HorizontalLayout {
            height: 28px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 8px; height: 8px; border_radius: 4px; background: sb.dot_color; }
            }
            Text {
                width: root.compact ? 118px : 172px;
                text: sb.label;
                font_size: 13px;
                color: MaterialPalette.on_surface;
                overflow: elide;
                vertical_alignment: center;
            }
            VerticalLayout {
                horizontal_stretch: 1;
                alignment: center;
                Rectangle {
                    height: 12px;
                    border_radius: 6px;
                    background: MaterialPalette.surface_container_highest;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: sb.ratio > 0.0 ? max(8px, parent.width * clamp(sb.ratio, 0.0, 1.0)) : 0px;
                        height: 100%;
                        border_radius: 6px;
                        background: sb.color;
                        animate width { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                    }
                    if sb.target_ratio > 0.0 : Rectangle {
                        x: clamp(parent.width * sb.target_ratio - 1px, 0px, parent.width - 2px);
                        width: 2px;
                        height: 100%;
                        background: MaterialPalette.on_surface.with_alpha(65%);
                    }
                }
            }
            Text {
                width: 98px;
                text: sb.value_text + (sb.extra_text != "" ? " (" + sb.extra_text + ")" : "");
                font_family: OxidiumTheme.font_mono;
                font_size: 12px;
                font_weight: 700;
                color: sb.below_target ? OxidiumTheme.warning_color : MaterialPalette.on_surface;
                horizontal_alignment: right;
                vertical_alignment: center;
            }
        }
    }
}

component DonutChartCard inherits Rectangle {
    in property <string> overall_avg;
    in property <image> donut_chart_image;
    in property <[StatBarItem]> donut_legend;

    preferred_width: 0px;
    min_height: 248px;
    border_radius: 22px;
    background: MaterialPalette.surface_container_low;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;

        Text {
            text: "Структура оценок";
            font_family: OxidiumTheme.font_display;
            font_size: 16px;
            font_weight: 600;
            color: MaterialPalette.on_surface;
        }

        HorizontalLayout {
            vertical_stretch: 1;
            spacing: 14px;
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 158px;
                    height: 158px;
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.donut_chart_image;
                        image_fit: contain;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: root.overall_avg;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 22px;
                            font_weight: 700;
                            color: MaterialPalette.on_surface;
                            horizontal_alignment: center;
                        }
                        Text {
                            text: "средний";
                            font_size: 10px;
                            color: MaterialPalette.on_surface_variant;
                            horizontal_alignment: center;
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal_stretch: 1;
                alignment: center;
                spacing: 7px;
                for leg in root.donut_legend : HorizontalLayout {
                    height: 22px;
                    spacing: 6px;
                    alignment: space-between;
                    HorizontalLayout {
                        horizontal_stretch: 1;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 9px; height: 9px; border_radius: 4.5px; background: leg.color; }
                        }
                        Text { text: leg.label; font_size: 12px; font_weight: 500; color: MaterialPalette.on_surface; vertical_alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            width: 24px;
                            text: leg.value_text;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 11px;
                            font_weight: 700;
                            color: leg.value_text == "0" ? MaterialPalette.on_surface_variant : MaterialPalette.on_surface;
                            horizontal_alignment: right;
                            vertical_alignment: center;
                        }
                        Text {
                            width: 36px;
                            text: leg.percent_text;
                            font_family: OxidiumTheme.font_mono;
                            font_size: 11px;
                            font_weight: 500;
                            color: MaterialPalette.on_surface_variant;
                            horizontal_alignment: right;
                            vertical_alignment: center;
                        }
                    }
                }
            }
        }
    }
}

component AttendanceCard inherits Rectangle {
    in property <bool> compact: false;
    in property <[StatBarItem]> attendance_bars;

    preferred_width: 0px;
    min_height: 220px;
    border_radius: 22px;
    background: MaterialPalette.surface_container_low;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 9px;
        alignment: start;

        HorizontalLayout {
            alignment: space-between;
            spacing: 8px;
            Text {
                text: "Посещаемость (пропуски по предметам)";
                font_family: OxidiumTheme.font_display;
                font_size: 15px;
                font_weight: 600;
                color: MaterialPalette.on_surface;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border_radius: 4px; background: OxidiumTheme.absent_red; } }
                    Text { text: "Н/Б"; font_size: 10px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border_radius: 4px; background: OxidiumTheme.mark_excused; } }
                    Text { text: "Уваж."; font_size: 10px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                }
            }
        }

        if root.attendance_bars.length == 0 : Text {
            text: "Пропуски не зарегистрированы.";
            font_size: 12px;
            color: MaterialPalette.on_surface_variant;
        }

        for ab in root.attendance_bars : HorizontalLayout {
            height: 26px;
            spacing: 10px;
            Text {
                width: root.compact ? 104px : 138px;
                text: ab.label;
                font_size: 12px;
                color: MaterialPalette.on_surface;
                overflow: elide;
                vertical_alignment: center;
            }
            VerticalLayout {
                horizontal_stretch: 1;
                alignment: center;
                Rectangle {
                    height: 11px;
                    border_radius: 5.5px;
                    background: MaterialPalette.surface_container_highest;
                    clip: true;
                    HorizontalLayout {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        spacing: 2px;
                        alignment: start;
                        if ab.ratio > 0.0 : Rectangle {
                            width: max(8px, (parent.width - 2px) * clamp(ab.ratio, 0.0, 1.0));
                            height: 100%;
                            border_radius: 5.5px;
                            background: OxidiumTheme.absent_red;
                            animate width { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                        }
                        if ab.secondary_ratio > 0.0 : Rectangle {
                            width: max(8px, (parent.width - 2px) * clamp(ab.secondary_ratio, 0.0, 1.0));
                            height: 100%;
                            border_radius: 5.5px;
                            background: OxidiumTheme.mark_excused;
                            animate width { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                        }
                    }
                }
            }
            Text {
                width: 92px;
                text: ab.value_text;
                font_family: OxidiumTheme.font_mono;
                font_size: 11px;
                color: MaterialPalette.on_surface_variant;
                horizontal_alignment: right;
                vertical_alignment: center;
            }
        }
    }
}

component ActivityHeatmapCard inherits Rectangle {
    in property <[HeatmapWeekRow]> heatmap_weeks;
    in property <[string]> heatmap_weekdays;
    in property <string> heatmap_headline: "";
    in property <string> completed_tasks_text;
    in_out property <string> hovered_day_key;
    in_out property <string> hovered_day_title;
    in_out property <string> hovered_day_summary;
    in_out property <string> hovered_day_details;

    // Discrete GitHub-style tile geometry (fits full 53 weeks cleanly at desktop, scrolls cleanly if narrow)
    property <length> cell_sz: root.width >= 1120px ? 17px : (root.width >= 1000px ? 14px : (root.width >= 880px ? 13px : 12px));
    property <length> cell_gap: root.width >= 1000px ? 3px : 2px;
    property <length> col_step: root.cell_sz + root.cell_gap;
    property <length> grid_w: max(1, root.heatmap_weeks.length) * root.col_step - root.cell_gap;
    property <length> grid_h: 7 * root.cell_sz + 6 * root.cell_gap;

    preferred_width: 0px;
    border_radius: 22px;
    background: MaterialPalette.surface_container_low;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        alignment: start;

        // GitHub-style Summary Header + Category Legend
        HorizontalLayout {
            spacing: 12px;
            Text {
                horizontal_stretch: 1;
                min_width: 0px;
                preferred_width: 0px;
                text: root.heatmap_headline != "" ? root.heatmap_headline : "Учебная активность за последний год";
                font_family: OxidiumTheme.font_display;
                font_size: 15px;
                font_weight: 600;
                color: MaterialPalette.on_surface;
                overflow: elide;
                vertical_alignment: center;
            }
            HorizontalLayout {
                horizontal_stretch: 0;
                spacing: 8px;
                for hleg in [
                    { l: "5/4", c: OxidiumTheme.grade_5 },
                    { l: "3", c: OxidiumTheme.grade_3 },
                    { l: "2", c: OxidiumTheme.grade_2_brown },
                    { l: "Н/Б", c: OxidiumTheme.absent_red },
                    { l: "Ув.", c: OxidiumTheme.mark_excused },
                    { l: "Зад.", c: OxidiumTheme.task_accent },
                ] : HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout { alignment: center; Rectangle { width: 9px; height: 9px; border_radius: 2.5px; background: hleg.c; } }
                    Text { text: hleg.l; font_family: OxidiumTheme.font_mono; font_size: 10px; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                }
            }
        }

        // Framed 53-week x 7-day GitHub Contribution Graph
        Rectangle {
            border_radius: 14px;
            background: MaterialPalette.surface_container;
            border_width: 1px;
            border_color: OxidiumTheme.cell_border;
            clip: true;

            HorizontalLayout {
                padding_left: 14px;
                padding_right: 14px;
                padding_top: 12px;
                padding_bottom: 12px;
                spacing: 8px;

                // Sparse Weekday Axis (Mon / Wed / Fri)
                VerticalLayout {
                    horizontal_stretch: 0;
                    width: 22px;
                    padding_top: 18px;
                    spacing: root.cell_gap;
                    for wd in root.heatmap_weekdays : Text {
                        height: root.cell_sz;
                        text: wd;
                        font_size: 10px;
                        font_weight: 500;
                        color: MaterialPalette.on_surface_variant;
                        horizontal_alignment: left;
                        vertical_alignment: center;
                    }
                }

                // Horizontally scrollable viewport when window is narrow (< ~960px), centered when fits
                flk := Flickable {
                    horizontal_stretch: 1;
                    min_width: 0px;
                    preferred_width: 0px;
                    height: 18px + root.grid_h;
                    content_width: max(self.width, root.grid_w);
                    content_height: self.height;
                    interactive: root.grid_w > self.width;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: root.grid_w;
                        height: flk.height;
                        background: transparent;

                        // Month Headers anchored strictly above first week of each month
                        for wk in root.heatmap_weeks : Text {
                            visible: wk.month_label != "";
                            x: min(wk.col_index * root.col_step, max(0px, parent.width - 28px));
                            y: 0px;
                            width: 34px;
                            height: 16px;
                            text: wk.month_label;
                            font_size: 10px;
                            font_weight: 500;
                            color: MaterialPalette.on_surface_variant;
                            vertical_alignment: center;
                        }

                        // 53 columns x 7 rows of rounded GitHub contribution squares
                        HorizontalLayout {
                            x: 0px;
                            y: 18px;
                            width: root.grid_w;
                            height: root.grid_h;
                            spacing: root.cell_gap;

                            for wk in root.heatmap_weeks : VerticalLayout {
                                spacing: root.cell_gap;
                                for d in wk.days : cell := Rectangle {
                                    width: root.cell_sz;
                                    height: root.cell_sz;
                                    border_radius: 3px;
                                    background: d.slot_count <= 1 ? d.cell_bg : MaterialPalette.surface_container_highest;
                                    opacity: d.is_future ? 0.25 : 1.0;
                                    border_width: 1px;
                                    border_color: OxidiumTheme.dark_mode ? #FFFFFF10 : #1F23281A;
                                    clip: true;

                                    if d.slot_count == 2 : HorizontalLayout {
                                        spacing: 1px;
                                        Rectangle { horizontal_stretch: 1; background: d.slot_0_color; }
                                        Rectangle { horizontal_stretch: 1; background: d.slot_1_color; }
                                    }

                                    if d.slot_count == 3 : HorizontalLayout {
                                        spacing: 1px;
                                        Rectangle { horizontal_stretch: 1; background: d.slot_0_color; }
                                        VerticalLayout {
                                            horizontal_stretch: 1;
                                            spacing: 1px;
                                            Rectangle { vertical_stretch: 1; background: d.slot_1_color; }
                                            Rectangle { vertical_stretch: 1; background: d.slot_2_color; }
                                        }
                                    }

                                    if d.slot_count >= 4 : VerticalLayout {
                                        spacing: 1px;
                                        HorizontalLayout {
                                            vertical_stretch: 1; spacing: 1px;
                                            Rectangle { horizontal_stretch: 1; background: d.slot_0_color; }
                                            Rectangle { horizontal_stretch: 1; background: d.slot_1_color; }
                                        }
                                        HorizontalLayout {
                                            vertical_stretch: 1; spacing: 1px;
                                            Rectangle { horizontal_stretch: 1; background: d.slot_2_color; }
                                            Rectangle { horizontal_stretch: 1; background: d.slot_3_color; }
                                        }
                                    }

                                    if h_ta.has_hover || d.is_today : Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        border_radius: 3px;
                                        border_width: 1.5px;
                                        border_color: h_ta.has_hover ? MaterialPalette.on_surface : MaterialPalette.primary;
                                        background: transparent;
                                    }

                                    h_ta := TouchArea {
                                        mouse_cursor: pointer;
                                        changed has_hover => {
                                            if (self.has_hover) {
                                                root.hovered_day_key = d.date_iso;
                                                root.hovered_day_title = d.full_date_label;
                                                root.hovered_day_summary = d.summary_line;
                                                root.hovered_day_details = d.details_line;
                                                OxidiumTooltipState.text = d.tooltip;
                                                OxidiumTooltipState.anchor_x = cell.absolute-position.x;
                                                OxidiumTooltipState.anchor_y = cell.absolute-position.y;
                                                OxidiumTooltipState.anchor_w = cell.width;
                                                OxidiumTooltipState.anchor_h = cell.height;
                                                OxidiumTooltipState.prefer_above = true;
                                                OxidiumTooltipState.shown = true;
                                            } else {
                                                if (root.hovered_day_key == d.date_iso) {
                                                    root.hovered_day_key = "";
                                                }
                                                if (OxidiumTooltipState.text == d.tooltip) {
                                                    OxidiumTooltipState.shown = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Fixed-Height Single-Line Footer + Classic GitHub "Less [][][][][] More" Intensity Scale (ZERO layout shift)
        HorizontalLayout {
            height: 24px;
            vertical_stretch: 0;
            spacing: 12px;

            Text {
                horizontal_stretch: 1;
                min_width: 0px;
                preferred_width: 0px;
                text: root.hovered_day_key != ""
                    ? (root.hovered_day_title + " — " + root.hovered_day_summary + (root.hovered_day_details != "" ? " · " + root.hovered_day_details : ""))
                    : "Наведите на квадрат дня, чтобы увидеть оценки и пропуски · Выполнено задач: " + root.completed_tasks_text;
                font_size: 11px;
                color: root.hovered_day_key != "" ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant;
                overflow: elide;
                vertical_alignment: center;
            }

            HorizontalLayout {
                horizontal_stretch: 0;
                spacing: 4px;
                alignment: end;
                Text {
                    text: "Меньше";
                    font_size: 10px;
                    color: MaterialPalette.on_surface_variant;
                    vertical_alignment: center;
                }
                for lvl_col in [
                    OxidiumTheme.dark_mode ? #1E2026 : #EBEDF0,
                    OxidiumTheme.dark_mode ? #0E4429 : #9BE9A8,
                    OxidiumTheme.dark_mode ? #006D32 : #40C463,
                    OxidiumTheme.dark_mode ? #26A641 : #30A14E,
                    OxidiumTheme.dark_mode ? #39D353 : #216E39,
                ] : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 11px;
                        height: 11px;
                        border_radius: 2.5px;
                        background: lvl_col;
                        border_width: 1px;
                        border_color: OxidiumTheme.dark_mode ? #FFFFFF10 : #1F23281A;
                    }
                }
                Text {
                    text: "Больше";
                    font_size: 10px;
                    color: MaterialPalette.on_surface_variant;
                    vertical_alignment: center;
                }
            }
        }
    }
}

export component StatisticsView inherits Rectangle {
    in property <UiStrings> tr;
    in property <int> period_preset: 0; // 0=All, 1=CurrentMonth, 2=PrevMonth, 3=AcademicYear
    in property <string> overall_avg: "—";
    in property <string> total_grades_text: "0";
    in property <string> grade_counts_breakdown: "5: 0  ·  4: 0  ·  3: 0  ·  2: 0  ·  1: 0";
    in property <string> absences_text: "0";
    in property <string> excused_text: "0";
    in property <string> passes_text: "0";
    in property <string> attendance_note: "";
    in property <string> best_subject_text: "—";
    in property <string> lowest_subject_text: "—";
    in property <string> completed_tasks_text: "0";
    in property <string> overdue_tasks_text: "0";
    in property <string> active_tasks_text: "0";

    // Period comparison & chart scale labels
    in property <string> comparison_summary: "";
    in property <bool> compare_enabled: false;
    in property <string> chart_y_top: "5.0";
    in property <string> chart_y_mid: "4.0";
    in property <string> chart_y_bot: "3.0";
    in property <string> chart_x_start: "";
    in property <string> chart_x_mid: "";
    in property <string> chart_x_end: "";
    in property <string> chart_target_label: "Цель 4.50";
    in property <string> chart_trend_delta: "";
    in property <bool> chart_trend_positive: true;

    // Real-data charts & interactive hover state
    in property <image> line_chart_image;
    in property <image> donut_chart_image;
    in property <[TrendPointItem]> trend_points;
    in property <[StatBarItem]> grade_dist_bars;
    in property <[StatBarItem]> donut_legend;
    in property <[StatBarItem]> subject_avg_bars;
    in property <[StatBarItem]> attendance_bars;
    in property <[HeatmapWeekRow]> heatmap_weeks;
    in property <[string]> heatmap_weekdays: ["Пн", "", "Ср", "", "Пт", "", ""];
    in property <string> heatmap_headline: "";

    in_out property <int> hovered_trend_idx: -1;
    in_out property <string> hovered_trend_text: "";
    in_out property <float> hovered_trend_x: 0.0;

    in_out property <string> hovered_day_key: "";
    in_out property <string> hovered_day_title: "";
    in_out property <string> hovered_day_summary: "";
    in_out property <string> hovered_day_details: "";

    // Grade Forecast Calculator (never writes to journal)
    in property <[SubjectItem]> subjects;
    in_out property <int> forecast_subject_idx: 0;
    in_out property <string> forecast_add_grade: "5";
    in_out property <string> forecast_weight: "1";
    in_out property <string> forecast_target_avg: "4.5";
    in_out property <string> forecast_max_works: "5";
    in property <string> forecast_result_text: "Выберите параметры и нажмите «Рассчитать прогноз»";
    in property <string> forecast_target_result_text: "";

    property <bool> is_stacked: root.width < 980px;
    property <bool> is_compact_w: root.width < 820px;

    callback select_period_preset(int);
    callback toggle_compare();
    callback export_report();
    callback run_forecast(int, string, string, string, string);

    public function scroll_to_activity_qa(offset: length) {
        stats_scroll.viewport_y = offset;
    }

    public function reset_transient_state() {
        root.hovered_trend_idx = -1;
        root.hovered_trend_text = "";
        root.hovered_day_key = "";
        OxidiumTooltipState.shown = false;
        OxidiumTooltipState.prefer_above = false;
        root.forecast_subject_idx = 0;
    }

    background: transparent;

    stats_scroll := ScrollView {
        width: 100%;
        height: 100%;
        viewport_width: self.visible_width;
        viewport_height: max(self.visible_height, stats_body.preferred_height);

        stats_body := VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.visible_width;
            padding: root.is_compact_w ? 12px : 18px;
            spacing: 16px;
            alignment: start;

            // Adaptive Analytics Toolbar (1-row wide, 2-row narrow)
            if root.width >= 920px : HorizontalLayout {
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    for preset[idx] in ["Всё время", "Этот месяц", "Прошлый месяц", "Учебный год"] : Rectangle {
                        height: 36px;
                        border_radius: root.period_preset == idx ? 11px : 18px;
                        background: root.period_preset == idx ? MaterialPalette.secondary_container
                            : pre_ta.has_hover ? MaterialPalette.surface_container_high : MaterialPalette.surface_container_low;
                        border_width: 1px;
                        border_color: root.period_preset == idx ? transparent : OxidiumTheme.cell_border;
                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            Text {
                                text: preset;
                                font_size: 12px;
                                font_weight: root.period_preset == idx ? 600 : 500;
                                color: root.period_preset == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                        }
                        pre_ta := TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.hovered_trend_idx = -1;
                                root.hovered_day_key = "";
                                root.select_period_preset(idx);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    OutlineButton {
                        text: root.compare_enabled ? "Сравнение: ВКЛ" : "Сравнить периоды";
                        height: 38px;
                        clicked => { root.toggle_compare(); }
                    }
                    TonalButton {
                        text: "Экспорт отчёта";
                        height: 38px;
                        icon: OxidiumIcons.download;
                        clicked => { root.export_report(); }
                    }
                }
            }

            if root.width < 920px : VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 6px;
                    for preset[idx] in ["Всё время", "Этот месяц", "Прошлый месяц", "Учебный год"] : Rectangle {
                        height: 34px;
                        border_radius: root.period_preset == idx ? 10px : 17px;
                        background: root.period_preset == idx ? MaterialPalette.secondary_container
                            : pren_ta.has_hover ? MaterialPalette.surface_container_high : MaterialPalette.surface_container_low;
                        border_width: 1px;
                        border_color: root.period_preset == idx ? transparent : OxidiumTheme.cell_border;
                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                        HorizontalLayout {
                            padding_left: 12px;
                            padding_right: 12px;
                            Text {
                                text: preset;
                                font_size: 12px;
                                font_weight: root.period_preset == idx ? 600 : 500;
                                color: root.period_preset == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                        }
                        pren_ta := TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.hovered_trend_idx = -1;
                                root.hovered_day_key = "";
                                root.select_period_preset(idx);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    OutlineButton {
                        text: root.compare_enabled ? "Сравнение: ВКЛ" : "Сравнить периоды";
                        height: 36px;
                        clicked => { root.toggle_compare(); }
                    }
                    TonalButton {
                        text: "Экспорт отчёта";
                        height: 36px;
                        icon: OxidiumIcons.download;
                        clicked => { root.export_report(); }
                    }
                }
            }

            // Period Comparison Banner
            if root.compare_enabled && root.comparison_summary != "" : Rectangle {
                border_radius: 16px;
                background: MaterialPalette.secondary_container;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: OxidiumIcons.analytics;
                            width: 20px;
                            height: 20px;
                            colorize: MaterialPalette.on_secondary_container;
                        }
                    }
                    Text {
                        text: root.comparison_summary;
                        font_size: 13px;
                        font_weight: 500;
                        color: MaterialPalette.on_secondary_container;
                        vertical_alignment: center;
                        wrap: word_wrap;
                    }
                }
            }

            // 4 KPI Metric Cards: 1x4 wide, 2x2 narrow
            if !root.is_stacked : HorizontalLayout {
                spacing: 14px;
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_overall_avg;
                    value: root.overall_avg;
                    subtext: root.grade_counts_breakdown;
                    icon: OxidiumIcons.school;
                    icon_color: MaterialPalette.primary;
                }
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_total_grades;
                    value: root.total_grades_text;
                    subtext: "Зачётов: " + root.passes_text + " · Лучший: " + root.best_subject_text;
                    icon: OxidiumIcons.check_box;
                    icon_color: OxidiumTheme.grade_5;
                }
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_absences;
                    value: root.absences_text;
                    subtext: "Уважительных: " + root.excused_text;
                    icon: OxidiumIcons.warning;
                    icon_color: OxidiumTheme.absent_red;
                }
                KpiCard {
                    horizontal_stretch: 1;
                    label: root.tr.stats_completed_tasks;
                    value: root.completed_tasks_text;
                    subtext: "Активных: " + root.active_tasks_text + " · Просрочено: " + root.overdue_tasks_text;
                    icon: OxidiumIcons.check;
                    icon_color: OxidiumTheme.grade_5;
                }
            }

            if root.is_stacked : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    KpiCard {
                        horizontal_stretch: 1;
                        label: root.tr.stats_overall_avg;
                        value: root.overall_avg;
                        subtext: root.grade_counts_breakdown;
                        icon: OxidiumIcons.school;
                        icon_color: MaterialPalette.primary;
                    }
                    KpiCard {
                        horizontal_stretch: 1;
                        label: root.tr.stats_total_grades;
                        value: root.total_grades_text;
                        subtext: "Зачётов: " + root.passes_text + " · Лучший: " + root.best_subject_text;
                        icon: OxidiumIcons.check_box;
                        icon_color: OxidiumTheme.grade_5;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    KpiCard {
                        horizontal_stretch: 1;
                        label: root.tr.stats_absences;
                        value: root.absences_text;
                        subtext: "Уважительных: " + root.excused_text;
                        icon: OxidiumIcons.warning;
                        icon_color: OxidiumTheme.absent_red;
                    }
                    KpiCard {
                        horizontal_stretch: 1;
                        label: root.tr.stats_completed_tasks;
                        value: root.completed_tasks_text;
                        subtext: "Активных: " + root.active_tasks_text + " · Просрочено: " + root.overdue_tasks_text;
                        icon: OxidiumIcons.check;
                        icon_color: OxidiumTheme.grade_5;
                    }
                }
            }

            if root.attendance_note != "" || root.lowest_subject_text != "" : Text {
                text: (root.attendance_note != "" ? root.attendance_note : "")
                    + (root.attendance_note != "" && root.lowest_subject_text != "" ? "  ·  " : "")
                    + (root.lowest_subject_text != "" ? "Требуют внимания: " + root.lowest_subject_text : "");
                font_size: 12px;
                color: MaterialPalette.on_surface_variant;
                wrap: word_wrap;
            }

            // ===== ROW 1: SMOOTH SPLINE DYNAMICS + GRADE DISTRIBUTION =====
            if !root.is_stacked : HorizontalLayout {
                spacing: 16px;
                SplineChartCard {
                    horizontal_stretch: 2;
                    chart_y_top: root.chart_y_top; chart_y_mid: root.chart_y_mid; chart_y_bot: root.chart_y_bot;
                    chart_x_start: root.chart_x_start; chart_x_mid: root.chart_x_mid; chart_x_end: root.chart_x_end;
                    chart_target_label: root.chart_target_label;
                    chart_trend_delta: root.chart_trend_delta;
                    chart_trend_positive: root.chart_trend_positive;
                    line_chart_image: root.line_chart_image;
                    trend_points: root.trend_points;
                    hovered_trend_idx <=> root.hovered_trend_idx;
                    hovered_trend_text <=> root.hovered_trend_text;
                    hovered_trend_x <=> root.hovered_trend_x;
                }
                GradeDistCard {
                    horizontal_stretch: 1;
                    total_grades_text: root.total_grades_text;
                    overall_avg: root.overall_avg;
                    grade_dist_bars: root.grade_dist_bars;
                }
            }

            if root.is_stacked : VerticalLayout {
                spacing: 14px;
                SplineChartCard {
                    chart_y_top: root.chart_y_top; chart_y_mid: root.chart_y_mid; chart_y_bot: root.chart_y_bot;
                    chart_x_start: root.chart_x_start; chart_x_mid: root.chart_x_mid; chart_x_end: root.chart_x_end;
                    chart_target_label: root.chart_target_label;
                    chart_trend_delta: root.chart_trend_delta;
                    chart_trend_positive: root.chart_trend_positive;
                    line_chart_image: root.line_chart_image;
                    trend_points: root.trend_points;
                    hovered_trend_idx <=> root.hovered_trend_idx;
                    hovered_trend_text <=> root.hovered_trend_text;
                    hovered_trend_x <=> root.hovered_trend_x;
                }
                GradeDistCard {
                    total_grades_text: root.total_grades_text;
                    overall_avg: root.overall_avg;
                    grade_dist_bars: root.grade_dist_bars;
                }
            }

            // ===== ROW 2: SUBJECT AVERAGES + ROUNDED DONUT WITH LEGEND =====
            if !root.is_stacked : HorizontalLayout {
                spacing: 16px;
                SubjectAvgCard {
                    horizontal_stretch: 2;
                    subject_avg_bars: root.subject_avg_bars;
                }
                DonutChartCard {
                    horizontal_stretch: 1;
                    overall_avg: root.overall_avg;
                    donut_chart_image: root.donut_chart_image;
                    donut_legend: root.donut_legend;
                }
            }

            if root.is_stacked : VerticalLayout {
                spacing: 14px;
                SubjectAvgCard {
                    compact: root.is_compact_w;
                    subject_avg_bars: root.subject_avg_bars;
                }
                DonutChartCard {
                    overall_avg: root.overall_avg;
                    donut_chart_image: root.donut_chart_image;
                    donut_legend: root.donut_legend;
                }
            }

            // ===== ROW 3: FULL-WIDTH 53-WEEK GITHUB-STYLE ACTIVITY GRAPH =====
            ActivityHeatmapCard {
                heatmap_weeks: root.heatmap_weeks;
                heatmap_weekdays: root.heatmap_weekdays;
                heatmap_headline: root.heatmap_headline;
                completed_tasks_text: root.completed_tasks_text;
                hovered_day_key <=> root.hovered_day_key;
                hovered_day_title <=> root.hovered_day_title;
                hovered_day_summary <=> root.hovered_day_summary;
                hovered_day_details <=> root.hovered_day_details;
            }

            // ===== ROW 4: FULL-WIDTH ATTENDANCE BARS =====
            AttendanceCard {
                compact: root.is_compact_w;
                attendance_bars: root.attendance_bars;
            }

            // ===== ROW 5: GRADE FORECAST CALCULATOR =====
            Rectangle {
                border_radius: 22px;
                background: MaterialPalette.surface_container_low;
                border_width: 1px;
                border_color: MaterialPalette.primary.with_alpha(45%);

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 8px;
                        Text {
                            horizontal_stretch: 1;
                            text: "Калькулятор успеваемости и прогнозирования оценок";
                            font_family: OxidiumTheme.font_display;
                            font_size: 16px;
                            font_weight: 600;
                            color: MaterialPalette.on_surface;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 26px;
                            border_radius: 13px;
                            background: MaterialPalette.tertiary_container;
                            HorizontalLayout {
                                padding_left: 12px;
                                padding_right: 12px;
                                Text {
                                    text: root.tr.stats_forecast_badge;
                                    font_size: 11px;
                                    font_weight: 600;
                                    color: MaterialPalette.on_tertiary_container;
                                    vertical_alignment: center;
                                }
                            }
                        }
                    }

                    if root.width >= 780px : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            width: 116px;
                            spacing: 4px;
                            Text { text: "Оценка (1–5)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_add_grade; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                            }
                        }
                        VerticalLayout {
                            width: 104px;
                            spacing: 4px;
                            Text { text: "Вес работы"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_weight; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                            }
                        }
                        VerticalLayout {
                            width: 120px;
                            spacing: 4px;
                            Text { text: "Целевой балл"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_target_avg; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                            }
                        }
                        VerticalLayout {
                            width: 114px;
                            spacing: 4px;
                            Text { text: "Макс. работ"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            Rectangle {
                                height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_max_works; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            FilledButton {
                                text: "Рассчитать прогноз";
                                height: 40px;
                                clicked => {
                                    root.run_forecast(
                                        root.forecast_subject_idx,
                                        root.forecast_add_grade,
                                        root.forecast_weight,
                                        root.forecast_target_avg,
                                        root.forecast_max_works,
                                    );
                                }
                            }
                        }
                    }

                    if root.width < 780px : VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal_stretch: 1;
                                spacing: 4px;
                                Text { text: "Оценка (1–5)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                                Rectangle {
                                    height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_add_grade; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                                }
                            }
                            VerticalLayout {
                                horizontal_stretch: 1;
                                spacing: 4px;
                                Text { text: "Вес"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                                Rectangle {
                                    height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_weight; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                                }
                            }
                            VerticalLayout {
                                horizontal_stretch: 1;
                                spacing: 4px;
                                Text { text: "Целевой балл"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                                Rectangle {
                                    height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_target_avg; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                                }
                            }
                            VerticalLayout {
                                horizontal_stretch: 1;
                                spacing: 4px;
                                Text { text: "Макс. работ"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                                Rectangle {
                                    height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.forecast_max_works; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            FilledButton {
                                text: "Рассчитать прогноз";
                                height: 38px;
                                clicked => {
                                    root.run_forecast(
                                        root.forecast_subject_idx,
                                        root.forecast_add_grade,
                                        root.forecast_weight,
                                        root.forecast_target_avg,
                                        root.forecast_max_works,
                                    );
                                }
                            }
                        }
                    }

                    // Horizontal Scrollable Subject Selector Pills
                    ScrollView {
                        height: 36px;
                        viewport_width: max(self.visible_width, chips_row.preferred_width);
                        chips_row := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            spacing: 6px;
                            alignment: start;
                            Rectangle {
                                height: 30px;
                                border_radius: root.forecast_subject_idx == 0 ? 9px : 15px;
                                background: root.forecast_subject_idx == 0 ? MaterialPalette.primary_container : MaterialPalette.surface;
                                border_width: 1px; border_color: root.forecast_subject_idx == 0 ? MaterialPalette.primary : OxidiumTheme.cell_border;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                HorizontalLayout {
                                    padding_left: 12px; padding_right: 12px;
                                    Text { text: "Все предметы"; font_size: 11px; font_weight: 600; color: root.forecast_subject_idx == 0 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant; vertical_alignment: center; }
                                }
                                TouchArea { mouse_cursor: pointer; clicked => { root.forecast_subject_idx = 0; } }
                            }
                            for subj[s_idx] in root.subjects : Rectangle {
                                height: 30px;
                                border_radius: root.forecast_subject_idx == (s_idx + 1) ? 9px : 15px;
                                background: root.forecast_subject_idx == (s_idx + 1) ? MaterialPalette.primary_container : MaterialPalette.surface;
                                border_width: 1px; border_color: root.forecast_subject_idx == (s_idx + 1) ? MaterialPalette.primary : OxidiumTheme.cell_border;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                HorizontalLayout {
                                    padding_left: 12px; padding_right: 12px;
                                    Text { text: subj.short_name != "" ? subj.short_name : subj.name; font_size: 11px; font_weight: 500; color: root.forecast_subject_idx == (s_idx + 1) ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant; vertical_alignment: center; }
                                }
                                TouchArea { mouse_cursor: pointer; clicked => { root.forecast_subject_idx = s_idx + 1; } }
                            }
                        }
                    }

                    Rectangle {
                        border_radius: 14px;
                        background: MaterialPalette.surface_container;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Text { text: root.forecast_result_text; font_family: OxidiumTheme.font_mono; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; wrap: word_wrap; }
                            if root.forecast_target_result_text != "" : Text { text: root.forecast_target_result_text; font_size: 12px; color: MaterialPalette.primary; wrap: word_wrap; }
                        }
                    }
                }
            }
        }
    }
}
