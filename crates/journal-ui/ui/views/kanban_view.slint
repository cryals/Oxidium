import { MaterialPalette, FilledButton, TonalButton, OutlineButton, Icon, ScrollView, Switch } from "@material";
import { OxidiumTheme, OxidiumMotion, OxidiumTooltipState, OxidiumIcons } from "../theme.slint";
import { OxidiumIconButton } from "../components.slint";
import { BoardItem, KanbanColumnModel, KanbanTaskCard, ChecklistRowItem, SubjectItem, UiStrings } from "../types.slint";

component KanbanMicroButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon_color: MaterialPalette.on_surface_variant;
    in property <string> hint_text;
    in_out property <string> hover_target;
    callback clicked();

    width: 30px;
    height: 30px;
    border_radius: mb_ta.pressed ? 8px : 15px;
    background: mb_ta.pressed ? MaterialPalette.on_surface.with_alpha(16%)
        : mb_ta.has_hover ? MaterialPalette.surface_container_highest : transparent;
    animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
    animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }

    Icon {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: mb_ta.has_hover ? MaterialPalette.primary : root.icon_color;
        animate colorize { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
    }

    mb_ta := TouchArea {
        mouse_cursor: pointer;
        clicked => {
            root.hover_target = "";
            OxidiumTooltipState.shown = false;
            root.clicked();
        }
        changed has_hover => {
            if (self.has_hover && root.hint_text != "") {
                root.hover_target = root.hint_text;
                OxidiumTooltipState.text = root.hint_text;
                OxidiumTooltipState.anchor_x = root.absolute-position.x;
                OxidiumTooltipState.anchor_y = root.absolute-position.y;
                OxidiumTooltipState.anchor_w = root.width;
                OxidiumTooltipState.anchor_h = root.height;
                OxidiumTooltipState.prefer_above = false;
                OxidiumTooltipState.shown = true;
            } else if (!self.has_hover) {
                if (root.hover_target == root.hint_text) {
                    root.hover_target = "";
                }
                if (OxidiumTooltipState.text == root.hint_text) {
                    OxidiumTooltipState.shown = false;
                }
            }
        }
    }
}

export component KanbanView inherits Rectangle {
    in property <UiStrings> tr;
    in property <[BoardItem]> boards;
    in property <string> active_board_id;
    in property <[KanbanColumnModel]> columns;
    in property <[SubjectItem]> subjects;
    in property <string> subject_filter_label: "";
    in_out property <string> filter_query: "";
    in_out property <int> filter_mode: 0; // 0=All, 1=Overdue, 2=HighPriority
    in_out property <bool> hand_mode: false;
    in_out property <string> hover_hint: "";
    property <bool> narrow_toolbar: root.width < 1140px;
    property <length> pan_start_x: 0px;
    property <length> pan_start_vx: 0px;
    property <bool> is_panning: false;

    // Pointer Drag-and-Drop state
    in_out property <bool> dragging_task: false;
    in_out property <string> drag_task_id: "";
    in_out property <string> drag_task_title: "";
    in_out property <string> drag_source_col_id: "";

    // Quick create task/column/board dialog states
    in_out property <bool> new_task_open: false;
    in_out property <string> new_task_col_id: "";
    in_out property <string> new_task_title: "";
    in_out property <string> new_task_desc: "";
    in_out property <string> new_task_deadline: "";
    in_out property <int> new_task_priority: 2;
    in_out property <int> new_task_subject_idx: 0;
    in_out property <string> new_task_tags: "";

    in_out property <bool> new_column_open: false;
    in_out property <string> new_column_name: "";
    in_out property <string> new_column_wip: "";
    in_out property <bool> new_column_done: false;

    in_out property <bool> new_board_open: false;
    in_out property <string> new_board_name: "";

    // Task detail drawer state
    in_out property <bool> detail_open: false;
    in_out property <string> detail_task_id: "";
    in_out property <string> detail_title: "";
    in_out property <string> detail_desc: "";
    in_out property <string> detail_notes: "";
    in_out property <string> detail_deadline: "";
    in_out property <int> detail_priority: 0;
    in_out property <string> detail_tags_text: "";
    in_out property <string> detail_new_checklist: "";
    in_out property <string> detail_new_tag: "";
    in property <[ChecklistRowItem]> detail_checklist;

    callback select_board(string);
    callback create_board(string);
    callback create_column(string, string, bool);
    callback move_column_delta(string, int);
    callback toggle_column_collapse(string);
    callback create_task(string, string, string, string, int, int, string);
    callback open_task_detail(string);
    callback save_task_detail(string, string, string, string, string, int);
    callback move_task_to_column(string, string);
    callback move_task_step(string, int); // task_id, -1 left / +1 right
    callback toggle_task_complete(string);
    callback duplicate_task(string);
    callback delete_task(string);
    callback add_checklist_item(string, string);
    callback toggle_checklist_item(string, bool);
    callback delete_checklist_item(string);
    callback add_tag_to_task(string, string);
    callback filter_changed(string, int);
    callback clear_subject_filter();

    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Kanban Header & Adaptive Board Switcher
        Rectangle {
            vertical_stretch: 0;
            height: root.narrow_toolbar ? 98px : 60px;
            border_radius: 16px;
            background: MaterialPalette.surface_container_low;
            border_width: 1px;
            border_color: OxidiumTheme.cell_border;

            if !root.narrow_toolbar : HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    for b in root.boards : Rectangle {
                        height: 36px;
                        border_radius: b.id == root.active_board_id ? 11px : 18px;
                        background: b.id == root.active_board_id ? MaterialPalette.primary_container : MaterialPalette.surface;
                        border_width: 1px;
                        border_color: b.id == root.active_board_id ? MaterialPalette.primary : MaterialPalette.outline_variant;
                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                        HorizontalLayout {
                            padding_left: 14px;
                            padding_right: 14px;
                            Text {
                                text: b.name;
                                font_size: 13px;
                                font_weight: b.id == root.active_board_id ? 600 : 400;
                                color: b.id == root.active_board_id ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                vertical_alignment: center;
                            }
                        }
                        TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.hover_hint = "";
                                root.select_board(b.id);
                            }
                        }
                    }

                    OutlineButton {
                        text: root.tr.kanban_new_board;
                        height: 36px;
                        clicked => {
                            root.new_board_name = "";
                            root.new_board_open = true;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    // Cursor / Hand (Pan) Mode Toggle (Stitch D01)
                    Rectangle {
                        height: 36px;
                        border_radius: 18px;
                        background: MaterialPalette.surface_container;
                        HorizontalLayout {
                            padding: 3px;
                            spacing: 2px;
                            Rectangle {
                                width: 30px; height: 30px;
                                border_radius: !root.hand_mode ? 10px : 15px;
                                background: !root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                Icon {
                                    source: OxidiumIcons.cursor;
                                    width: 16px; height: 16px;
                                    colorize: !root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                }
                                TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = false; } }
                            }
                            Rectangle {
                                width: 30px; height: 30px;
                                border_radius: root.hand_mode ? 10px : 15px;
                                background: root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                Icon {
                                    source: OxidiumIcons.hand;
                                    width: 16px; height: 16px;
                                    colorize: root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                }
                                TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = true; root.dragging_task = false; } }
                            }
                        }
                    }

                    // Inline Live Task Search (Stitch D01)
                    Rectangle {
                        width: 146px;
                        height: 36px;
                        border_radius: 18px;
                        background: MaterialPalette.surface_container_high;
                        HorizontalLayout {
                            padding_left: 10px; padding_right: 10px; spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon { source: OxidiumIcons.search; width: 15px; height: 15px; colorize: MaterialPalette.on_surface_variant; }
                            }
                            TextInput {
                                horizontal_stretch: 1;
                                vertical_alignment: center;
                                text <=> root.filter_query;
                                font_size: 12px;
                                color: MaterialPalette.on_surface;
                                edited => { root.filter_changed(root.filter_query, root.filter_mode); }
                            }
                        }
                        if root.filter_query == "" : Text {
                            x: 32px;
                            y: 0px;
                            height: 100%;
                            text: "Поиск задач...";
                            font_size: 12px;
                            color: MaterialPalette.on_surface_variant;
                            vertical_alignment: center;
                        }
                    }

                    // Dismissible active subject filter pill when navigated from Journal
                    if root.subject_filter_label != "" : Rectangle {
                        height: 36px;
                        border_radius: 18px;
                        background: MaterialPalette.tertiary_container;
                        border_width: 1px;
                        border_color: MaterialPalette.primary.with_alpha(45%);
                        HorizontalLayout {
                            padding_left: 11px;
                            padding_right: 8px;
                            spacing: 6px;
                            Text {
                                text: "Предмет: " + root.subject_filter_label;
                                font_size: 11px;
                                font_weight: 600;
                                color: MaterialPalette.on_tertiary_container;
                                vertical_alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Icon { source: OxidiumIcons.close; width: 14px; height: 14px; colorize: MaterialPalette.on_tertiary_container; }
                            }
                        }
                        TouchArea {
                            mouse_cursor: pointer;
                            clicked => { root.clear_subject_filter(); }
                        }
                    }

                    // Filter mode chips
                    for fm[idx] in ["Все", "Просрочено", "Срочные"] : Rectangle {
                        height: 36px;
                        border_radius: root.filter_mode == idx ? 11px : 18px;
                        background: root.filter_mode == idx ? MaterialPalette.secondary_container : MaterialPalette.surface;
                        border_width: 1px;
                        border_color: root.filter_mode == idx ? transparent : MaterialPalette.outline_variant;
                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                        HorizontalLayout {
                            padding_left: 11px;
                            padding_right: 11px;
                            Text {
                                text: fm;
                                font_size: 11px;
                                font_weight: root.filter_mode == idx ? 600 : 500;
                                color: root.filter_mode == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                            }
                        }
                        TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.filter_mode = idx;
                                root.filter_changed(root.filter_query, idx);
                            }
                        }
                    }

                    OutlineButton {
                        text: root.tr.kanban_new_column;
                        height: 36px;
                        clicked => {
                            root.new_column_name = "";
                            root.new_column_wip = "";
                            root.new_column_done = false;
                            root.new_column_open = true;
                        }
                    }

                    FilledButton {
                        text: root.tr.kanban_new_task;
                        height: 36px;
                        icon: OxidiumIcons.add;
                        clicked => {
                            root.new_task_col_id = "";
                            root.new_task_title = "";
                            root.new_task_desc = "";
                            root.new_task_deadline = "";
                            root.new_task_tags = "";
                            root.new_task_open = true;
                        }
                    }
                }
            }

            if root.narrow_toolbar : VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        for b in root.boards : Rectangle {
                            height: 34px;
                            border_radius: b.id == root.active_board_id ? 10px : 17px;
                            background: b.id == root.active_board_id ? MaterialPalette.primary_container : MaterialPalette.surface;
                            border_width: 1px;
                            border_color: b.id == root.active_board_id ? MaterialPalette.primary : MaterialPalette.outline_variant;
                            animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                            animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                            HorizontalLayout {
                                padding_left: 12px; padding_right: 12px;
                                Text { text: b.name; font_size: 12px; font_weight: b.id == root.active_board_id ? 600 : 400; color: b.id == root.active_board_id ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; vertical_alignment: center; }
                            }
                            TouchArea { mouse_cursor: pointer; clicked => { root.hover_hint = ""; root.select_board(b.id); } }
                        }
                        OutlineButton {
                            text: root.tr.kanban_new_board;
                            height: 34px;
                            clicked => { root.new_board_name = ""; root.new_board_open = true; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        OutlineButton {
                            text: root.tr.kanban_new_column;
                            height: 34px;
                            clicked => {
                                root.new_column_name = "";
                                root.new_column_wip = "";
                                root.new_column_done = false;
                                root.new_column_open = true;
                            }
                        }
                        FilledButton {
                            text: root.tr.kanban_new_task;
                            height: 34px;
                            icon: OxidiumIcons.add;
                            clicked => {
                                root.new_task_col_id = "";
                                root.new_task_title = "";
                                root.new_task_desc = "";
                                root.new_task_deadline = "";
                                root.new_task_tags = "";
                                root.new_task_open = true;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 34px;
                            border_radius: 17px;
                            background: MaterialPalette.surface_container;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 2px;
                                Rectangle {
                                    width: 28px; height: 28px;
                                    border_radius: !root.hand_mode ? 9px : 14px;
                                    background: !root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                    animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                    animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                    Icon { source: OxidiumIcons.cursor; width: 15px; height: 15px; colorize: !root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant; }
                                    TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = false; } }
                                }
                                Rectangle {
                                    width: 28px; height: 28px;
                                    border_radius: root.hand_mode ? 9px : 14px;
                                    background: root.hand_mode ? MaterialPalette.secondary_container : transparent;
                                    animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                    animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                    Icon { source: OxidiumIcons.hand; width: 15px; height: 15px; colorize: root.hand_mode ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant; }
                                    TouchArea { mouse_cursor: pointer; clicked => { root.hand_mode = true; root.dragging_task = false; } }
                                }
                            }
                        }

                        Rectangle {
                            width: 140px;
                            height: 34px;
                            border_radius: 17px;
                            background: MaterialPalette.surface_container_high;
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 10px; spacing: 6px;
                                VerticalLayout { alignment: center; Icon { source: OxidiumIcons.search; width: 14px; height: 14px; colorize: MaterialPalette.on_surface_variant; } }
                                TextInput {
                                    horizontal_stretch: 1; vertical_alignment: center;
                                    text <=> root.filter_query; font_size: 12px; color: MaterialPalette.on_surface;
                                    edited => { root.filter_changed(root.filter_query, root.filter_mode); }
                                }
                            }
                            if root.filter_query == "" : Text {
                                x: 30px; y: 0px; height: 100%;
                                text: "Поиск задач..."; font_size: 12px; color: MaterialPalette.on_surface_variant; vertical_alignment: center;
                            }
                        }

                        if root.subject_filter_label != "" : Rectangle {
                            height: 34px;
                            border_radius: 17px;
                            background: MaterialPalette.tertiary_container;
                            border_width: 1px; border_color: MaterialPalette.primary.with_alpha(45%);
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 8px; spacing: 5px;
                                Text { text: root.subject_filter_label; font_size: 11px; font_weight: 600; color: MaterialPalette.on_tertiary_container; vertical_alignment: center; overflow: elide; }
                                VerticalLayout { alignment: center; Icon { source: OxidiumIcons.close; width: 14px; height: 14px; colorize: MaterialPalette.on_tertiary_container; } }
                            }
                            TouchArea { mouse_cursor: pointer; clicked => { root.clear_subject_filter(); } }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        for fm[idx] in ["Все", "Просрочено", "Срочные"] : Rectangle {
                            height: 34px;
                            border_radius: root.filter_mode == idx ? 10px : 17px;
                            background: root.filter_mode == idx ? MaterialPalette.secondary_container : MaterialPalette.surface;
                            border_width: 1px;
                            border_color: root.filter_mode == idx ? transparent : MaterialPalette.outline_variant;
                            animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                            animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 10px;
                                Text { text: fm; font_size: 11px; font_weight: root.filter_mode == idx ? 600 : 500; color: root.filter_mode == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant; vertical_alignment: center; }
                            }
                            TouchArea { mouse_cursor: pointer; clicked => { root.filter_mode = idx; root.filter_changed(root.filter_query, idx); } }
                        }
                    }
                }
            }
        }

        // Dragging Indicator Banner (click any column drop target to complete drag-and-drop)
        if root.dragging_task : Rectangle {
            vertical_stretch: 0;
            height: 40px;
            border_radius: 12px;
            background: MaterialPalette.primary_container;
            HorizontalLayout {
                padding_left: 14px;
                padding_right: 14px;
                alignment: space-between;
                Text {
                    text: "Перемещение задачи «" + root.drag_task_title + "» — нажмите на целевую колонку ниже";
                    font_size: 13px;
                    font_weight: 600;
                    color: MaterialPalette.on_primary_container;
                    vertical_alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    TonalButton {
                        text: "Отмена";
                        height: 30px;
                        clicked => { root.dragging_task = false; }
                    }
                }
            }
        }

        // Horizontal Columns Scroll Area (with optional Hand-Pan overlay)
        Rectangle {
            vertical_stretch: 1;

            kanban_scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport_width: max(root.columns.length * 328px + 24px, self.visible_width);

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    height: parent.visible_height;
                    spacing: 14px;
                    padding_bottom: 8px;
                    alignment: start;

                    for col[c_idx] in root.columns : Rectangle {
                        width: col.is_collapsed ? 64px : 314px;
                        vertical_stretch: 1;
                        border_radius: 20px;
                        background: MaterialPalette.surface_container;
                        border_width: root.dragging_task && col.id != root.drag_source_col_id ? 2px : 1px;
                        border_color: root.dragging_task && col.id != root.drag_source_col_id
                            ? MaterialPalette.primary
                            : col.over_wip ? OxidiumTheme.danger_color
                            : OxidiumTheme.cell_border;
                        animate width { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                        animate border_color { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        // Column Header
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 7px;
                                horizontal_stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border_radius: 5px;
                                        background: col.color;
                                    }
                                }
                                if !col.is_collapsed : Text {
                                    text: col.name;
                                    font_size: 14px;
                                    font_weight: 600;
                                    color: MaterialPalette.on_surface;
                                    vertical_alignment: center;
                                    overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 22px;
                                        min_width: 26px;
                                        border_radius: 11px;
                                        background: col.over_wip ? MaterialPalette.error_container : MaterialPalette.surface_container_highest;
                                        HorizontalLayout {
                                            padding_left: 7px;
                                            padding_right: 7px;
                                            alignment: center;
                                            Text {
                                                text: col.wip_limit > 0 ? col.task_count + "/" + col.wip_limit : col.task_count;
                                                font_family: OxidiumTheme.font_mono;
                                                font_size: 11px;
                                                font_weight: 700;
                                                color: col.over_wip ? MaterialPalette.on_error_container : MaterialPalette.on_surface_variant;
                                                horizontal_alignment: center;
                                                vertical_alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            if !col.is_collapsed : HorizontalLayout {
                                spacing: 2px;
                                KanbanMicroButton {
                                    icon: OxidiumIcons.chevron_left;
                                    hint_text: "Сдвинуть колонку влево";
                                    hover_target <=> root.hover_hint;
                                    clicked => { root.move_column_delta(col.id, -1); }
                                }
                                KanbanMicroButton {
                                    icon: OxidiumIcons.chevron_right;
                                    hint_text: "Сдвинуть колонку вправо";
                                    hover_target <=> root.hover_hint;
                                    clicked => { root.move_column_delta(col.id, 1); }
                                }
                                KanbanMicroButton {
                                    icon: OxidiumIcons.add;
                                    hint_text: "Добавить задачу в колонку";
                                    hover_target <=> root.hover_hint;
                                    clicked => {
                                        root.new_task_col_id = col.id;
                                        root.new_task_title = "";
                                        root.new_task_desc = "";
                                        root.new_task_deadline = "";
                                        root.new_task_tags = "";
                                        root.new_task_open = true;
                                    }
                                }
                            }
                        }

                        // Drop Zone button when dragging a task
                        if root.dragging_task && col.id != root.drag_source_col_id && !col.is_collapsed : Rectangle {
                            height: 36px;
                            border_radius: 10px;
                            background: MaterialPalette.primary.with_alpha(18%);
                            border_width: 1px;
                            border_color: MaterialPalette.primary;
                            Text {
                                text: "Переместить сюда";
                                font_size: 12px;
                                font_weight: 600;
                                color: MaterialPalette.primary;
                                horizontal_alignment: center;
                                vertical_alignment: center;
                            }
                            TouchArea {
                                mouse_cursor: pointer;
                                clicked => {
                                    root.dragging_task = false;
                                    root.move_task_to_column(root.drag_task_id, col.id);
                                }
                            }
                        }

                        // Column Task Cards (or crisp empty placeholder)
                        if !col.is_collapsed : ScrollView {
                            vertical_stretch: 1;
                            viewport_width: self.visible_width;
                            viewport_height: max(self.visible_height, col_cards_list.preferred_height);
                            col_cards_list := VerticalLayout {
                                x: 0px;
                                y: 0px;
                                width: parent.visible_width;
                                spacing: 8px;
                                alignment: start;

                                if col.tasks.length == 0 : Rectangle {
                                    height: 84px;
                                    border_radius: 14px;
                                    background: MaterialPalette.surface_container_low.with_alpha(55%);
                                    border_width: 1px;
                                    border_color: OxidiumTheme.cell_border;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        padding: 12px;
                                        Text {
                                            text: "Нет задач";
                                            font_size: 12px; font_weight: 600;
                                            color: MaterialPalette.on_surface_variant;
                                            horizontal_alignment: center;
                                        }
                                        Text {
                                            text: "Нажмите «+» сверху или перетащите карточку";
                                            font_size: 10px;
                                            color: MaterialPalette.on_surface_variant.with_alpha(75%);
                                            horizontal_alignment: center;
                                            wrap: word_wrap;
                                        }
                                    }
                                }

                                for task in col.tasks : Rectangle {
                                    border_radius: 16px;
                                    background: card_ta.has_hover ? MaterialPalette.surface_container_high : MaterialPalette.surface_container_low;
                                    border_width: 1px;
                                    border_color: task.is_overdue && !task.is_completed ? OxidiumTheme.danger_color
                                        : card_ta.has_hover ? MaterialPalette.primary.with_alpha(45%)
                                        : OxidiumTheme.cell_border;
                                    opacity: task.is_completed ? 0.78 : 1.0;
                                    animate background, border_color, opacity { duration: OxidiumTheme.anim_fast; easing: OxidiumMotion.ease_standard; }

                                    card_ta := TouchArea {}

                                    VerticalLayout {
                                        padding: OxidiumTheme.compact_mode ? 10px : 14px;
                                        spacing: 8px;

                                        // Top Metadata Row: Priority/Done Pill + Deadline + Drag Handle (Stitch D01)
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                if task.is_completed : Rectangle {
                                                    height: 22px; border_radius: 6px;
                                                    background: OxidiumTheme.grade_5_bg;
                                                    HorizontalLayout {
                                                        padding_left: 7px; padding_right: 7px; spacing: 4px;
                                                        VerticalLayout { alignment: center; Icon { source: OxidiumIcons.check; width: 12px; height: 12px; colorize: OxidiumTheme.grade_5_fg; } }
                                                        Text { text: "Выполнено"; font_size: 10px; font_weight: 600; color: OxidiumTheme.grade_5_fg; vertical_alignment: center; }
                                                    }
                                                }
                                                if !task.is_completed && task.priority_level > 0 : Rectangle {
                                                    height: 22px; border_radius: 6px;
                                                    background: task.priority_level >= 4 ? OxidiumTheme.grade_1_bg
                                                        : task.priority_level == 3 ? OxidiumTheme.grade_3_bg
                                                        : task.priority_level == 2 ? MaterialPalette.secondary_container
                                                        : OxidiumTheme.info_bg;
                                                    HorizontalLayout {
                                                        padding_left: 7px; padding_right: 7px; spacing: 4px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Icon {
                                                                source: OxidiumIcons.flag; width: 11px; height: 11px;
                                                                colorize: task.priority_level >= 4 ? OxidiumTheme.grade_1_fg
                                                                    : task.priority_level == 3 ? OxidiumTheme.grade_3_fg
                                                                    : task.priority_level == 2 ? MaterialPalette.on_secondary_container
                                                                    : OxidiumTheme.info_fg;
                                                            }
                                                        }
                                                        Text {
                                                            text: task.priority_label;
                                                            font_size: 10px; font_weight: 600;
                                                            color: task.priority_level >= 4 ? OxidiumTheme.grade_1_fg
                                                                : task.priority_level == 3 ? OxidiumTheme.grade_3_fg
                                                                : task.priority_level == 2 ? MaterialPalette.on_secondary_container
                                                                : OxidiumTheme.info_fg;
                                                            vertical_alignment: center;
                                                        }
                                                    }
                                                }
                                                if task.is_mcp : Rectangle {
                                                    height: 22px; border_radius: 6px;
                                                    background: MaterialPalette.primary_container;
                                                    HorizontalLayout {
                                                        padding_left: 6px; padding_right: 6px; spacing: 3px;
                                                        VerticalLayout { alignment: center; Icon { source: OxidiumIcons.bot; width: 11px; height: 11px; colorize: MaterialPalette.on_primary_container; } }
                                                        Text { text: "MCP"; font_family: OxidiumTheme.font_mono; font_size: 10px; font_weight: 700; color: MaterialPalette.on_primary_container; vertical_alignment: center; }
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 4px;
                                                if task.deadline_text != "" : Text {
                                                    text: (task.is_overdue && !task.is_completed ? "⚠ " : "") + task.deadline_text;
                                                    font_family: OxidiumTheme.font_mono;
                                                    font_size: 11px;
                                                    font_weight: task.is_overdue && !task.is_completed ? 700 : 500;
                                                    color: task.is_overdue && !task.is_completed ? OxidiumTheme.danger_color : MaterialPalette.on_surface_variant;
                                                    vertical_alignment: center;
                                                }
                                                Rectangle {
                                                    width: 22px; height: 22px; border_radius: 6px;
                                                    background: drag_ta.has_hover ? MaterialPalette.surface_container_highest : transparent;
                                                    Icon { source: OxidiumIcons.drag; width: 14px; height: 14px; colorize: MaterialPalette.on_surface_variant; }
                                                    drag_ta := TouchArea {
                                                        mouse_cursor: grab;
                                                        clicked => {
                                                            root.dragging_task = true;
                                                            root.drag_task_id = task.id;
                                                            root.drag_task_title = task.title;
                                                            root.drag_source_col_id = col.id;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Task Title & Subject Subtitle
                                        VerticalLayout {
                                            spacing: 3px;
                                            Text {
                                                text: task.title;
                                                font_family: OxidiumTheme.font_display;
                                                font_size: 14px;
                                                font_weight: 600;
                                                color: task.is_completed ? MaterialPalette.on_surface_variant : MaterialPalette.on_surface;
                                                wrap: word_wrap;
                                            }
                                            if task.subject_name != "" : HorizontalLayout {
                                                spacing: 6px;
                                                alignment: start;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle { width: 7px; height: 7px; border_radius: 4px; background: task.subject_color; }
                                                }
                                                Text {
                                                    text: task.subject_name;
                                                    font_size: 12px;
                                                    color: MaterialPalette.on_surface_variant;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        // Tags, Badges & Linked Grades
                                        if task.tags_text != "" || task.badges_text != "" || task.linked_grades_count > 0 : HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            if task.tags_text != "" : Rectangle {
                                                height: 20px; border_radius: 6px; background: MaterialPalette.primary_container;
                                                HorizontalLayout {
                                                    padding_left: 6px; padding_right: 6px;
                                                    Text { text: "#" + task.tags_text; font_size: 10px; font_weight: 600; color: MaterialPalette.on_primary_container; vertical_alignment: center; }
                                                }
                                            }
                                             if task.badges_text != "" : Rectangle {
                                                 height: 20px; border_radius: 6px; background: OxidiumTheme.grade_3_bg;
                                                 HorizontalLayout {
                                                     padding_left: 6px; padding_right: 6px;
                                                     Text { text: task.badges_text; font_size: 10px; font_weight: 600; color: OxidiumTheme.grade_3_fg; vertical_alignment: center; }
                                                 }
                                             }
                                             if task.linked_grades_count > 0 : Text { text: "★ Оценок: " + task.linked_grades_count; font_family: OxidiumTheme.font_mono; font_size: 10px; color: OxidiumTheme.grade_5; vertical_alignment: center; }
                                        }

                                        // Checklist Progress Bar
                                        if task.checklist_text != "" : VerticalLayout {
                                            spacing: 3px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text {
                                                    text: "Чек-лист: " + task.checklist_text;
                                                    font_family: OxidiumTheme.font_mono;
                                                    font_size: 10px;
                                                    color: MaterialPalette.on_surface_variant;
                                                }
                                            }
                                            Rectangle {
                                                height: 5px;
                                                border_radius: 3px;
                                                background: MaterialPalette.surface_container_highest;
                                                Rectangle {
                                                    x: 0px;
                                                    width: parent.width * clamp(task.checklist_ratio, 0.0, 1.0);
                                                    height: 100%;
                                                    border_radius: 3px;
                                                    background: OxidiumTheme.success_color;
                                                    animate width { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
                                                }
                                            }
                                        }

                                        // Quick card actions row (hover hints rendered outside clipped ScrollView!)
                                        HorizontalLayout {
                                            alignment: space-between;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                spacing: 2px;
                                                KanbanMicroButton {
                                                    icon: OxidiumIcons.chevron_left;
                                                    hint_text: "В предыдущую колонку";
                                                    hover_target <=> root.hover_hint;
                                                    clicked => { root.move_task_step(task.id, -1); }
                                                }
                                                KanbanMicroButton {
                                                    icon: OxidiumIcons.chevron_right;
                                                    hint_text: "В следующую колонку";
                                                    hover_target <=> root.hover_hint;
                                                    clicked => { root.move_task_step(task.id, 1); }
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 2px;
                                                KanbanMicroButton {
                                                    icon: OxidiumIcons.check;
                                                    hint_text: task.is_completed ? "Переоткрыть задачу" : "Отметить выполненной";
                                                    hover_target <=> root.hover_hint;
                                                    clicked => { root.toggle_task_complete(task.id); }
                                                }
                                                KanbanMicroButton {
                                                    icon: OxidiumIcons.edit;
                                                    hint_text: "Открыть детали задачи";
                                                    hover_target <=> root.hover_hint;
                                                    clicked => { root.open_task_detail(task.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

            // Hand-Pan Gesture Overlay when hand_mode is active
            if root.hand_mode : TouchArea {
                width: 100%;
                height: 100%;
                mouse_cursor: root.is_panning ? grabbing : grab;
                pointer-event(ev) => {
                    if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                        root.is_panning = true;
                        root.pan_start_x = self.mouse_x;
                        root.pan_start_vx = kanban_scroll.viewport_x;
                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                        root.is_panning = false;
                    }
                }
                moved => {
                    if (root.is_panning) {
                        kanban_scroll.viewport_x = clamp(
                            root.pan_start_vx + (self.mouse_x - root.pan_start_x),
                            min(0px, kanban_scroll.visible_width - kanban_scroll.viewport_width),
                            0px
                        );
                    }
                }
            }
        }
    }

    // ===== NEW TASK MODAL =====
    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000050;
        opacity: root.new_task_open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
        TouchArea { enabled: root.new_task_open; clicked => { root.new_task_open = false; } }

        Rectangle {
            width: min(500px, parent.width - 28px);
            height: min(500px, parent.height - 28px);
            x: (parent.width - self.width) / 2;
            y: root.new_task_open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 24px);
            animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
            border_radius: 24px;
            background: MaterialPalette.surface_container_high;
            border_width: 1px;
            border_color: MaterialPalette.outline_variant;
            drop_shadow_blur: 28px;
            drop_shadow_color: #00000055;
            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Новая учебная задача"; font_size: 18px; font_weight: 600; color: MaterialPalette.on_surface; }

                Text { text: "Название задачи"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                Rectangle {
                    height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_task_title; color: MaterialPalette.on_surface; }
                    if root.new_task_title == "" : Text { x: 8px; height: 100%; text: "Например: Лабораторная №5"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }

                Text { text: "Предмет"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                ScrollView {
                    height: 34px;
                    viewport_width: max(self.visible_width, nt_subj_row.preferred_width);
                    nt_subj_row := HorizontalLayout {
                        x: 0px; y: 0px; spacing: 6px; alignment: start;
                        Rectangle {
                            height: 28px; border_radius: 14px;
                            background: root.new_task_subject_idx == 0 ? MaterialPalette.primary_container : MaterialPalette.surface;
                            border_width: 1px; border_color: root.new_task_subject_idx == 0 ? MaterialPalette.primary : OxidiumTheme.cell_border;
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 10px;
                                Text { text: "Без предмета"; font_size: 11px; font_weight: 600; color: root.new_task_subject_idx == 0 ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant; vertical_alignment: center; }
                            }
                            TouchArea { mouse_cursor: pointer; clicked => { root.new_task_subject_idx = 0; } }
                        }
                        for subj[s_idx] in root.subjects : Rectangle {
                            height: 28px; border_radius: 14px;
                            background: root.new_task_subject_idx == (s_idx + 1) ? MaterialPalette.primary_container : MaterialPalette.surface;
                            border_width: 1px; border_color: root.new_task_subject_idx == (s_idx + 1) ? MaterialPalette.primary : OxidiumTheme.cell_border;
                            HorizontalLayout {
                                padding_left: 10px; padding_right: 10px;
                                Text { text: subj.short_name != "" ? subj.short_name : subj.name; font_size: 11px; color: root.new_task_subject_idx == (s_idx + 1) ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant; vertical_alignment: center; }
                            }
                            TouchArea { mouse_cursor: pointer; clicked => { root.new_task_subject_idx = s_idx + 1; } }
                        }
                    }
                }

                Text { text: "Описание (Markdown)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                Rectangle {
                    height: 52px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_task_desc; color: MaterialPalette.on_surface; }
                    if root.new_task_desc == "" : Text { x: 8px; height: 100%; text: "Краткое описание или чеклист"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal_stretch: 1;
                        spacing: 4px;
                        Text { text: "Дедлайн (YYYY-MM-DD)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                            TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_task_deadline; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                            if root.new_task_deadline == "" : Text { x: 8px; height: 100%; text: "2026-12-15"; font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                        }
                    }
                    VerticalLayout {
                        horizontal_stretch: 1;
                        spacing: 4px;
                        Text { text: "Теги (через запятую)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                            TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_task_tags; color: MaterialPalette.on_surface; }
                            if root.new_task_tags == "" : Text { x: 8px; height: 100%; text: "Лабораторная, Важное"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                        }
                    }
                }

                Text { text: "Приоритет"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                HorizontalLayout {
                    spacing: 6px;
                    for p[idx] in ["Нет", "Низкий", "Средний", "Высокий", "Крит."] : Rectangle {
                        horizontal_stretch: 1;
                        height: 30px;
                        border_radius: 8px;
                        background: root.new_task_priority == idx ? MaterialPalette.primary : MaterialPalette.surface_container;
                        Text {
                            text: p;
                            font_size: 11px;
                            color: root.new_task_priority == idx ? MaterialPalette.on_primary : MaterialPalette.on_surface;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                        TouchArea { mouse_cursor: pointer; clicked => { root.new_task_priority = idx; } }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    OutlineButton { text: "Отмена"; height: 38px; clicked => { root.new_task_open = false; } }
                    FilledButton {
                        text: "Создать";
                        height: 38px;
                        clicked => {
                            root.new_task_open = false;
                            root.create_task(
                                root.new_task_col_id,
                                root.new_task_title,
                                root.new_task_desc,
                                root.new_task_deadline,
                                root.new_task_priority,
                                root.new_task_subject_idx,
                                root.new_task_tags,
                            );
                        }
                    }
                }
            }
        }
    }

    // ===== NEW COLUMN MODAL =====
    Rectangle {
        width: 100%; height: 100%; background: #00000050;
        opacity: root.new_column_open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
        TouchArea { enabled: root.new_column_open; clicked => { root.new_column_open = false; } }
        Rectangle {
            width: min(390px, parent.width - 28px);
            height: min(310px, parent.height - 28px);
            x: (parent.width - self.width) / 2;
            y: root.new_column_open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 24px);
            animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
            border_radius: 22px; background: MaterialPalette.surface_container_high;
            border_width: 1px; border_color: MaterialPalette.outline_variant;
            drop_shadow_blur: 24px; drop_shadow_color: #00000050;
            TouchArea {}
            VerticalLayout {
                padding: 20px; spacing: 10px;
                Text { text: "Новая колонка Kanban"; font_size: 17px; font_weight: 600; color: MaterialPalette.on_surface; }
                Text { text: "Название"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                Rectangle {
                    height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_column_name; color: MaterialPalette.on_surface; }
                    if root.new_column_name == "" : Text { x: 8px; height: 100%; text: "Например: Тестирование"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                }
                Text { text: "WIP-лимит (пусто = без ограничения)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                Rectangle {
                    height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_column_wip; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                    if root.new_column_wip == "" : Text { x: 8px; height: 100%; text: "Например: 5"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Колонка завершённых задач"; font_size: 12px; color: MaterialPalette.on_surface; vertical_alignment: center; }
                    Switch { width: 52px; height: 32px; checked <=> root.new_column_done; }
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    OutlineButton { text: "Отмена"; height: 38px; clicked => { root.new_column_open = false; } }
                    FilledButton {
                        text: "Создать";
                        height: 38px;
                        clicked => {
                            root.new_column_open = false;
                            root.create_column(root.new_column_name, root.new_column_wip, root.new_column_done);
                        }
                    }
                }
            }
        }
    }

    // ===== NEW BOARD MODAL =====
    Rectangle {
        width: 100%; height: 100%; background: #00000050;
        opacity: root.new_board_open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
        TouchArea { enabled: root.new_board_open; clicked => { root.new_board_open = false; } }
        Rectangle {
            width: min(360px, parent.width - 28px);
            height: min(210px, parent.height - 28px);
            x: (parent.width - self.width) / 2;
            y: root.new_board_open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 24px);
            animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
            border_radius: 22px; background: MaterialPalette.surface_container_high;
            border_width: 1px; border_color: MaterialPalette.outline_variant;
            drop_shadow_blur: 24px; drop_shadow_color: #00000050;
            TouchArea {}
            VerticalLayout {
                padding: 20px; spacing: 10px;
                Text { text: "Новая Kanban-доска"; font_size: 17px; font_weight: 600; color: MaterialPalette.on_surface; }
                Text { text: "Название доски"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                Rectangle {
                    height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_board_name; color: MaterialPalette.on_surface; }
                    if root.new_board_name == "" : Text { x: 8px; height: 100%; text: "Например: Экзамены"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    OutlineButton { text: "Отмена"; height: 38px; clicked => { root.new_board_open = false; } }
                    FilledButton {
                        text: "Создать";
                        height: 38px;
                        clicked => {
                            root.new_board_open = false;
                            root.create_board(root.new_board_name);
                        }
                    }
                }
            }
        }
    }

    // ===== TASK DETAIL DRAWER MODAL =====
    Rectangle {
        width: 100%; height: 100%; background: #00000050;
        opacity: root.detail_open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
        TouchArea { enabled: root.detail_open; clicked => { root.detail_open = false; } }
        Rectangle {
            width: min(580px, parent.width - 28px);
            height: min(630px, parent.height - 28px);
            x: (parent.width - self.width) / 2;
            y: root.detail_open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 24px);
            animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
            border_radius: 24px; background: MaterialPalette.surface_container_high;
            border_width: 1px; border_color: MaterialPalette.outline_variant;
            drop_shadow_blur: 28px; drop_shadow_color: #00000055;
            TouchArea {}

            VerticalLayout {
                padding: 20px; spacing: 10px;
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Детали задачи"; font_size: 18px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                    OxidiumIconButton { icon: OxidiumIcons.close; tooltip: "Закрыть"; clicked => { root.detail_open = false; } }
                }

                Rectangle {
                    height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.detail_title; font_weight: 600; color: MaterialPalette.on_surface; }
                    if root.detail_title == "" : Text { x: 8px; height: 100%; text: "Название задачи"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal_stretch: 1; spacing: 4px;
                        Text { text: "Описание"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 48px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                            TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.detail_desc; color: MaterialPalette.on_surface; }
                            if root.detail_desc == "" : Text { x: 8px; height: 100%; text: "Описание задачи..."; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                        }
                    }
                    VerticalLayout {
                        horizontal_stretch: 1; spacing: 4px;
                        Text { text: "Заметки (Markdown)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 48px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                            TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.detail_notes; color: MaterialPalette.on_surface; }
                            if root.detail_notes == "" : Text { x: 8px; height: 100%; text: "Ссылки, формулы, замечания..."; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                        }
                    }
                }

                Text { text: "Приоритет"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                HorizontalLayout {
                    spacing: 6px;
                    for p[idx] in ["Нет", "Низкий", "Средний", "Высокий", "Крит."] : Rectangle {
                        horizontal_stretch: 1;
                        height: 28px;
                        border_radius: 8px;
                        background: root.detail_priority == idx ? MaterialPalette.primary : MaterialPalette.surface_container;
                        Text {
                            text: p;
                            font_size: 11px;
                            color: root.detail_priority == idx ? MaterialPalette.on_primary : MaterialPalette.on_surface;
                            horizontal_alignment: center;
                            vertical_alignment: center;
                        }
                        TouchArea { mouse_cursor: pointer; clicked => { root.detail_priority = idx; } }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal_stretch: 1;
                        Text { text: "Дедлайн (YYYY-MM-DD)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 34px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                            TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.detail_deadline; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                            if root.detail_deadline == "" : Text { x: 8px; height: 100%; text: "YYYY-MM-DD"; font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                        }
                    }
                    VerticalLayout {
                        horizontal_stretch: 1;
                        Text { text: "Добавить тег (" + (root.detail_tags_text != "" ? root.detail_tags_text : "нет") + ")"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                horizontal_stretch: 1; height: 34px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.detail_new_tag; color: MaterialPalette.on_surface; }
                                if root.detail_new_tag == "" : Text { x: 8px; height: 100%; text: "Новый тег"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                            }
                            VerticalLayout {
                                alignment: center;
                                TonalButton {
                                    text: "+";
                                    height: 34px;
                                    clicked => {
                                        root.add_tag_to_task(root.detail_task_id, root.detail_new_tag);
                                        root.detail_new_tag = "";
                                    }
                                }
                            }
                        }
                    }
                }

                // Checklist section
                Text { text: "Чек-лист"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface; }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        horizontal_stretch: 1; height: 34px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                        TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.detail_new_checklist; color: MaterialPalette.on_surface; }
                        if root.detail_new_checklist == "" : Text { x: 8px; height: 100%; text: "Новый пункт чек-листа..."; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(60%); vertical_alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        TonalButton {
                            text: "Добавить пункт";
                            height: 34px;
                            clicked => {
                                root.add_checklist_item(root.detail_task_id, root.detail_new_checklist);
                                root.detail_new_checklist = "";
                            }
                        }
                    }
                }

                ScrollView {
                    vertical_stretch: 1;
                    viewport_width: self.visible_width;
                    viewport_height: max(self.visible_height, td_checklist_col.preferred_height);
                    td_checklist_col := VerticalLayout {
                        x: 0px; y: 0px;
                        width: parent.visible_width;
                        spacing: 4px;
                        alignment: start;
                        for ci in root.detail_checklist : HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                OxidiumIconButton {
                                    icon: ci.is_completed ? OxidiumIcons.check_box : OxidiumIcons.check;
                                    button_size: 32px; icon_size: 16px;
                                    tooltip: ci.is_completed ? "Снять отметку" : "Выполнено";
                                    clicked => { root.toggle_checklist_item(ci.id, !ci.is_completed); }
                                }
                                Text {
                                    text: ci.title;
                                    font_size: 13px;
                                    color: ci.is_completed ? MaterialPalette.on_surface_variant : MaterialPalette.on_surface;
                                    vertical_alignment: center;
                                }
                            }
                            OxidiumIconButton {
                                icon: OxidiumIcons.delete;
                                button_size: 32px; icon_size: 16px;
                                tooltip: "Удалить пункт";
                                clicked => { root.delete_checklist_item(ci.id); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        OutlineButton {
                            text: "Дублировать";
                            height: 38px;
                            clicked => {
                                root.detail_open = false;
                                root.duplicate_task(root.detail_task_id);
                            }
                        }
                        OutlineButton {
                            text: "Удалить";
                            height: 38px;
                            clicked => {
                                root.detail_open = false;
                                root.delete_task(root.detail_task_id);
                            }
                        }
                    }
                    FilledButton {
                        text: "Сохранить";
                        height: 38px;
                        clicked => {
                            root.detail_open = false;
                            root.save_task_detail(
                                root.detail_task_id,
                                root.detail_title,
                                root.detail_desc,
                                root.detail_notes,
                                root.detail_deadline,
                                root.detail_priority,
                            );
                        }
                    }
                }
            }
        }
    }
}
