import "../../../assets/fonts/Roboto-Regular.ttf";
import "../../../assets/fonts/Roboto-Medium.ttf";
import "../../../assets/fonts/Roboto-Bold.ttf";
import "../../../assets/fonts/RobotoMono-Regular.ttf";
import "../../../assets/fonts/RobotoMono-Medium.ttf";
import "../../../assets/fonts/RobotoFlex.ttf";

import { MaterialPalette } from "@material";

export global OxidiumTheme {
    in_out property <bool> dark_mode: false;
    in_out property <bool> compact_mode: false;
    in_out property <bool> reduced_motion: false;
    in_out property <float> ui_scale: 1.0;
    in_out property <int> font_size_delta: 0;

    out property <string> font_sans: "Roboto";
    out property <string> font_mono: "Roboto Mono";
    out property <duration> anim_fast: root.reduced_motion ? 0ms : 140ms;
    out property <duration> anim_medium: root.reduced_motion ? 0ms : 220ms;

    // Semantic grade & mark colors (customizable by user, legible in light & dark themes)
    in_out property <color> grade_5: #2E7D32;
    in_out property <color> grade_4: #00897B;
    in_out property <color> grade_3: #D97706;
    in_out property <color> grade_2: #EA580C;
    in_out property <color> grade_1: #DC2626;
    in_out property <color> mark_absent: #E11D48;
    in_out property <color> mark_excused: #2563EB;
    in_out property <color> mark_pass: #0D9488;
    in_out property <color> mark_fail: #B91C1C;

    // Surface & highlight roles
    out property <color> weekend_tint: root.dark_mode ? #ffffff0b : #0f172a09;
    out property <color> holiday_tint: root.dark_mode ? #f59e0b1f : #f59e0b1c;
    out property <color> today_tint: MaterialPalette.primary_container.with_alpha(root.dark_mode ? 45% : 55%);
    out property <color> cell_border: MaterialPalette.outline_variant.with_alpha(45%);
    out property <color> success_color: root.dark_mode ? #4ade80 : #15803d;
    out property <color> warning_color: root.dark_mode ? #fbbf24 : #b45309;
    out property <color> danger_color: root.dark_mode ? #f87171 : #b91c1c;

    // Spacing & row sizing responding to compact mode & scale
    out property <length> row_height: (root.compact_mode ? 38px : 46px) * root.ui_scale;
    out property <length> cell_width: (root.compact_mode ? 40px : 48px) * root.ui_scale;
    out property <length> subject_col_width: (root.compact_mode ? 185px : 220px) * root.ui_scale;
    out property <length> avg_col_width: (root.compact_mode ? 84px : 96px) * root.ui_scale;
}

