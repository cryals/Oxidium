import "../../../assets/fonts/Roboto-Regular.ttf";
import "../../../assets/fonts/Roboto-Medium.ttf";
import "../../../assets/fonts/Roboto-Bold.ttf";
import "../../../assets/fonts/RobotoMono-Regular.ttf";
import "../../../assets/fonts/RobotoMono-Medium.ttf";
import "../../../assets/fonts/RobotoFlex.ttf";

import { MaterialPalette } from "@material";

export global OxidiumMotion {
    // M3 Expressive Web spring-converted cubic-bezier curves (m3.material.io/styles/motion/overview/specs)
    out property <easing> expressive_fast_spatial: cubic-bezier(0.42, 1.67, 0.21, 0.90);
    out property <easing> expressive_default_spatial: cubic-bezier(0.38, 1.21, 0.22, 1.00);
    out property <easing> expressive_slow_spatial: cubic-bezier(0.39, 1.29, 0.35, 0.98);

    out property <easing> expressive_fast_effects: cubic-bezier(0.31, 0.94, 0.34, 1.00);
    out property <easing> expressive_default_effects: cubic-bezier(0.34, 0.80, 0.34, 1.00);
    out property <easing> expressive_slow_effects: cubic-bezier(0.34, 0.88, 0.34, 1.00);

    out property <easing> standard_spatial: cubic-bezier(0.27, 1.06, 0.18, 1.00);

    // Aliases for smooth backwards compatibility across components
    out property <easing> ease_emphasized: cubic-bezier(0.38, 1.21, 0.22, 1.00);
    out property <easing> ease_standard: cubic-bezier(0.34, 0.80, 0.34, 1.00);
}

export global OxidiumTooltipState {
    in_out property <string> text: "";
    in_out property <length> anchor_x: 0px;
    in_out property <length> anchor_y: 0px;
    in_out property <length> anchor_w: 40px;
    in_out property <length> anchor_h: 40px;
    in_out property <bool> shown: false;
}

export global OxidiumTheme {
    in_out property <bool> dark_mode: false;
    in_out property <bool> compact_mode: false;
    in_out property <bool> reduced_motion: false;
    in_out property <float> ui_scale: 1.0;
    in_out property <int> font_size_delta: 0;

    out property <string> font_sans: "Roboto";
    out property <string> font_display: "Roboto Flex";
    out property <string> font_mono: "Roboto Mono";

    // M3 Expressive Web duration tokens (respects reduced_motion accessibility setting)
    out property <duration> dur_spatial_fast: root.reduced_motion ? 0ms : 350ms;
    out property <duration> dur_spatial_default: root.reduced_motion ? 0ms : 500ms;
    out property <duration> dur_spatial_slow: root.reduced_motion ? 0ms : 650ms;
    out property <duration> dur_effects_fast: root.reduced_motion ? 0ms : 150ms;
    out property <duration> dur_effects_default: root.reduced_motion ? 0ms : 200ms;
    out property <duration> dur_effects_slow: root.reduced_motion ? 0ms : 300ms;

    // Convenience duration roles
    out property <duration> anim_instant: root.reduced_motion ? 0ms : 150ms;
    out property <duration> anim_fast: root.reduced_motion ? 0ms : 200ms;
    out property <duration> anim_medium: root.reduced_motion ? 0ms : 350ms;
    out property <duration> anim_emphasized: root.reduced_motion ? 0ms : 500ms;
    out property <duration> anim_chart: root.reduced_motion ? 0ms : 650ms;

    // Semantic heatmap & grade highlight tokens
    out property <color> grade_2_brown: root.dark_mode ? #D96B43 : #A1521D;
    out property <color> grade_2_brown_bg: root.dark_mode ? #5A3117 : #F4DFCF;
    out property <color> absent_red: root.dark_mode ? #F28B82 : #D32F2F;
    out property <color> absent_red_bg: root.dark_mode ? #6E2120 : #FADCD9;
    out property <color> task_accent: root.dark_mode ? #C8B6FF : #6750A4;

    // Semantic grade & mark accents (customizable by user, paired with high-contrast Light/Dark containers)
    in_out property <color> grade_5: root.dark_mode ? #8CD99E : #146C2E;
    in_out property <color> grade_4: root.dark_mode ? #7AD7CA : #006A60;
    in_out property <color> grade_3: root.dark_mode ? #FFCA62 : #8D4E00;
    in_out property <color> grade_2: root.dark_mode ? #D96B43 : #B33B00;
    in_out property <color> grade_1: root.dark_mode ? #F2B8B5 : #B3261E;
    in_out property <color> mark_absent: root.dark_mode ? #F2B8B5 : #B3261E;
    in_out property <color> mark_excused: root.dark_mode ? #9EC8F5 : #1A5F9E;
    in_out property <color> mark_pass: root.dark_mode ? #8CD99E : #146C2E;
    in_out property <color> mark_fail: root.dark_mode ? #F2B8B5 : #B3261E;

    // Accessible MD3 Expressive Container / On-Container pairs (Mono Lavender system)
    out property <color> grade_5_bg: root.dark_mode ? #184E27 : #D4F2DB;
    out property <color> grade_5_fg: root.dark_mode ? #C2F2CD : #0B3D1A;
    out property <color> grade_4_bg: root.dark_mode ? #164E47 : #CCEBE6;
    out property <color> grade_4_fg: root.dark_mode ? #BCEFE7 : #003731;
    out property <color> grade_3_bg: root.dark_mode ? #5C390B : #FFE6C7;
    out property <color> grade_3_fg: root.dark_mode ? #FFE0BC : #3E2000;
    out property <color> grade_2_bg: root.dark_mode ? #6B260B : #FFE1D6;
    out property <color> grade_2_fg: root.dark_mode ? #FFD8C9 : #4A1500;
    out property <color> grade_1_bg: root.dark_mode ? #7A1F1A : #F9DEDC;
    out property <color> grade_1_fg: root.dark_mode ? #F9DEDC : #410E0B;
    out property <color> info_bg: root.dark_mode ? #1A446E : #D8E9FA;
    out property <color> info_fg: root.dark_mode ? #D6EAFF : #0A2E52;

    // Surface & highlight roles
    out property <color> weekend_tint: root.dark_mode ? #2B292D80 : #E9E5EA80;
    out property <color> holiday_tint: root.dark_mode ? #5C390B44 : #FFE6C770;
    out property <color> today_tint: MaterialPalette.primary_container.with_alpha(root.dark_mode ? 32% : 45%);
    out property <color> cell_border: MaterialPalette.outline_variant.with_alpha(root.dark_mode ? 65% : 60%);
    out property <color> success_color: root.dark_mode ? #8CD99E : #146C2E;
    out property <color> warning_color: root.dark_mode ? #FFB969 : #8D4E00;
    out property <color> danger_color: root.dark_mode ? #F2B8B5 : #B3261E;

    // Spacing & row sizing responding to compact mode & scale
    out property <length> row_height: (root.compact_mode ? 38px : 48px) * root.ui_scale;
    out property <length> cell_width: (root.compact_mode ? 40px : 46px) * root.ui_scale;
    out property <length> subject_col_width: (root.compact_mode ? 190px : 232px) * root.ui_scale;
    out property <length> avg_col_width: (root.compact_mode ? 84px : 94px) * root.ui_scale;
}

