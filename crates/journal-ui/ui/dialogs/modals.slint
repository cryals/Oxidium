import { MaterialPalette, FilledButton, TonalButton, OutlineButton, Icon, ScrollView, Switch } from "@material";
import { OxidiumTheme, OxidiumMotion, OxidiumTooltipState, OxidiumIcons } from "../theme.slint";
import { OxidiumIconButton } from "../components.slint";
import {
    ProfileItem, SubjectItem, PeriodItem, SearchHitItem,
    ActivityRowItem, NotificationRowItem, UiStrings
} from "../types.slint";

// ============================================================================
// Profiles Manager Dialog
// ============================================================================
export component ProfilesModal inherits Rectangle {
    in property <bool> open: false;
    in property <[ProfileItem]> profiles;
    in_out property <string> new_name: "";
    in_out property <string> new_institution: "";
    in_out property <string> new_group: "";
    in_out property <string> new_year: "2026–2027";
    in_out property <string> new_color: "#445E91";
    in property <string> delete_warning_text: "";
    in_out property <string> pending_delete_id: "";

    callback close();
    callback switch_profile(string);
    callback create_profile(string, string, string, string, string);
    callback duplicate_profile(string);
    callback archive_profile(string, bool);
    callback request_delete_profile(string);
    callback confirm_delete_profile(string);

    width: 100%; height: 100%;
    background: #00000055;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    Rectangle {
        width: min(620px, parent.width - 28px);
        height: min(560px, parent.height - 28px);
        x: (parent.width - self.width) / 2;
        y: root.open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 26px);
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 24px;
        background: MaterialPalette.surface_container_high;
        border_width: 1px; border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 28px; drop_shadow_color: #00000055;
        TouchArea {}

        VerticalLayout {
            padding: 22px; spacing: 14px;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Управление учебными профилями"; font_size: 19px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                OxidiumIconButton { icon: OxidiumIcons.close; tooltip: "Закрыть"; clicked => { root.close(); } }
            }

            if root.pending_delete_id != "" : Rectangle {
                border_radius: 12px;
                background: MaterialPalette.error_container;
                HorizontalLayout {
                    padding: 12px; spacing: 10px; alignment: space-between;
                    Text {
                        horizontal_stretch: 1;
                        text: root.delete_warning_text;
                        font_size: 12px; font_weight: 500;
                        color: MaterialPalette.on_error_container;
                        wrap: word_wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout { alignment: center; OutlineButton { text: "Отмена"; height: 36px; clicked => { root.pending_delete_id = ""; } } }
                        VerticalLayout {
                            alignment: center;
                            FilledButton {
                                text: "Удалить навсегда";
                                height: 36px;
                                clicked => {
                                    root.confirm_delete_profile(root.pending_delete_id);
                                    root.pending_delete_id = "";
                                }
                            }
                        }
                    }
                }
            }

            ScrollView {
                vertical_stretch: 1;
                viewport_width: self.visible_width;
                viewport_height: max(self.visible_height, profiles_scroll_col.preferred_height);
                profiles_scroll_col := VerticalLayout {
                    x: 0px; y: 0px;
                    width: parent.visible_width;
                    spacing: 8px;
                    alignment: start;
                    for p in root.profiles : Rectangle {
                        border_radius: 14px;
                        background: p.is_active ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                        border_width: 1px;
                        border_color: p.is_active ? MaterialPalette.primary : OxidiumTheme.cell_border;

                        HorizontalLayout {
                            padding: 12px; spacing: 10px; alignment: space-between;
                            HorizontalLayout {
                                spacing: 10px; horizontal_stretch: 1;
                                Rectangle {
                                    width: 36px; height: 36px; border_radius: 18px;
                                    background: p.color;
                                    Icon { source: OxidiumIcons.person; width: 20px; height: 20px; colorize: #ffffff; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: p.name + (p.is_active ? " (Активный)" : "") + (p.is_archived ? " [Архив]" : "");
                                        font_size: 14px; font_weight: 600;
                                        color: p.is_active ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                                    }
                                    Text {
                                        text: p.institution + (p.group_name != "" ? " • " + p.group_name : "") + (p.academic_year != "" ? " • " + p.academic_year : "");
                                        font_size: 11px;
                                        color: MaterialPalette.on_surface_variant;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                if !p.is_active && !p.is_archived : VerticalLayout {
                                    alignment: center;
                                    TonalButton {
                                        text: "Выбрать";
                                        height: 36px;
                                        clicked => { root.switch_profile(p.id); }
                                    }
                                }
                                OxidiumIconButton { icon: OxidiumIcons.copy; button_size: 34px; icon_size: 17px; tooltip: "Дублировать"; clicked => { root.duplicate_profile(p.id); } }
                                OxidiumIconButton {
                                    icon: p.is_archived ? OxidiumIcons.restore : OxidiumIcons.archive;
                                    button_size: 34px; icon_size: 17px;
                                    tooltip: p.is_archived ? "Восстановить" : "Архивировать";
                                    clicked => { root.archive_profile(p.id, !p.is_archived); }
                                }
                                OxidiumIconButton { icon: OxidiumIcons.delete; button_size: 34px; icon_size: 17px; tooltip: "Удалить профиль"; clicked => { root.request_delete_profile(p.id); } }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: OxidiumTheme.cell_border; }

            Text { text: "Создать новый независимый профиль (Название • Учебное заведение • Группа)"; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal_stretch: 2; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_name; color: MaterialPalette.on_surface; }
                    if root.new_name == "" : Text { x: 8px; height: 100%; text: "Название профиля"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                Rectangle {
                    horizontal_stretch: 2; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_institution; color: MaterialPalette.on_surface; }
                    if root.new_institution == "" : Text { x: 8px; height: 100%; text: "ВУЗ / Колледж / Школа"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                Rectangle {
                    horizontal_stretch: 1; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_group; color: MaterialPalette.on_surface; }
                    if root.new_group == "" : Text { x: 8px; height: 100%; text: "Группа"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                VerticalLayout {
                    alignment: center;
                    FilledButton {
                        text: "Создать";
                        height: 36px;
                        clicked => {
                            root.create_profile(root.new_name, root.new_institution, root.new_group, root.new_year, root.new_color);
                            root.new_name = "";
                            root.new_institution = "";
                            root.new_group = "";
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Subjects Manager Dialog (with reorder, archive, delete impact warning)
// ============================================================================
export component SubjectsModal inherits Rectangle {
    in property <bool> open: false;
    in property <[SubjectItem]> subjects;
    in_out property <string> new_name: "";
    in_out property <string> new_short: "";
    in_out property <string> new_teacher: "";
    in_out property <string> new_target: "4.5";
    in_out property <string> new_color: "#2E7D32";
    in property <string> delete_warning_text: "";
    in_out property <string> pending_delete_id: "";

    callback close();
    callback create_subject(string, string, string, string, string);
    callback move_subject(string, int);
    callback archive_subject(string, bool);
    callback request_delete_subject(string);
    callback confirm_delete_subject(string);

    width: 100%; height: 100%;
    background: #00000055;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    Rectangle {
        width: min(640px, parent.width - 28px);
        height: min(560px, parent.height - 28px);
        x: (parent.width - self.width) / 2;
        y: root.open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 26px);
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 24px;
        background: MaterialPalette.surface_container_high;
        border_width: 1px; border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 28px; drop_shadow_color: #00000055;
        TouchArea {}

        VerticalLayout {
            padding: 22px; spacing: 12px;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Управление предметами"; font_size: 19px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                OxidiumIconButton { icon: OxidiumIcons.close; tooltip: "Закрыть"; clicked => { root.close(); } }
            }

            if root.pending_delete_id != "" : Rectangle {
                border_radius: 12px; background: MaterialPalette.error_container;
                HorizontalLayout {
                    padding: 12px; spacing: 8px; alignment: space-between;
                    Text { horizontal_stretch: 1; text: root.delete_warning_text; font_size: 12px; color: MaterialPalette.on_error_container; wrap: word_wrap; }
                    VerticalLayout { alignment: center; OutlineButton { text: "Отмена"; height: 36px; clicked => { root.pending_delete_id = ""; } } }
                    VerticalLayout {
                        alignment: center;
                        FilledButton {
                            text: "Удалить";
                            height: 36px;
                            clicked => {
                                root.confirm_delete_subject(root.pending_delete_id);
                                root.pending_delete_id = "";
                            }
                        }
                    }
                }
            }

            ScrollView {
                vertical_stretch: 1;
                viewport_width: self.visible_width;
                viewport_height: max(self.visible_height, subjects_scroll_col.preferred_height);
                subjects_scroll_col := VerticalLayout {
                    x: 0px; y: 0px;
                    width: parent.visible_width;
                    spacing: 6px;
                    alignment: start;
                    for s in root.subjects : Rectangle {
                        border_radius: 12px;
                        background: MaterialPalette.surface_container;
                        border_width: 1px; border_color: OxidiumTheme.cell_border;
                        HorizontalLayout {
                            padding: 10px; spacing: 8px; alignment: space-between;
                            HorizontalLayout {
                                spacing: 10px; horizontal_stretch: 1;
                                Rectangle { width: 10px; height: 28px; border_radius: 5px; background: s.color; }
                                VerticalLayout {
                                    Text {
                                        text: s.name + (s.short_name != "" ? " (" + s.short_name + ")" : "") + (s.is_archived ? " [Архив]" : "");
                                        font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface;
                                    }
                                    Text {
                                        text: (s.teacher != "" ? s.teacher : "Преподаватель не указан") + (s.target_average != "" ? " • Цель: " + s.target_average : "");
                                        font_size: 11px; color: MaterialPalette.on_surface_variant;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 2px;
                                OxidiumIconButton { icon: OxidiumIcons.arrow_up; button_size: 32px; icon_size: 16px; tooltip: "Выше"; clicked => { root.move_subject(s.id, -1); } }
                                OxidiumIconButton { icon: OxidiumIcons.arrow_down; button_size: 32px; icon_size: 16px; tooltip: "Ниже"; clicked => { root.move_subject(s.id, 1); } }
                                OxidiumIconButton {
                                    icon: s.is_archived ? OxidiumIcons.restore : OxidiumIcons.archive;
                                    button_size: 32px; icon_size: 16px;
                                    tooltip: s.is_archived ? "Восстановить" : "Архивировать";
                                    clicked => { root.archive_subject(s.id, !s.is_archived); }
                                }
                                OxidiumIconButton { icon: OxidiumIcons.delete; button_size: 32px; icon_size: 16px; tooltip: "Удалить"; clicked => { root.request_delete_subject(s.id); } }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: OxidiumTheme.cell_border; }
            Text { text: "Добавить предмет (Название • Сокращение • Преподаватель • Целевой балл)"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface; }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal_stretch: 3; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_name; color: MaterialPalette.on_surface; }
                    if root.new_name == "" : Text { x: 8px; height: 100%; text: "Название предмета"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                Rectangle {
                    horizontal_stretch: 1; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_short; color: MaterialPalette.on_surface; }
                    if root.new_short == "" : Text { x: 8px; height: 100%; text: "Сокр."; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                Rectangle {
                    horizontal_stretch: 2; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_teacher; color: MaterialPalette.on_surface; }
                    if root.new_teacher == "" : Text { x: 8px; height: 100%; text: "Преподаватель"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                Rectangle {
                    width: 68px; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_target; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                }
                VerticalLayout {
                    alignment: center;
                    FilledButton {
                        text: "Добавить";
                        height: 36px;
                        clicked => {
                            root.create_subject(root.new_name, root.new_short, root.new_teacher, root.new_target, root.new_color);
                            root.new_name = "";
                            root.new_short = "";
                            root.new_teacher = "";
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Academic Periods Modal
// ============================================================================
export component PeriodsModal inherits Rectangle {
    in property <bool> open: false;
    in property <[PeriodItem]> periods;
    in_out property <string> new_name: "";
    in_out property <string> new_start: "2026-09-01";
    in_out property <string> new_end: "2026-12-31";
    in_out property <int> new_type_idx: 1; // 0=Year, 1=Semester, 2=Quarter, 3=Trimester, 4=Custom

    callback close();
    callback create_period(string, int, string, string);
    callback select_period(string);

    width: 100%; height: 100%;
    background: #00000055;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    Rectangle {
        width: min(560px, parent.width - 28px);
        height: min(460px, parent.height - 28px);
        x: (parent.width - self.width) / 2;
        y: root.open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 26px);
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 24px; background: MaterialPalette.surface_container_high;
        border_width: 1px; border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 28px; drop_shadow_color: #00000055;
        TouchArea {}

        VerticalLayout {
            padding: 22px; spacing: 12px;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Учебные периоды"; font_size: 18px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                OxidiumIconButton { icon: OxidiumIcons.close; tooltip: "Закрыть"; clicked => { root.close(); } }
            }

            ScrollView {
                vertical_stretch: 1;
                viewport_width: self.visible_width;
                viewport_height: max(self.visible_height, periods_scroll_col.preferred_height);
                periods_scroll_col := VerticalLayout {
                    x: 0px; y: 0px;
                    width: parent.visible_width;
                    spacing: 6px;
                    alignment: start;
                    for per in root.periods : Rectangle {
                        border_radius: 12px; background: MaterialPalette.surface_container;
                        HorizontalLayout {
                            padding: 10px; alignment: space-between;
                            VerticalLayout {
                                Text { text: per.name; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                                Text { text: per.start_date + " — " + per.end_date + " (" + per.period_type + ")"; font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant; }
                            }
                            VerticalLayout {
                                alignment: center;
                                TonalButton {
                                    text: "Открыть в журнале";
                                    height: 36px;
                                    clicked => {
                                        root.select_period(per.id);
                                        root.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: OxidiumTheme.cell_border; }
            HorizontalLayout {
                spacing: 6px;
                for pt[idx] in ["Уч. год", "Семестр", "Четверть", "Триместр", "Свой"] : Rectangle {
                    horizontal_stretch: 1; height: 28px; border_radius: 8px;
                    background: root.new_type_idx == idx ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                    border_width: 1px; border_color: root.new_type_idx == idx ? MaterialPalette.primary : OxidiumTheme.cell_border;
                    Text {
                        text: pt; font_size: 11px; font_weight: 600;
                        color: root.new_type_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface_variant;
                        horizontal_alignment: center; vertical_alignment: center;
                    }
                    TouchArea { mouse_cursor: pointer; clicked => { root.new_type_idx = idx; } }
                }
            }
            Text { text: "Новый период (Название • Начало YYYY-MM-DD • Окончание YYYY-MM-DD)"; font_size: 11px; color: MaterialPalette.on_surface_variant; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal_stretch: 2; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_name; color: MaterialPalette.on_surface; }
                    if root.new_name == "" : Text { x: 8px; height: 100%; text: "Например: Осенний семестр"; font_size: 11px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                Rectangle {
                    width: 110px; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_start; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                }
                Rectangle {
                    width: 110px; height: 36px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                    TextInput { x: 8px; width: parent.width - 16px; height: 100%; vertical_alignment: center; text <=> root.new_end; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                }
                VerticalLayout {
                    alignment: center;
                    FilledButton {
                        text: "Создать";
                        height: 36px;
                        clicked => {
                            root.create_period(root.new_name, root.new_type_idx, root.new_start, root.new_end);
                            root.new_name = "";
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Global Search Modal (Ctrl+F)
// ============================================================================
export component GlobalSearchModal inherits Rectangle {
    in property <bool> open: false;
    in_out property <string> query: "";
    in property <[SearchHitItem]> hits;

    callback close();
    callback search_edited(string);
    callback hit_selected(string, string); // entity_type, entity_id

    width: 100%; height: 100%;
    background: #00000050;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    changed open => {
        if (self.open) {
            search_input.focus();
        }
    }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    Rectangle {
        width: min(580px, parent.width - 28px);
        height: min(440px, parent.height - 96px);
        x: (parent.width - self.width) / 2;
        y: root.open ? 68px : 44px;
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 22px; background: MaterialPalette.surface_container_high;
        border_width: 1px; border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 28px; drop_shadow_color: #00000055;
        TouchArea {}

        VerticalLayout {
            padding: 16px; spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal_stretch: 1; height: 42px; border_radius: 21px;
                    background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.primary;
                    HorizontalLayout {
                        padding_left: 14px; padding_right: 12px; spacing: 8px;
                        VerticalLayout { alignment: center; Icon { source: OxidiumIcons.search; width: 18px; height: 18px; colorize: MaterialPalette.primary; } }
                        search_input := TextInput {
                            horizontal_stretch: 1;
                            vertical_alignment: center;
                            text <=> root.query;
                            color: MaterialPalette.on_surface;
                            edited => { root.search_edited(self.text); }
                        }
                    }
                    if root.query == "" : Text { x: 40px; height: 100%; text: "Поиск по предметам, оценкам, задачам и тегам..."; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                }
                OxidiumIconButton { icon: OxidiumIcons.close; tooltip: "Закрыть"; clicked => { root.close(); } }
            }

            ScrollView {
                vertical_stretch: 1;
                viewport_width: self.visible_width;
                viewport_height: max(self.visible_height, search_hits_col.preferred_height);
                search_hits_col := VerticalLayout {
                    x: 0px; y: 0px;
                    width: parent.visible_width;
                    spacing: 6px;
                    alignment: start;
                    if root.hits.length == 0 : Text {
                        text: root.query == "" ? "Введите запрос для поиска по предметам, оценкам, заметкам, задачам и тегам." : "Ничего не найдено.";
                        font_size: 13px; color: MaterialPalette.on_surface_variant;
                    }
                    for h in root.hits : Rectangle {
                        border_radius: 12px;
                        background: hit_ta.has_hover ? MaterialPalette.primary_container.with_alpha(50%) : MaterialPalette.surface_container;
                        HorizontalLayout {
                            padding: 10px; spacing: 10px; alignment: space-between;
                            VerticalLayout {
                                horizontal_stretch: 1; spacing: 2px;
                                Text { text: h.title; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                                if h.snippet != "" : Text { text: h.snippet; font_size: 11px; color: MaterialPalette.on_surface_variant; overflow: elide; }
                            }
                            Text {
                                text: h.entity_type_label + (h.date_text != "" ? " • " + h.date_text : "");
                                font_family: OxidiumTheme.font_mono; font_size: 10px; color: MaterialPalette.primary; vertical_alignment: center;
                            }
                        }
                        hit_ta := TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.hit_selected(h.entity_type, h.entity_id);
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Notifications Center Modal
// ============================================================================
export component NotificationsModal inherits Rectangle {
    in property <bool> open: false;
    in property <[NotificationRowItem]> items;
    in property <string> background_notice;

    callback close();
    callback mark_all_read();
    callback dismiss_item(string);

    width: 100%; height: 100%;
    background: #00000045;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    Rectangle {
        width: min(440px, parent.width - 28px);
        height: min(500px, parent.height - 96px);
        x: max(14px, parent.width - self.width - 24px);
        y: root.open ? 68px : 44px;
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 22px; background: MaterialPalette.surface_container_high;
        border_width: 1px; border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 24px; drop_shadow_color: #00000045;
        TouchArea {}

        VerticalLayout {
            padding: 18px; spacing: 10px;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Центр уведомлений"; font_size: 17px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout { alignment: center; TonalButton { text: "Прочитать все"; height: 32px; clicked => { root.mark_all_read(); } } }
                    OxidiumIconButton { icon: OxidiumIcons.close; tooltip: "Закрыть"; clicked => { root.close(); } }
                }
            }

            Rectangle {
                border_radius: 10px; background: MaterialPalette.surface_container;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    VerticalLayout { alignment: center; Icon { source: OxidiumIcons.notifications; width: 14px; height: 14px; colorize: MaterialPalette.primary; } }
                    Text { horizontal_stretch: 1; text: root.background_notice; font_size: 11px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; vertical_alignment: center; }
                }
            }

            ScrollView {
                vertical_stretch: 1;
                viewport_width: self.visible_width;
                viewport_height: max(self.visible_height, notif_scroll_col.preferred_height);
                notif_scroll_col := VerticalLayout {
                    x: 0px; y: 0px;
                    width: parent.visible_width;
                    spacing: 8px;
                    alignment: start;
                    if root.items.length == 0 : Text { text: "Новых уведомлений нет."; font_size: 13px; color: MaterialPalette.on_surface_variant; }
                    for n in root.items : Rectangle {
                        border_radius: 12px;
                        background: n.is_read ? MaterialPalette.surface_container : MaterialPalette.primary_container.with_alpha(55%);
                        HorizontalLayout {
                            padding: 10px; alignment: space-between; spacing: 8px;
                            VerticalLayout {
                                horizontal_stretch: 1; spacing: 2px;
                                Text { text: n.title; font_size: 13px; font_weight: 600; color: n.is_overdue ? OxidiumTheme.danger_color : MaterialPalette.on_surface; }
                                if n.body != "" : Text { text: n.body; font_size: 11px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }
                                Text { text: n.time_text; font_family: OxidiumTheme.font_mono; font_size: 10px; color: MaterialPalette.on_surface_variant; }
                            }
                            OxidiumIconButton { icon: OxidiumIcons.close; button_size: 32px; icon_size: 16px; tooltip: "Скрыть"; clicked => { root.dismiss_item(n.id); } }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Reusable M3 Expressive Settings Card & Fixed-Size Switch Row Helpers
// ============================================================================
component SettingsSectionCard inherits Rectangle {
    border_radius: 18px;
    background: MaterialPalette.surface_container;
    border_width: 1px;
    border_color: OxidiumTheme.cell_border;
}

component SettingsToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in_out property <bool> checked: false;
    callback toggled(bool);

    min_height: root.subtitle != "" ? 54px : 44px;
    border_radius: 12px;
    background: row_ta.has_hover ? MaterialPalette.surface_container_high.with_alpha(65%) : transparent;
    animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }

    row_ta := TouchArea {
        mouse_cursor: pointer;
        clicked => {
            root.checked = !root.checked;
        }
    }

    HorizontalLayout {
        padding_left: 8px;
        padding_right: 8px;
        padding_top: 6px;
        padding_bottom: 6px;
        spacing: 16px;
        alignment: space-between;

        VerticalLayout {
            horizontal_stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font_size: 13px;
                font_weight: 500;
                color: MaterialPalette.on_surface;
                wrap: word_wrap;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font_size: 11px;
                color: MaterialPalette.on_surface_variant;
                wrap: word_wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 52px;
            Switch {
                width: 52px;
                height: 32px;
                checked <=> root.checked;
                checked_state_changed(v) => { root.toggled(v); }
            }
        }
    }
}

// ============================================================================
// Settings & MCP Control Modal (6 Tabs: Appearance, Journal, Kanban, MCP, Data, About)
// ============================================================================
export component SettingsModal inherits Rectangle {
    in property <bool> open: false;
    in_out property <int> active_tab: 0; // 0=Appearance, 1=Journal, 2=Kanban, 3=MCP, 4=Data, 5=About
    in property <UiStrings> tr;

    // Appearance settings
    in_out property <int> theme_mode_idx: 2; // 0=Light, 1=Dark, 2=System
    in_out property <int> lang_idx: 0; // 0=Ru, 1=En
    in_out property <string> accent_hex: "#445E91";
    in_out property <bool> compact_mode: false;
    in_out property <bool> reduced_motion: false;
    in_out property <int> scale_percent: 100;

    // Journal settings
    in_out property <int> avg_mode_idx: 0; // 0=Arithmetic, 1=Weighted
    in_out property <int> avg_precision_idx: 1; // 0=1dp, 1=2dp, 2=3dp
    in_out property <int> week_start_idx: 0; // 0=Monday, 1=Sunday
    in_out property <bool> highlight_weekends: true;
    in_out property <bool> highlight_holidays: true;

    // Kanban & Reminders
    in_out property <bool> reminders_enabled: true;
    in_out property <bool> os_notifications_enabled: true;

    // MCP Server panel state
    in property <string> mcp_status_text: "Остановлен";
    in property <bool> mcp_http_running: false;
    in property <string> mcp_endpoint: "http://127.0.0.1:38421/mcp";
    in_out property <string> mcp_port_text: "38421";
    in_out property <bool> mcp_autostart: false;
    in_out property <int> mcp_permission_idx: 1; // 0=ReadOnly, 1=ReadWrite
    in_out property <bool> mcp_allow_destructive: false;
    in property <string> mcp_requests_text: "0";
    in property <string> mcp_errors_text: "0";
    in property <string> mcp_last_request_text: "—";
    in property <string> mcp_token_preview: "не создан";
    in property <string> mcp_stdio_config_preview: "";
    in property <[ActivityRowItem]> activity_log;

    // Data & About
    in property <string> db_path_text: "";
    in property <string> backup_status_text: "";
    in property <string> about_versions_text: "";

    // Dynamic Updates (GitHub Releases)
    in_out property <bool> auto_check_updates: true;
    in property <bool> update_available: false;
    in property <bool> update_checking: false;
    in property <string> update_latest_version: "";
    in property <string> update_status_text: "";

    callback close();
    callback save_appearance(int, int, string, bool, bool, int);
    callback save_journal_prefs(int, int, int, bool, bool);
    callback save_kanban_prefs(bool, bool);
    callback save_mcp_prefs(string, bool, int, bool);
    callback mcp_start_http();
    callback mcp_stop_http();
    callback mcp_restart_http();
    callback mcp_rotate_token();
    callback mcp_undo_activity(string);
    callback trigger_backup();
    callback trigger_restore();
    callback export_data(string); // json, csv, xlsx, md
    callback import_data(string); // json, csv, telegram
    callback open_onboarding();
    callback toggle_auto_updates(bool);
    callback check_updates();
    callback open_update_modal();
    callback open_releases_page();

    width: 100%; height: 100%;
    background: #00000055;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    settings_card := Rectangle {
        width: min(920px, parent.width - 28px);
        height: min(660px, parent.height - 28px);
        x: (parent.width - self.width) / 2;
        y: root.open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 26px);
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 24px; background: MaterialPalette.surface_container_high;
        border_width: 1px; border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 32px; drop_shadow_color: #00000060;
        clip: true;
        TouchArea {}

        HorizontalLayout {
            // Left Settings Sidebar
            Rectangle {
                width: settings_card.width < 760px ? 158px : 204px;
                background: MaterialPalette.surface_container;
                VerticalLayout {
                    padding: 14px; spacing: 6px;
                    Text { text: "Настройки"; font_size: 18px; font_weight: 700; color: MaterialPalette.on_surface; }
                    Rectangle { height: 6px; }
                    for tab_label[idx] in ["Внешний вид", "Журнал", "Канбан и уведомления", "MCP-сервер", "Данные и бэкапы", "О приложении"] : Rectangle {
                        height: 38px;
                        border_radius: root.active_tab == idx ? 10px : 14px;
                        background: root.active_tab == idx ? MaterialPalette.secondary_container
                            : tab_ta.has_hover ? MaterialPalette.surface_container_high : transparent;
                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                        animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                        HorizontalLayout {
                            padding_left: 12px; padding_right: 12px;
                            Text {
                                text: tab_label; font_size: 13px;
                                font_weight: root.active_tab == idx ? 600 : 400;
                                color: root.active_tab == idx ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                                vertical_alignment: center;
                                overflow: elide;
                            }
                        }
                        tab_ta := TouchArea { mouse_cursor: pointer; clicked => { root.active_tab = idx; } }
                    }
                    Rectangle { vertical_stretch: 1; }
                    OutlineButton { text: "Закрыть (Esc)"; height: 40px; clicked => { root.close(); } }
                }
            }

            // Right Settings Content
            ScrollView {
                horizontal_stretch: 1;
                viewport_width: self.visible_width;
                viewport_height: max(self.visible_height, settings_scroll_body.preferred_height);
                settings_scroll_body := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.visible_width;
                    padding: 22px; spacing: 14px;
                    alignment: start;

                    // TAB 0: APPEARANCE
                    if root.active_tab == 0 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text { text: "Внешний вид и язык"; font_family: OxidiumTheme.font_display; font_size: 18px; font_weight: 600; color: MaterialPalette.on_surface; }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 10px; alignment: start;
                                Text { text: "Тема оформления"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for th[idx] in ["Светлая", "Тёмная", "Системная"] : Rectangle {
                                        horizontal_stretch: 1; height: 38px;
                                        border_radius: root.theme_mode_idx == idx ? 9px : 12px;
                                        background: root.theme_mode_idx == idx ? MaterialPalette.primary_container
                                            : th_ta.has_hover ? MaterialPalette.surface_container_high : MaterialPalette.surface;
                                        border_width: 1px; border_color: root.theme_mode_idx == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                        Text { text: th; font_size: 13px; font_weight: 600; color: root.theme_mode_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; horizontal_alignment: center; vertical_alignment: center; }
                                        th_ta := TouchArea { mouse_cursor: pointer; clicked => { root.theme_mode_idx = idx; } }
                                    }
                                }

                                Text { text: "Язык интерфейса"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for lg[idx] in ["Русский (основной)", "English"] : Rectangle {
                                        horizontal_stretch: 1; height: 38px;
                                        border_radius: root.lang_idx == idx ? 9px : 12px;
                                        background: root.lang_idx == idx ? MaterialPalette.primary_container
                                            : lg_ta.has_hover ? MaterialPalette.surface_container_high : MaterialPalette.surface;
                                        border_width: 1px; border_color: root.lang_idx == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                        Text { text: lg; font_size: 13px; font_weight: 600; color: root.lang_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; horizontal_alignment: center; vertical_alignment: center; }
                                        lg_ta := TouchArea { mouse_cursor: pointer; clicked => { root.lang_idx = idx; } }
                                    }
                                }

                                Text { text: "Акцентный цвет (Material Design 3)"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for swatch in [
                                        { hex: "#4A4459", c: #4A4459 },
                                        { hex: "#445E91", c: #445E91 },
                                        { hex: "#0F766E", c: #0F766E },
                                        { hex: "#2E7D32", c: #2E7D32 },
                                        { hex: "#4F46E5", c: #4F46E5 },
                                        { hex: "#B45309", c: #B45309 },
                                        { hex: "#9333EA", c: #9333EA },
                                        { hex: "#BE123C", c: #BE123C },
                                    ] : Rectangle {
                                        width: 34px; height: 34px;
                                        border_radius: root.accent_hex == swatch.hex ? 10px : 17px;
                                        background: swatch.c;
                                        border_width: root.accent_hex == swatch.hex ? 3px : (sw_ta.has_hover ? 2px : 0px);
                                        border_color: MaterialPalette.on_surface;
                                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate border_width { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                                        sw_ta := TouchArea { mouse_cursor: pointer; clicked => { root.accent_hex = swatch.hex; } }
                                    }
                                }
                            }
                        }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 12px; spacing: 6px; alignment: start;
                                SettingsToggleRow {
                                    title: "Компактный режим интерфейса";
                                    subtitle: "Уменьшает высоту строк таблицы и отступы карточек";
                                    checked <=> root.compact_mode;
                                }
                                SettingsToggleRow {
                                    title: "Уменьшить анимации";
                                    subtitle: "Отключает плавные переходы интерфейса и графиков";
                                    checked <=> root.reduced_motion;
                                }
                                HorizontalLayout {
                                    padding_left: 8px; padding_right: 8px; padding_top: 4px;
                                    spacing: 8px; alignment: space-between;
                                    Text { text: "Масштаб элементов"; font_size: 13px; font_weight: 500; color: MaterialPalette.on_surface; vertical_alignment: center; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        for sc in [90, 100, 110, 120] : Rectangle {
                                            width: 56px; height: 32px; border_radius: 10px;
                                            background: root.scale_percent == sc ? MaterialPalette.primary_container : MaterialPalette.surface;
                                            border_width: 1px;
                                            border_color: root.scale_percent == sc ? MaterialPalette.primary : OxidiumTheme.cell_border;
                                            animate background, border_color { duration: OxidiumTheme.anim_fast; }
                                            Text { text: sc + "%"; font_family: OxidiumTheme.font_mono; font_size: 12px; font_weight: 600; color: root.scale_percent == sc ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; horizontal_alignment: center; vertical_alignment: center; }
                                            TouchArea { mouse_cursor: pointer; clicked => { root.scale_percent = sc; } }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            FilledButton {
                                text: "Применить и сохранить";
                                height: 40px;
                                clicked => {
                                    root.save_appearance(root.theme_mode_idx, root.lang_idx, root.accent_hex, root.compact_mode, root.reduced_motion, root.scale_percent);
                                }
                            }
                            OutlineButton {
                                text: "Запустить мастер настройки";
                                height: 40px;
                                clicked => {
                                    root.close();
                                    root.open_onboarding();
                                }
                            }
                        }
                    }

                    // TAB 1: JOURNAL
                    if root.active_tab == 1 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text { text: "Настройки электронного журнала"; font_family: OxidiumTheme.font_display; font_size: 18px; font_weight: 600; color: MaterialPalette.on_surface; }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 10px; alignment: start;
                                Text { text: "Режим расчёта среднего балла"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for am[idx] in ["Арифметическое среднее", "Взвешенное (по весам работ)"] : Rectangle {
                                        horizontal_stretch: 1; height: 38px; border_radius: root.avg_mode_idx == idx ? 9px : 12px;
                                        background: root.avg_mode_idx == idx ? MaterialPalette.primary_container : MaterialPalette.surface;
                                        border_width: 1px; border_color: root.avg_mode_idx == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                        Text { text: am; font_size: 12px; font_weight: 600; color: root.avg_mode_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; horizontal_alignment: center; vertical_alignment: center; }
                                        TouchArea { mouse_cursor: pointer; clicked => { root.avg_mode_idx = idx; } }
                                    }
                                }

                                Text { text: "Точность отображения среднего балла (округление только при показе)"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for pr[idx] in ["1 знак (4.5)", "2 знака (4.50)", "3 знака (4.500)"] : Rectangle {
                                        horizontal_stretch: 1; height: 36px; border_radius: root.avg_precision_idx == idx ? 9px : 12px;
                                        background: root.avg_precision_idx == idx ? MaterialPalette.primary_container : MaterialPalette.surface;
                                        border_width: 1px; border_color: root.avg_precision_idx == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                        Text { text: pr; font_family: OxidiumTheme.font_mono; font_size: 12px; font_weight: 600; color: root.avg_precision_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; horizontal_alignment: center; vertical_alignment: center; }
                                        TouchArea { mouse_cursor: pointer; clicked => { root.avg_precision_idx = idx; } }
                                    }
                                }

                                Text { text: "Начало учебной недели"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for ws[idx] in ["Понедельник (Пн–Вс)", "Воскресенье (Вс–Сб)"] : Rectangle {
                                        horizontal_stretch: 1; height: 36px; border_radius: root.week_start_idx == idx ? 9px : 12px;
                                        background: root.week_start_idx == idx ? MaterialPalette.primary_container : MaterialPalette.surface;
                                        border_width: 1px; border_color: root.week_start_idx == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                                        animate border_radius { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                                        animate background, border_color { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                                        Text { text: ws; font_size: 12px; font_weight: 600; color: root.week_start_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; horizontal_alignment: center; vertical_alignment: center; }
                                        TouchArea { mouse_cursor: pointer; clicked => { root.week_start_idx = idx; } }
                                    }
                                }
                            }
                        }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 10px; spacing: 4px; alignment: start;
                                SettingsToggleRow {
                                    title: "Подсвечивать выходные дни";
                                    subtitle: "Мягкая тонировка субботы и воскресенья в сетке";
                                    checked <=> root.highlight_weekends;
                                }
                                SettingsToggleRow {
                                    title: "Подсвечивать праздничные дни";
                                    subtitle: "Отмечает календарные праздники и нерабочие даты";
                                    checked <=> root.highlight_holidays;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            FilledButton {
                                text: "Сохранить настройки журнала";
                                height: 40px;
                                clicked => {
                                    root.save_journal_prefs(root.avg_mode_idx, root.avg_precision_idx, root.week_start_idx, root.highlight_weekends, root.highlight_holidays);
                                }
                            }
                        }
                    }

                    // TAB 2: KANBAN & NOTIFICATIONS
                    if root.active_tab == 2 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text { text: "Канбан и уведомления"; font_family: OxidiumTheme.font_display; font_size: 18px; font_weight: 600; color: MaterialPalette.on_surface; }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 12px; spacing: 6px; alignment: start;
                                SettingsToggleRow {
                                    title: "Включить напоминания о дедлайнах";
                                    subtitle: "Учитывать сроки выполнения задач и уведомлять заранее";
                                    checked <=> root.reminders_enabled;
                                }
                                SettingsToggleRow {
                                    title: "Системные уведомления ОС (Windows / Linux)";
                                    subtitle: "Показывать нативные всплывающие уведомления системы";
                                    checked <=> root.os_notifications_enabled;
                                }
                            }
                        }

                        SettingsSectionCard {
                            HorizontalLayout {
                                padding: 14px; spacing: 10px; alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Icon { source: OxidiumIcons.notifications; width: 18px; height: 18px; colorize: MaterialPalette.primary; }
                                }
                                Text { horizontal_stretch: 1; text: root.tr.reminders_notice; font_size: 12px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; vertical_alignment: center; }
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            FilledButton {
                                text: "Сохранить";
                                height: 40px;
                                clicked => { root.save_kanban_prefs(root.reminders_enabled, root.os_notifications_enabled); }
                            }
                        }
                    }

                    // TAB 3: MCP SERVER MANAGEMENT & ACTIVITY LOG
                    if root.active_tab == 3 : VerticalLayout {
                        spacing: 12px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Встроенный MCP-сервер (Model Context Protocol)"; font_family: OxidiumTheme.font_display; font_size: 17px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                            Rectangle {
                                height: 28px; border_radius: 14px;
                                background: root.mcp_http_running ? OxidiumTheme.grade_5_bg : MaterialPalette.surface_container;
                                HorizontalLayout {
                                    padding_left: 12px; padding_right: 12px;
                                    Text {
                                        text: root.mcp_status_text;
                                        font_size: 12px; font_weight: 700;
                                        color: root.mcp_http_running ? OxidiumTheme.grade_5_fg : MaterialPalette.on_surface_variant;
                                        vertical_alignment: center;
                                    }
                                }
                            }
                        }

                        // Embedded Streamable HTTP Status & Controls (distinct from external STDIO!)
                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 8px; alignment: start;
                                Text { text: "Встроенный Streamable HTTP (только loopback 127.0.0.1)"; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                                Text {
                                    text: "Endpoint: " + root.mcp_endpoint + "  •  Запросов: " + root.mcp_requests_text + "  •  Ошибок: " + root.mcp_errors_text + "  •  Последний: " + root.mcp_last_request_text;
                                    font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant; wrap: word_wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: "Порт:"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; vertical_alignment: center; }
                                    Rectangle {
                                        width: 82px; height: 38px; border_radius: 10px; background: MaterialPalette.surface; border_width: 1px; border_color: MaterialPalette.outline_variant;
                                        TextInput { x: 10px; width: parent.width - 20px; height: 100%; vertical_alignment: center; text <=> root.mcp_port_text; font_family: OxidiumTheme.font_mono; color: MaterialPalette.on_surface; }
                                    }
                                    if !root.mcp_http_running : FilledButton { text: "Запустить HTTP"; height: 38px; icon: OxidiumIcons.play; clicked => { root.mcp_start_http(); } }
                                    if root.mcp_http_running : OutlineButton { text: "Остановить"; height: 38px; icon: OxidiumIcons.stop; clicked => { root.mcp_stop_http(); } }
                                    if root.mcp_http_running : TonalButton { text: "Перезапустить"; height: 38px; icon: OxidiumIcons.refresh; clicked => { root.mcp_restart_http(); } }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: space-between;
                                    Text {
                                        horizontal_stretch: 1;
                                        text: "Bearer токен: " + root.mcp_token_preview + " (хранится в mcp-token.secret, вне SQLite и Git)";
                                        font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant;
                                        wrap: word_wrap; vertical_alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        TonalButton { text: "Перевыпустить токен"; height: 36px; icon: OxidiumIcons.lock; clicked => { root.mcp_rotate_token(); } }
                                    }
                                }
                            }
                        }

                        // Permissions (enforced server-side in Rust)
                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 8px; alignment: start;
                                Text { text: "Права доступа AI (контролируются на сервере Rust)"; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for pm[idx] in ["Только чтение (Read-Only)", "Чтение и запись (Read+Write)"] : Rectangle {
                                        horizontal_stretch: 1; height: 36px; border_radius: 10px;
                                        background: root.mcp_permission_idx == idx ? MaterialPalette.primary_container : MaterialPalette.surface;
                                        border_width: 1px; border_color: root.mcp_permission_idx == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                                        animate background, border_color { duration: OxidiumTheme.anim_fast; }
                                        Text { text: pm; font_size: 12px; font_weight: 600; color: root.mcp_permission_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface; horizontal_alignment: center; vertical_alignment: center; }
                                        TouchArea { mouse_cursor: pointer; clicked => { root.mcp_permission_idx = idx; } }
                                    }
                                }
                                SettingsToggleRow {
                                    title: "Разрешить деструктивные действия (удаление записей AI)";
                                    checked <=> root.mcp_allow_destructive;
                                }
                                SettingsToggleRow {
                                    title: "Автозапуск встроенного HTTP MCP при старте Oxidium";
                                    checked <=> root.mcp_autostart;
                                }
                                Text { text: root.tr.mcp_privacy_notice; font_size: 11px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }
                                HorizontalLayout {
                                    alignment: start;
                                    FilledButton {
                                        text: "Сохранить права MCP";
                                        height: 40px;
                                        clicked => { root.save_mcp_prefs(root.mcp_port_text, root.mcp_autostart, root.mcp_permission_idx, root.mcp_allow_destructive); }
                                    }
                                }
                            }
                        }

                        // External STDIO snippet (selectable via Ctrl+A/Ctrl+C, honestly separated from embedded HTTP)
                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 12px; spacing: 6px; alignment: start;
                                Text { text: "Внешний STDIO-процесс (запускается AI-клиентом, например Claude Desktop / Gemini CLI)"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface; wrap: word_wrap; }
                                Rectangle {
                                    height: 32px; border_radius: 8px; background: MaterialPalette.surface; border_width: 1px; border_color: OxidiumTheme.cell_border;
                                    TextInput {
                                        x: 8px; width: parent.width - 16px; height: 100%;
                                        text: root.mcp_stdio_config_preview;
                                        read_only: true;
                                        font_family: OxidiumTheme.font_mono; font_size: 10px;
                                        color: MaterialPalette.on_surface_variant;
                                        vertical_alignment: center;
                                    }
                                }
                            }
                        }

                        // Live MCP Activity Log with Undo
                        Text { text: "История действий AI (MCP Activity Log)"; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                        for act in root.activity_log : Rectangle {
                            border_radius: 12px; background: MaterialPalette.surface_container;
                            HorizontalLayout {
                                padding: 10px; alignment: space-between; spacing: 8px;
                                Text {
                                    horizontal_stretch: 1;
                                    text: act.time_text + " [" + act.source_label + "] " + act.summary + (act.undone ? " (отменено)" : "");
                                    font_size: 12px; color: act.undone ? MaterialPalette.on_surface_variant : MaterialPalette.on_surface;
                                    wrap: word_wrap; vertical_alignment: center;
                                }
                                if act.can_undo && !act.undone : VerticalLayout {
                                    alignment: center;
                                    TonalButton {
                                        text: "Отменить";
                                        height: 34px;
                                        clicked => { root.mcp_undo_activity(act.id); }
                                    }
                                }
                            }
                        }
                    }

                    // TAB 4: DATA, BACKUP, IMPORT & EXPORT
                    if root.active_tab == 4 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text { text: "Данные, резервное копирование и импорт/экспорт"; font_family: OxidiumTheme.font_display; font_size: 18px; font_weight: 600; color: MaterialPalette.on_surface; }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 10px; alignment: start;
                                Text { text: "База данных SQLite (WAL + FTS5)"; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                                Text { text: root.db_path_text; font_family: OxidiumTheme.font_mono; font_size: 11px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    FilledButton { text: "Создать резервную копию (.zip)"; height: 40px; icon: OxidiumIcons.backup; clicked => { root.trigger_backup(); } }
                                    OutlineButton { text: "Восстановить из архива"; height: 40px; icon: OxidiumIcons.restore; clicked => { root.trigger_restore(); } }
                                }
                            }
                        }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 10px; alignment: start;
                                Text { text: "Экспорт активного профиля"; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    TonalButton { text: "JSON"; height: 38px; icon: OxidiumIcons.download; clicked => { root.export_data("json"); } }
                                    TonalButton { text: "CSV (оценки)"; height: 38px; icon: OxidiumIcons.download; clicked => { root.export_data("csv"); } }
                                    TonalButton { text: "XLSX (Excel)"; height: 38px; icon: OxidiumIcons.download; clicked => { root.export_data("xlsx"); } }
                                    TonalButton { text: "Markdown"; height: 38px; icon: OxidiumIcons.download; clicked => { root.export_data("md"); } }
                                }
                            }
                        }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 10px; alignment: start;
                                Text { text: "Импорт (с проверкой и предпросмотром)"; font_size: 13px; font_weight: 600; color: MaterialPalette.on_surface; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    OutlineButton { text: "Импорт JSON"; height: 38px; icon: OxidiumIcons.upload; clicked => { root.import_data("json"); } }
                                    OutlineButton { text: "Импорт CSV"; height: 38px; icon: OxidiumIcons.upload; clicked => { root.import_data("csv"); } }
                                    OutlineButton { text: "Предпросмотр Telegram export"; height: 38px; icon: OxidiumIcons.upload; clicked => { root.import_data("telegram"); } }
                                }
                            }
                        }

                        if root.backup_status_text != "" : Rectangle {
                            border_radius: 12px; background: MaterialPalette.secondary_container;
                            HorizontalLayout {
                                padding: 12px;
                                Text { text: root.backup_status_text; font_size: 12px; color: MaterialPalette.on_secondary_container; wrap: word_wrap; }
                            }
                        }
                    }

                    // TAB 5: ABOUT
                    if root.active_tab == 5 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 14px;
                            Image { source: OxidiumIcons.app_logo; width: 56px; height: 56px; image_fit: contain; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: "Oxidium — Электронный журнал ученика"; font_family: OxidiumTheme.font_display; font_size: 18px; font_weight: 700; color: MaterialPalette.on_surface; }
                                Text { text: "Бесплатное open-source, local-first, offline-first приложение без рекламы и телеметрии."; font_size: 12px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }
                            }
                        }

                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 6px; alignment: start;
                                Text { text: root.about_versions_text; font_family: OxidiumTheme.font_mono; font_size: 12px; color: MaterialPalette.on_surface; wrap: word_wrap; }
                                Text { text: "Репозиторий: https://github.com/cryals/Oxidium"; font_family: OxidiumTheme.font_mono; font_size: 12px; color: MaterialPalette.primary; }
                                Text { text: "Лицензия кода Oxidium: MIT. Включает Slint UI Toolkit, Material Components (MIT), Google Fonts Roboto/Roboto Flex/Roboto Mono (SIL OFL 1.1), Material Symbols (Apache 2.0), SQLite (Public Domain), rmcp (Apache 2.0)."; font_size: 11px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }
                            }
                        }

                        // Dynamic Semi-Automatic Updates Card (GitHub Releases)
                        SettingsSectionCard {
                            VerticalLayout {
                                padding: 14px; spacing: 10px; alignment: start;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: "Обновления (GitHub Releases)"; font_size: 14px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                                    if root.update_available : Rectangle {
                                        height: 26px; border_radius: 13px;
                                        background: OxidiumTheme.grade_5_bg;
                                        HorizontalLayout {
                                            padding_left: 10px; padding_right: 10px;
                                            Text {
                                                text: "Доступна " + root.update_latest_version;
                                                font_family: OxidiumTheme.font_mono; font_size: 11px; font_weight: 700;
                                                color: OxidiumTheme.grade_5_fg; vertical_alignment: center;
                                            }
                                        }
                                    }
                                }
                                SettingsToggleRow {
                                    title: "Проверять наличие новых версий при запуске";
                                    subtitle: "Источник: github.com/cryals/Oxidium/releases (без телеметрии, работает офлайн)";
                                    checked <=> root.auto_check_updates;
                                    toggled(v) => { root.toggle_auto_updates(v); }
                                }
                                if root.update_status_text != "" : Text {
                                    text: root.update_status_text;
                                    font_size: 12px;
                                    color: root.update_available ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
                                    wrap: word_wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    TonalButton {
                                        text: root.update_checking ? "Проверка..." : "Проверить обновления";
                                        height: 40px;
                                        icon: OxidiumIcons.refresh;
                                        enabled: !root.update_checking;
                                        clicked => { root.check_updates(); }
                                    }
                                    if root.update_available : FilledButton {
                                        text: "Обновить до " + root.update_latest_version;
                                        height: 40px;
                                        icon: OxidiumIcons.download;
                                        clicked => {
                                            root.close();
                                            root.open_update_modal();
                                        }
                                    }
                                    OutlineButton {
                                        text: "Открыть релизы GitHub";
                                        height: 40px;
                                        clicked => { root.open_releases_page(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Keyboard Shortcuts Reference Modal
// ============================================================================
export component ShortcutsModal inherits Rectangle {
    in property <bool> open: false;
    callback close();
    width: 100%; height: 100%; background: #00000050;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }
    Rectangle {
        width: min(460px, parent.width - 28px);
        height: min(parent.height - 28px, shortcuts_col.preferred_height);
        x: (parent.width - self.width) / 2;
        y: root.open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 24px);
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 22px; background: MaterialPalette.surface_container_high;
        border_width: 1px; border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 28px; drop_shadow_color: #00000055;
        TouchArea {}
        shortcuts_col := VerticalLayout {
            padding: 20px; spacing: 8px; alignment: start;
            HorizontalLayout {
                height: 40px;
                alignment: space-between;
                Text { text: "Горячие клавиши"; font_size: 17px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                OxidiumIconButton { icon: OxidiumIcons.close; tooltip: "Закрыть"; clicked => { root.close(); } }
            }
            for sc in [
                { k: "Ctrl + 1 / 2 / 3", d: "Журнал / Статистика / Канбан" },
                { k: "Ctrl + N", d: "Создать предмет или задачу в контексте" },
                { k: "Ctrl + F", d: "Глобальный поиск" },
                { k: "Ctrl + Z / Ctrl + Shift + Z", d: "Отмена / Повтор действия" },
                { k: "Ctrl + ,", d: "Открыть настройки" },
                { k: "Стрелки / Enter", d: "Навигация по таблице / Редактирование ячейки" },
                { k: "Цифры 1 – 5", d: "Быстрый ввод оценки в активной ячейке" },
                { k: "Delete / Escape", d: "Удалить выбранное / Закрыть диалог" },
            ] : HorizontalLayout {
                height: 28px;
                alignment: space-between;
                spacing: 8px;
                Text { horizontal_stretch: 1; text: sc.d; font_size: 12px; color: MaterialPalette.on_surface; vertical_alignment: center; overflow: elide; }
                Rectangle {
                    height: 24px; border_radius: 6px; background: MaterialPalette.surface_container;
                    HorizontalLayout {
                        padding_left: 8px; padding_right: 8px;
                        Text { text: sc.k; font_family: OxidiumTheme.font_mono; font_size: 11px; font_weight: 600; color: MaterialPalette.primary; vertical_alignment: center; }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Quick Profile Switcher Popover (Stitch A01 — bottom-left next to rail)
// ============================================================================
export component QuickProfilePopover inherits Rectangle {
    in property <bool> open: false;
    in property <[ProfileItem]> profiles;
    in property <length> rail_width: 88px;
    callback close();
    callback switch_profile(string);
    callback open_full_manager();

    width: 100%; height: 100%;
    background: #00000028;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    Rectangle {
        width: min(310px, parent.width - root.rail_width - 24px);
        height: min(parent.height - 32px, qp_layout.preferred_height + 4px);
        x: root.open ? (root.rail_width + 12px) : (root.rail_width - 8px);
        y: root.open ? max(16px, parent.height - self.height - 18px) : max(16px, parent.height - self.height);
        animate x, y { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
        border_radius: 24px;
        background: MaterialPalette.surface_container_high;
        border_width: 1px;
        border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 24px;
        drop_shadow_color: #00000050;
        TouchArea {}

        qp_layout := VerticalLayout {
            padding: 14px;
            spacing: 8px;
            alignment: start;

            HorizontalLayout {
                height: 36px;
                alignment: space-between;
                Text {
                    text: "Учебные профили";
                    font_size: 12px;
                    font_weight: 600;
                    color: MaterialPalette.on_surface_variant;
                    vertical_alignment: center;
                }
                OxidiumIconButton { icon: OxidiumIcons.close; button_size: 32px; icon_size: 16px; tooltip: "Закрыть"; clicked => { root.close(); } }
            }

            for p in root.profiles : Rectangle {
                height: 50px;
                border_radius: 14px;
                background: p.is_active ? MaterialPalette.secondary_container : p_ta.has_hover ? MaterialPalette.surface_container_highest : transparent;
                animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }

                // Row TouchArea goes BEFORE foreground children so > button receives clicks directly
                p_ta := TouchArea {
                    mouse_cursor: pointer;
                    clicked => {
                        if (!p.is_active) {
                            root.switch_profile(p.id);
                        } else {
                            root.open_full_manager();
                        }
                        root.close();
                    }
                }

                HorizontalLayout {
                    padding_left: 10px;
                    padding_right: 8px;
                    spacing: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        horizontal_stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 34px; height: 34px; border_radius: 17px;
                                background: p.is_active ? MaterialPalette.primary : MaterialPalette.tertiary_container;
                                Text {
                                    text: p.initials;
                                    font_family: OxidiumTheme.font_display;
                                    font_size: 12px; font_weight: 700;
                                    color: p.is_active ? MaterialPalette.on_primary : MaterialPalette.on_tertiary_container;
                                    horizontal_alignment: center; vertical_alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal_stretch: 1;
                            Text {
                                text: p.name;
                                font_size: 13px; font_weight: 600;
                                color: p.is_active ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                                overflow: elide;
                            }
                            if p.institution != "" || p.group_name != "" : Text {
                                text: p.institution + (p.institution != "" && p.group_name != "" ? " · " : "") + p.group_name;
                                font_size: 11px;
                                color: MaterialPalette.on_surface_variant;
                                overflow: elide;
                            }
                        }
                    }

                    if p.is_active : VerticalLayout {
                        alignment: center;
                        OxidiumIconButton {
                            icon: OxidiumIcons.chevron_right;
                            button_size: 32px; icon_size: 18px;
                            tooltip: "Редактировать профили";
                            clicked => {
                                root.close();
                                root.open_full_manager();
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: MaterialPalette.outline_variant; }

            Rectangle {
                height: 38px;
                border_radius: 12px;
                background: addp_ta.has_hover ? MaterialPalette.surface_container_highest : transparent;
                animate background { duration: OxidiumTheme.dur_effects_fast; easing: OxidiumMotion.expressive_fast_effects; }
                HorizontalLayout {
                    padding_left: 10px; padding_right: 10px; spacing: 8px;
                    VerticalLayout { alignment: center; Icon { source: OxidiumIcons.add; width: 18px; height: 18px; colorize: MaterialPalette.primary; } }
                    Text { text: "Управление и добавление профилей"; font_size: 12px; font_weight: 600; color: MaterialPalette.primary; vertical_alignment: center; }
                }
                addp_ta := TouchArea {
                    mouse_cursor: pointer;
                    clicked => {
                        root.close();
                        root.open_full_manager();
                    }
                }
            }
        }
    }
}

// ============================================================================
// 4-Step Expressive Setup Wizard (Stitch E06 — Welcome, Profile, Subjects, MCP)
// ============================================================================
export component OnboardingModal inherits Rectangle {
    in property <bool> open: false;
    in_out property <int> step: 1; // 1..4
    in_out property <string> profile_name: "Основной профиль";
    in_out property <string> institution: "";
    in_out property <string> group_name: "";
    in_out property <string> subjects_csv: "";
    in_out property <string> new_subject_draft: "";
    in_out property <bool> mcp_enable_http: false;
    in_out property <bool> mcp_autostart: false;
    in_out property <int> mcp_access_idx: 1; // 0=ReadOnly, 1=ReadWrite, 2=Full+Delete

    callback close();
    callback toggle_theme();
    callback add_subject_chip(string, string) -> string;
    callback complete(string, string, string, string, bool, bool, int);

    width: 100%; height: 100%;
    background: #00000066;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { OxidiumTooltipState.shown = false; root.close(); } }

    Rectangle {
        width: min(680px, parent.width - 28px);
        height: min(560px, parent.height - 28px);
        x: (parent.width - self.width) / 2;
        y: root.open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 26px);
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 28px;
        background: MaterialPalette.surface_container_low;
        border_width: 1px;
        border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 32px;
        drop_shadow_color: #00000060;
        TouchArea {}

        VerticalLayout {
            padding: 28px;
            spacing: 20px;

            // Top Brand + Expressive 4-Step Progress Dots + Theme Toggle
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 34px; height: 34px; border_radius: 10px;
                        background: MaterialPalette.primary_container;
                        Image { source: OxidiumIcons.app_logo; width: 22px; height: 22px; x: 6px; y: 6px; image_fit: contain; }
                    }
                    Text { text: "Oxidium"; font_family: OxidiumTheme.font_display; font_size: 16px; font_weight: 600; color: MaterialPalette.on_surface; vertical_alignment: center; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    for s in [1, 2, 3, 4] : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: root.step == s ? 30px : 10px;
                            height: 10px;
                            border_radius: 5px;
                            background: root.step == s ? MaterialPalette.primary : MaterialPalette.surface_container_highest;
                            animate width { duration: OxidiumTheme.dur_spatial_fast; easing: OxidiumMotion.expressive_fast_spatial; }
                            animate background { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    OxidiumIconButton {
                        icon: OxidiumTheme.dark_mode ? OxidiumIcons.light_mode : OxidiumIcons.dark_mode;
                        tooltip: "Переключить тему";
                        clicked => { root.toggle_theme(); }
                    }
                    OxidiumIconButton {
                        icon: OxidiumIcons.close;
                        tooltip: "Закрыть";
                        clicked => { root.close(); }
                    }
                }
            }

            // STEP 1: Welcome
            if root.step == 1 : VerticalLayout {
                vertical_stretch: 1;
                alignment: center;
                spacing: 18px;

                Text {
                    text: "Здравствуйте! Давайте настроим всё по-вашему";
                    font_family: OxidiumTheme.font_display;
                    font_size: 26px;
                    font_weight: 600;
                    color: MaterialPalette.on_surface;
                    horizontal_alignment: center;
                    wrap: word_wrap;
                }
                Text {
                    text: "Личный учебный журнал, статистика и канбан-доска без регистрации, рекламы и облака. Быстрая настройка займёт меньше минуты.";
                    font_size: 15px;
                    color: MaterialPalette.on_surface_variant;
                    horizontal_alignment: center;
                    wrap: word_wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    padding_top: 8px;
                    Rectangle {
                        width: 72px; height: 72px; border_radius: 36px;
                        background: MaterialPalette.primary;
                        Icon { source: OxidiumIcons.arrow_forward; width: 30px; height: 30px; colorize: MaterialPalette.on_primary; }
                        TouchArea { mouse_cursor: pointer; clicked => { root.step = 2; } }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    OutlineButton { text: "Пропустить"; height: 40px; clicked => { root.close(); } }
                }
            }

            // STEP 2: Profile Details
            if root.step == 2 : VerticalLayout {
                vertical_stretch: 1;
                spacing: 14px;

                Text { text: "Шаг 2 из 4"; font_size: 12px; font_weight: 600; color: MaterialPalette.primary; }
                Text { text: "Ваш учебный профиль"; font_family: OxidiumTheme.font_display; font_size: 24px; font_weight: 600; color: MaterialPalette.on_surface; }
                Text { text: "Укажите название профиля, учебное заведение и группу — их можно изменить в любой момент."; font_size: 13px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Название профиля"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                    Rectangle {
                        height: 42px; border_radius: 12px; background: MaterialPalette.surface_container; border_width: 1px; border_color: MaterialPalette.outline_variant;
                        TextInput { x: 12px; width: parent.width - 24px; height: 100%; vertical_alignment: center; text <=> root.profile_name; color: MaterialPalette.on_surface; }
                        if root.profile_name == "" : Text { x: 12px; height: 100%; text: "Например: Основной профиль"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal_stretch: 1; spacing: 4px;
                        Text { text: "ВУЗ / Колледж / Школа"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 42px; border_radius: 12px; background: MaterialPalette.surface_container; border_width: 1px; border_color: MaterialPalette.outline_variant;
                            TextInput { x: 12px; width: parent.width - 24px; height: 100%; vertical_alignment: center; text <=> root.institution; color: MaterialPalette.on_surface; }
                            if root.institution == "" : Text { x: 12px; height: 100%; text: "Например: МГТУ / Лицей №1"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                        }
                    }
                    VerticalLayout {
                        horizontal_stretch: 1; spacing: 4px;
                        Text { text: "Группа / Класс"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                        Rectangle {
                            height: 42px; border_radius: 12px; background: MaterialPalette.surface_container; border_width: 1px; border_color: MaterialPalette.outline_variant;
                            TextInput { x: 12px; width: parent.width - 24px; height: 100%; vertical_alignment: center; text <=> root.group_name; color: MaterialPalette.on_surface; }
                            if root.group_name == "" : Text { x: 12px; height: 100%; text: "Например: ИУ7-31Б / 11А"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                        }
                    }
                }

                Rectangle { vertical_stretch: 1; }

                HorizontalLayout {
                    alignment: space-between;
                    OutlineButton { text: "Назад"; height: 40px; clicked => { root.step = 1; } }
                    FilledButton { text: "Далее"; height: 40px; icon: OxidiumIcons.arrow_forward; clicked => { root.step = 3; } }
                }
            }

            // STEP 3: Subjects Quick Picker
            if root.step == 3 : VerticalLayout {
                vertical_stretch: 1;
                spacing: 14px;

                Text { text: "Шаг 3 из 4"; font_size: 12px; font_weight: 600; color: MaterialPalette.primary; }
                Text { text: "Список предметов"; font_family: OxidiumTheme.font_display; font_size: 24px; font_weight: 600; color: MaterialPalette.on_surface; }
                Text { text: "Введите свои предметы через запятую или добавьте популярные дисциплины одним нажатием."; font_size: 13px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }

                HorizontalLayout {
                    spacing: 8px;
                    for tpl in ["Математика", "Программирование", "Базы данных", "Английский язык", "Философия"] : Rectangle {
                        height: 32px; border_radius: 16px;
                        background: MaterialPalette.secondary_container;
                        HorizontalLayout {
                            padding_left: 12px; padding_right: 12px;
                            Text { text: "+ " + tpl; font_size: 12px; font_weight: 600; color: MaterialPalette.on_secondary_container; vertical_alignment: center; }
                        }
                        TouchArea {
                            mouse_cursor: pointer;
                            clicked => {
                                root.subjects_csv = root.add_subject_chip(root.subjects_csv, tpl);
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Предметы для добавления (через запятую)"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                    Rectangle {
                        height: 44px; border_radius: 12px; background: MaterialPalette.surface_container; border_width: 1px; border_color: MaterialPalette.outline_variant;
                        TextInput { x: 12px; width: parent.width - 24px; height: 100%; vertical_alignment: center; text <=> root.subjects_csv; color: MaterialPalette.on_surface; }
                        if root.subjects_csv == "" : Text { x: 12px; height: 100%; text: "Например: Математика, Физика, Программирование"; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal_stretch: 1; height: 40px; border_radius: 12px; background: MaterialPalette.surface_container; border_width: 1px; border_color: MaterialPalette.outline_variant;
                        TextInput { x: 12px; width: parent.width - 24px; height: 100%; vertical_alignment: center; text <=> root.new_subject_draft; color: MaterialPalette.on_surface; }
                        if root.new_subject_draft == "" : Text { x: 12px; height: 100%; text: "Свой предмет..."; font_size: 12px; color: MaterialPalette.on_surface_variant.with_alpha(65%); vertical_alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        TonalButton {
                            text: "Добавить";
                            height: 40px;
                            clicked => {
                                if (root.new_subject_draft != "") {
                                    root.subjects_csv = root.add_subject_chip(root.subjects_csv, root.new_subject_draft);
                                    root.new_subject_draft = "";
                                }
                            }
                        }
                    }
                }

                Rectangle { vertical_stretch: 1; }

                HorizontalLayout {
                    alignment: space-between;
                    OutlineButton { text: "Назад"; height: 40px; clicked => { root.step = 2; } }
                    FilledButton { text: "Далее"; height: 40px; icon: OxidiumIcons.arrow_forward; clicked => { root.step = 4; } }
                }
            }

            // STEP 4: MCP & AI Data Permissions
            if root.step == 4 : VerticalLayout {
                vertical_stretch: 1;
                spacing: 12px;

                Text { text: "Шаг 4 из 4"; font_size: 12px; font_weight: 600; color: MaterialPalette.primary; }
                Text { text: "MCP и доступ для ИИ"; font_family: OxidiumTheme.font_display; font_size: 24px; font_weight: 600; color: MaterialPalette.on_surface; }
                Text { text: "Локальный MCP-сервер (только 127.0.0.1 + Bearer-токен) позволяет AI-ассистенту вести журнал на естественном языке."; font_size: 13px; color: MaterialPalette.on_surface_variant; wrap: word_wrap; }

                Rectangle {
                    border_radius: 16px; background: MaterialPalette.surface_container;
                    VerticalLayout {
                        padding: 12px; spacing: 6px; alignment: start;
                        SettingsToggleRow {
                            title: "Запустить встроенный HTTP MCP сейчас";
                            subtitle: "Локальный доступ по 127.0.0.1:38421";
                            checked <=> root.mcp_enable_http;
                        }
                        SettingsToggleRow {
                            title: "Автозапуск при открытии Oxidium";
                            subtitle: "Поднимать локальный сервер автоматически";
                            checked <=> root.mcp_autostart;
                        }
                    }
                }

                Text { text: "Права доступа для AI-ассистента"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                HorizontalLayout {
                    spacing: 8px;
                    for perm[idx] in ["Только чтение", "Чтение и добавление", "Полный доступ (с удалением)"] : Rectangle {
                        horizontal_stretch: 1; height: 42px; border_radius: 12px;
                        background: root.mcp_access_idx == idx ? MaterialPalette.primary_container : MaterialPalette.surface_container;
                        border_width: 1px; border_color: root.mcp_access_idx == idx ? MaterialPalette.primary : MaterialPalette.outline_variant;
                        animate background, border_color { duration: OxidiumTheme.anim_fast; easing: OxidiumMotion.ease_emphasized; }
                        Text {
                            text: perm; font_size: 11px; font_weight: 600;
                            color: root.mcp_access_idx == idx ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
                            horizontal_alignment: center; vertical_alignment: center; wrap: word_wrap;
                        }
                        TouchArea { mouse_cursor: pointer; clicked => { root.mcp_access_idx = idx; } }
                    }
                }

                Rectangle { vertical_stretch: 1; }

                HorizontalLayout {
                    alignment: space-between;
                    OutlineButton { text: "Назад"; height: 40px; clicked => { root.step = 3; } }
                    FilledButton {
                        text: "Открыть журнал";
                        height: 40px;
                        icon: OxidiumIcons.check;
                        clicked => {
                            root.complete(
                                root.profile_name,
                                root.institution,
                                root.group_name,
                                root.subjects_csv,
                                root.mcp_enable_http,
                                root.mcp_autostart,
                                root.mcp_access_idx
                            );
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Dynamic Semi-Automatic Update Modal (GitHub Releases)
// ============================================================================
export component UpdateModal inherits Rectangle {
    in property <bool> open: false;
    in property <string> current_version: "v0.1.4";
    in property <string> latest_version: "";
    in property <string> release_name: "";
    in property <string> published_at: "";
    in property <string> release_notes: "";
    in property <string> asset_label: "";
    in property <string> sha256_label: "";
    in property <string> status_text: "";
    in property <bool> downloading: false;
    in property <bool> has_asset: false;

    callback close();
    callback download_and_install();
    callback open_releases_page();

    width: 100%; height: 100%;
    background: #00000060;
    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: OxidiumTheme.dur_effects_default; easing: OxidiumMotion.expressive_default_effects; }
    TouchArea { enabled: root.open; clicked => { if (!root.downloading) { OxidiumTooltipState.shown = false; root.close(); } } }

    Rectangle {
        width: min(600px, parent.width - 28px);
        height: min(490px, parent.height - 28px);
        x: (parent.width - self.width) / 2;
        y: root.open ? ((parent.height - self.height) / 2) : ((parent.height - self.height) / 2 + 26px);
        animate y { duration: OxidiumTheme.dur_spatial_default; easing: OxidiumMotion.expressive_default_spatial; }
        border_radius: 26px;
        background: MaterialPalette.surface_container_high;
        border_width: 1px;
        border_color: MaterialPalette.outline_variant;
        drop_shadow_blur: 32px;
        drop_shadow_color: #00000060;
        TouchArea {}

        VerticalLayout {
            padding: 24px;
            spacing: 14px;

            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 42px; height: 42px; border_radius: 14px;
                        background: MaterialPalette.primary_container;
                        Icon { source: OxidiumIcons.download; width: 22px; height: 22px; colorize: MaterialPalette.on_primary_container; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.release_name != "" ? "Доступно обновление: " + root.release_name : "Доступно обновление Oxidium";
                            font_family: OxidiumTheme.font_display;
                            font_size: 18px; font_weight: 600;
                            color: MaterialPalette.on_surface;
                        }
                        Text {
                            text: root.current_version + "  →  " + root.latest_version + (root.published_at != "" ? "  •  " + root.published_at : "");
                            font_family: OxidiumTheme.font_mono;
                            font_size: 12px; font_weight: 600;
                            color: MaterialPalette.primary;
                        }
                    }
                }
                OxidiumIconButton {
                    icon: OxidiumIcons.close;
                    enabled: !root.downloading;
                    tooltip: "Закрыть";
                    clicked => { root.close(); }
                }
            }

            // Release notes card
            Rectangle {
                vertical_stretch: 1;
                border_radius: 16px;
                background: MaterialPalette.surface_container;
                border_width: 1px;
                border_color: OxidiumTheme.cell_border;
                ScrollView {
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                    viewport_width: self.visible_width;
                    viewport_height: max(self.visible_height, update_notes_col.preferred_height);
                    update_notes_col := VerticalLayout {
                        x: 0px; y: 0px;
                        width: parent.visible_width;
                        padding: 14px;
                        spacing: 6px;
                        alignment: start;
                        Text { text: "Что нового в релизе"; font_size: 12px; font_weight: 600; color: MaterialPalette.on_surface_variant; }
                        Text {
                            text: root.release_notes != "" ? root.release_notes : "Описание релиза доступно на странице GitHub Releases.";
                            font_size: 13px;
                            color: MaterialPalette.on_surface;
                            wrap: word_wrap;
                        }
                    }
                }
            }

            // Package & SHA-256 verification summary
            Rectangle {
                border_radius: 14px;
                background: MaterialPalette.surface_container;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    Text {
                        text: root.has_asset ? "Пакет для вашей ОС: " + root.asset_label : "Автоматический пакет для текущей ОС не найден — откройте GitHub Releases.";
                        font_family: OxidiumTheme.font_mono;
                        font_size: 11px;
                        color: MaterialPalette.on_surface;
                        wrap: word_wrap;
                    }
                    Text {
                        text: root.sha256_label != "" ? "Проверка целостности SHA-256: " + root.sha256_label : "Источник: https://github.com/cryals/Oxidium/releases";
                        font_family: OxidiumTheme.font_mono;
                        font_size: 10px;
                        color: OxidiumTheme.success_color;
                        wrap: word_wrap;
                    }
                }
            }

            if root.status_text != "" : Rectangle {
                border_radius: 12px;
                background: MaterialPalette.secondary_container;
                HorizontalLayout {
                    padding: 10px;
                    Text {
                        text: root.status_text;
                        font_size: 12px; font_weight: 500;
                        color: MaterialPalette.on_secondary_container;
                        wrap: word_wrap;
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                spacing: 8px;
                OutlineButton {
                    text: "Открыть GitHub Releases";
                    height: 38px;
                    clicked => { root.open_releases_page(); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    OutlineButton {
                        text: "Позже";
                        height: 38px;
                        enabled: !root.downloading;
                        clicked => { root.close(); }
                    }
                    if root.has_asset : FilledButton {
                        text: root.downloading ? "Загрузка и проверка SHA-256..." : "Скачать и установить";
                        height: 38px;
                        icon: OxidiumIcons.download;
                        enabled: !root.downloading;
                        clicked => { root.download_and_install(); }
                    }
                }
            }
        }
    }
}
